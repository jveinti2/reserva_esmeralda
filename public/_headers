# Assets con nombre estable: se cachean un ano.
# Si se cambia una imagen hay que cambiarle el nombre, o purgar la cache
# desde Netlify (Deploys > Trigger deploy > Clear cache and deploy site).
/images/*
  Cache-Control: public, max-age=31536000, immutable
/logos/*
  Cache-Control: public, max-age=31536000, immutable
/fondos/*
  Cache-Control: public, max-age=31536000, immutable
/testimonials/*
  Cache-Control: public, max-age=31536000, immutable
/sendero/*
  Cache-Control: public, max-age=31536000, immutable
/videos/*
  Cache-Control: public, max-age=31536000, immutable
/docs/*
  Cache-Control: public, max-age=31536000, immutable
/tour-360/*
  Cache-Control: public, max-age=31536000, immutable

# Las fuentes ademas necesitan CORS: se piden con crossorigin por el preload.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Los bundles de Astro ya llevan hash en el nombre.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
