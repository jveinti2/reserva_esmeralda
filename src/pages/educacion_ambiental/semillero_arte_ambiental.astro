---
import PaginaDetalle from "../../layouts/PaginaDetalle.astro";

const galeria = [
  "bio_arte_1", "bio_arte_2", "bio_arte_3", "bio_arte_4", "bio_arte_5",
  "bio_arte_6", "bio_arte_8", "bio_arte_9", "bio_arte_10",
].map((n, i) => ({
  src: `/images/educacion/arte_ambiental/${n}.avif`,
  alt: `Proyecto de bio arte de los participantes del semillero (${i + 1})`,
}));

const actividades = [
  {
    titulo: "Pintura natural",
    texto: "Creación de pinturas y pigmentos a partir de elementos naturales como flores, hojas y tierra.",
  },
  {
    titulo: "Fotografía de naturaleza",
    texto: "Captura de la belleza natural y aprendizaje sobre composición fotográfica y observación detallada.",
  },
  {
    titulo: "Arte con reciclaje",
    texto: "Transformación de materiales reciclados en obras de arte que transmiten mensajes ambientales.",
  },
  {
    titulo: "Manualidades naturales",
    texto: "Elaboración de objetos artísticos usando semillas, ramas, hojas y otros materiales del bosque.",
  },
  {
    titulo: "Murales ecológicos",
    texto: "Creación colectiva de murales que cuentan historias sobre la biodiversidad local y la conservación.",
  },
  {
    titulo: "Cuentos ambientales",
    texto: "Escritura e ilustración de historias inspiradas en la naturaleza y sus habitantes.",
  },
];

const objetivos = [
  {
    titulo: "Sensibilización ambiental",
    texto: "Despertar la conciencia ambiental mediante experiencias artísticas que conecten emocionalmente a los participantes con la naturaleza.",
  },
  {
    titulo: "Desarrollo creativo",
    texto: "Fomentar la creatividad y la expresión personal como herramientas para comunicar la importancia de la conservación.",
  },
  {
    titulo: "Trabajo en comunidad",
    texto: "Promover la colaboración y el trabajo en equipo a través de proyectos artísticos colectivos con mensaje ambiental.",
  },
  {
    titulo: "Amor por la naturaleza",
    texto: "Cultivar un vínculo afectivo profundo con el entorno natural que motive acciones de cuidado y protección.",
  },
];
---

<PaginaDetalle
  title="La Esmeralda Reserva Natural | Semillero Bio Arte Ambiental"
  description="Expresando la conexión con la naturaleza a través del arte. Semillero de educación ambiental artística."
  programa="Educación ambiental"
  programaHref="/educacion_ambiental/"
  heroTitulo="Semillero Bio Arte"
  heroAcento="Ambiental"
  heroSubtitulo="El arte como herramienta de sensibilización ambiental."
  heroImagen="/images/educacion/fondo_arte_ambiental.avif"
  heroAlt="Participantes del semillero de bio arte mostrando sus obras"
  ficha={[
    { etiqueta: "Programa", valor: "Educación ambiental" },
    { etiqueta: "Dirigido a", valor: "Niños y jóvenes" },
    { etiqueta: "Ejes", valor: "Arte, fotografía, reciclaje y naturaleza" },
  ]}
  galeriaTitulo="Galería de proyectos"
  galeria={galeria}
  ctaTitulo="¿Quieres ser parte del"
  ctaAcento="semillero?"
  ctaTexto="Únete al Semillero Bio Arte y descubre cómo el arte puede transformar tu relación con la naturaleza."
>
  <section>
    <h2>¿Qué es el Semillero Bio Arte?</h2>
    <p class="destacado">
      El Semillero Bio Arte Ambiental es un espacio creativo donde niños y
      jóvenes exploran su conexión con la naturaleza a través de diversas
      expresiones artísticas. Combinamos el aprendizaje sobre ecosistemas,
      biodiversidad y conservación con actividades de arte, fotografía, pintura
      y creación manual usando materiales naturales y reciclados.
    </p>
    <p>
      Nuestro objetivo es despertar la sensibilidad ambiental mediante la
      creatividad, permitiendo que los participantes expresen su amor por la
      naturaleza y se conviertan en embajadores del cuidado ambiental en sus
      comunidades.
    </p>
  </section>

  <section>
    <h2>Nuestras actividades</h2>
    <div class="prosa-cajas">
      {
        actividades.map((a, i) => (
          <div class="prosa-caja">
            <span class="prosa-caja-etiqueta">{String(i + 1).padStart(2, "0")}</span>
            <h3>{a.titulo}</h3>
            <p>{a.texto}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <h2>Objetivos del semillero</h2>
    <div class="prosa-cajas">
      {
        objetivos.map((o) => (
          <div class="prosa-caja">
            <h3>{o.titulo}</h3>
            <p>{o.texto}</p>
          </div>
        ))
      }
    </div>
  </section>
</PaginaDetalle>
