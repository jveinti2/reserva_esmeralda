---
import PaginaDetalle from "../../layouts/PaginaDetalle.astro";

const galeria = Array.from({ length: 7 }, (_, i) => ({
  src: `/images/educacion/sembradores/sembradores_${i + 1}.avif`,
  alt: `Jornada de reforestación del Semillero Sembradores (${i + 1})`,
}));

const actividades = [
  {
    titulo: "Recolección de semillas",
    texto: "Salidas de campo para recolectar semillas de especies nativas del bosque seco tropical, aprendiendo sobre fenología y propagación.",
  },
  {
    titulo: "Germinación y vivero",
    texto: "Preparación de sustratos, siembra de semillas y cuidado de plántulas en el vivero de la reserva.",
  },
  {
    titulo: "Jornadas de plantación",
    texto: "Eventos comunitarios de siembra de árboles en zonas degradadas, conectando familias con la restauración ecológica.",
  },
  {
    titulo: "Monitoreo de crecimiento",
    texto: "Seguimiento del desarrollo de los árboles plantados mediante mediciones periódicas y registros fotográficos.",
  },
  {
    titulo: "Compostaje",
    texto: "Elaboración de abono orgánico a partir de residuos vegetales para nutrir las plantas del vivero de manera sostenible.",
  },
  {
    titulo: "Identificación botánica",
    texto: "Aprendizaje sobre las características de las especies nativas: hojas, flores, frutos y su importancia ecológica.",
  },
];

const especies = [
  {
    titulo: "Guadua (Guadua angustifolia)",
    texto: "Bambú nativo emblemático de Colombia, esencial para la protección de cuencas y refugio de fauna.",
  },
  {
    titulo: "Ceiba (Ceiba pentandra)",
    texto: "Árbol majestuoso del bosque seco tropical, símbolo de vida y espiritualidad para comunidades ancestrales.",
  },
  {
    titulo: "Ocobo (Tabebuia rosea)",
    texto: "Árbol ornamental de flores rosadas que embellece el paisaje y proporciona alimento a polinizadores.",
  },
  {
    titulo: "Otras especies nativas",
    texto: "Caracolí, samán, guásimo, guayacán y muchas más especies que conforman la riqueza del bosque seco tropical.",
  },
];

const impacto = [
  { dato: "500+", texto: "Árboles plantados" },
  { dato: "30+", texto: "Especies nativas" },
  { dato: "100+", texto: "Participantes activos" },
];

const objetivos = [
  {
    titulo: "Restauración ecológica",
    texto: "Recuperar áreas degradadas del bosque seco tropical mediante la plantación de especies nativas y el manejo sostenible.",
  },
  {
    titulo: "Educación ambiental",
    texto: "Enseñar sobre la importancia ecológica de los bosques nativos y las técnicas de propagación y cuidado de plantas.",
  },
  {
    titulo: "Participación comunitaria",
    texto: "Involucrar a familias y comunidades en acciones concretas de conservación que fortalezcan el sentido de pertenencia territorial.",
  },
  {
    titulo: "Legado ambiental",
    texto: "Crear un patrimonio natural duradero que beneficie a las futuras generaciones y conecte a las personas con la tierra.",
  },
];
---

<PaginaDetalle
  title="La Esmeralda Reserva Natural | Semillero Sembradores"
  description="Sembrando semillas de esperanza y restauración ecológica. Semillero de reforestación y conservación activa."
  programa="Educación ambiental"
  programaHref="/educacion_ambiental/"
  heroTitulo="Semillero"
  heroAcento="Sembradores"
  heroSubtitulo="Restaurando el bosque seco tropical, una semilla a la vez."
  heroImagen="/images/educacion/fondo_sembradores.avif"
  heroAlt="Participantes sembrando árboles nativos en la reserva"
  ficha={[
    { etiqueta: "Programa", valor: "Educación ambiental" },
    { etiqueta: "Dirigido a", valor: "Niños, jóvenes y familias" },
    { etiqueta: "Árboles plantados", valor: "Más de 500" },
    { etiqueta: "Especies nativas", valor: "Más de 30" },
  ]}
  galeriaTitulo="Nuestros proyectos de reforestación"
  galeria={galeria}
  ctaTitulo="¿Quieres sembrar"
  ctaAcento="esperanza?"
  ctaTexto="Únete al Semillero Sembradores y sé parte de la restauración del bosque seco tropical."
>
  <section>
    <h2>¿Qué es el Semillero Sembradores?</h2>
    <p class="destacado">
      El Semillero Sembradores es un programa de restauración ecológica
      participativa donde niños, jóvenes y familias aprenden sobre la
      importancia de los árboles nativos y contribuyen activamente a la
      regeneración del bosque seco tropical. Desde la recolección de semillas
      hasta el seguimiento de los árboles plantados, cada participante se
      convierte en guardián del futuro del bosque.
    </p>
    <p>
      El bosque seco tropical es uno de los ecosistemas más amenazados de
      Colombia, con menos del <strong>8 %</strong> de su cobertura original.
      Nuestro semillero es una respuesta concreta a esta crisis, combinando
      educación ambiental con acciones de conservación que dejan un legado
      tangible para las generaciones futuras.
    </p>
  </section>

  <section>
    <h2>Nuestro impacto</h2>
    <div class="prosa-cajas">
      {
        impacto.map((i) => (
          <div class="prosa-caja">
            <span class="prosa-cifra">{i.dato}</span>
            <p>{i.texto}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <h2>Actividades del semillero</h2>
    <div class="prosa-cajas">
      {
        actividades.map((a, i) => (
          <div class="prosa-caja">
            <span class="prosa-caja-etiqueta">{String(i + 1).padStart(2, "0")}</span>
            <h3>{a.titulo}</h3>
            <p>{a.texto}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <h2>Especies nativas que sembramos</h2>
    <div class="prosa-cajas">
      {
        especies.map((e) => (
          <div class="prosa-caja">
            <h3>{e.titulo}</h3>
            <p>{e.texto}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <h2>Objetivos del semillero</h2>
    <div class="prosa-cajas">
      {
        objetivos.map((o) => (
          <div class="prosa-caja">
            <h3>{o.titulo}</h3>
            <p>{o.texto}</p>
          </div>
        ))
      }
    </div>
  </section>
</PaginaDetalle>
