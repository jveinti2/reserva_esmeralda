---
import PaginaDetalle from "../../layouts/PaginaDetalle.astro";

const galeria = Array.from({ length: 9 }, (_, i) => ({
  src: `/images/educacion/aves/aves_${i + 1}.avif`,
  alt: `Ave observada en la Reserva Natural La Esmeralda (${i + 1})`,
}));

const actividades = [
  {
    titulo: "Salidas de avistamiento",
    texto: "Recorridos guiados por la reserva durante las horas de mayor actividad de las aves, al amanecer y al atardecer.",
  },
  {
    titulo: "Talleres de identificación",
    texto: "Aprendizaje sobre características morfológicas, cantos y comportamientos para identificar especies de aves.",
  },
  {
    titulo: "Monitoreo comunitario",
    texto: "Registro sistemático de especies avistadas que contribuye a bases de datos científicas como eBird.",
  },
  {
    titulo: "Reconocimiento de cantos",
    texto: "Entrenamiento auditivo para identificar aves por sus vocalizaciones y llamados característicos.",
  },
  {
    titulo: "Fotografía de aves",
    texto: "Técnicas básicas de fotografía de naturaleza para documentar las especies observadas.",
  },
  {
    titulo: "Conservación de hábitats",
    texto: "Acciones de conservación como instalación de bebederos, comederos y cajas nido para aves.",
  },
];

const especies = [
  {
    titulo: "Loros y pericos",
    texto: "La reserva alberga varias especies de psitácidos, aves carismáticas y vocales que juegan un papel importante en la dispersión de semillas.",
  },
  {
    titulo: "Colibríes",
    texto: "Polinizadores esenciales del bosque seco tropical, los colibríes deslumbran con su vuelo acrobático y colores iridiscentes.",
  },
  {
    titulo: "Rapaces",
    texto: "Águilas, halcones y gavilanes son indicadores de la salud del ecosistema y controladores naturales de poblaciones de roedores.",
  },
  {
    titulo: "Aves endémicas y amenazadas",
    texto: "Registramos especies de distribución restringida y bajo amenaza, contribuyendo a su conservación mediante el monitoreo constante.",
  },
];

const objetivos = [
  {
    titulo: "Ciencia ciudadana",
    texto: "Formar observadores capacitados que contribuyan al conocimiento científico sobre la avifauna local y regional.",
  },
  {
    titulo: "Conservación",
    texto: "Promover la protección de las aves y sus hábitats a través de acciones concretas y educación ambiental.",
  },
  {
    titulo: "Comunidad",
    texto: "Construir una red de observadores de aves que comparta conocimientos y experiencias en torno a la conservación.",
  },
  {
    titulo: "Conexión natural",
    texto: "Fortalecer el vínculo emocional de las personas con la naturaleza a través de la observación y apreciación de las aves.",
  },
];
---

<PaginaDetalle
  title="La Esmeralda Reserva Natural | Semillero Avistadores de Aves"
  description="Observando y protegiendo la avifauna del bosque seco tropical. Semillero de avistamiento de aves."
  programa="Educación ambiental"
  programaHref="/educacion_ambiental/"
  heroTitulo="Semillero Avistadores"
  heroAcento="de aves"
  heroSubtitulo="Descubriendo la diversidad alada del bosque seco tropical."
  heroImagen="/images/educacion/fondo_aves.avif"
  heroAlt="Participante observando aves con binoculares en la reserva"
  ficha={[
    { etiqueta: "Programa", valor: "Educación ambiental" },
    { etiqueta: "Dirigido a", valor: "Niños, jóvenes y adultos" },
    { etiqueta: "Método", valor: "Ciencia ciudadana · registros en eBird" },
    { etiqueta: "Mejor hora", valor: "Amanecer y atardecer" },
  ]}
  galeriaTitulo="Aves de la reserva"
  galeria={galeria}
  ctaTitulo="¿Te apasionan las"
  ctaAcento="aves?"
  ctaTexto="Únete al Semillero Avistadores y descubre el maravilloso mundo de las aves del bosque seco tropical."
>
  <section>
    <h2>¿Qué es el Semillero Avistadores?</h2>
    <p class="destacado">
      El Semillero Avistadores de Aves es un programa de ciencia ciudadana que
      invita a niños, jóvenes y adultos a descubrir la increíble diversidad de
      aves que habitan en la Reserva Natural La Esmeralda. A través de salidas
      de campo, talleres de identificación y monitoreo participativo, formamos
      observadores comprometidos con la conservación de la avifauna.
    </p>
    <p>
      Colombia es el país con mayor diversidad de aves en el mundo, y el bosque
      seco tropical alberga especies únicas y amenazadas. Nuestro semillero
      contribuye al conocimiento científico local mientras conecta a las
      personas con la belleza y fragilidad de estos ecosistemas.
    </p>
  </section>

  <section>
    <h2>Actividades del semillero</h2>
    <div class="prosa-cajas">
      {
        actividades.map((a, i) => (
          <div class="prosa-caja">
            <span class="prosa-caja-etiqueta">{String(i + 1).padStart(2, "0")}</span>
            <h3>{a.titulo}</h3>
            <p>{a.texto}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <h2>Especies destacadas</h2>
    <div class="prosa-cajas">
      {
        especies.map((e) => (
          <div class="prosa-caja">
            <h3>{e.titulo}</h3>
            <p>{e.texto}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <h2>Objetivos del semillero</h2>
    <div class="prosa-cajas">
      {
        objetivos.map((o) => (
          <div class="prosa-caja">
            <h3>{o.titulo}</h3>
            <p>{o.texto}</p>
          </div>
        ))
      }
    </div>
  </section>
</PaginaDetalle>
