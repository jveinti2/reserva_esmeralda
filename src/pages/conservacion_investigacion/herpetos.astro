---
import PaginaDetalle from "../../layouts/PaginaDetalle.astro";

const galeria = [
  { src: "/images/conservacion/herpetos/herpectos_4.avif", alt: "Anfibio registrado en el trabajo de campo" },
  { src: "/images/conservacion/herpetos/herpectos_5.avif", alt: "Reptil hallado en la reserva" },
  { src: "/images/conservacion/herpetos/herpectos_3.avif", alt: "Herpeto del bosque seco tropical" },
  { src: "/images/conservacion/herpetos/bosque_secotropical.avif", alt: "Bosque seco tropical de la reserva" },
  { src: "/images/conservacion/herpetos/fondo_seccion_resultados_1.avif", alt: "Vegetación del corredor del río Opia" },
];

const metas = [
  "Identificar en campo y catalogar las especies de anfibios y reptiles presentes en la Reserva Natural La Esmeralda.",
  "Evaluar el estado de conservación de estas especies en el contexto de las amenazas que enfrentan.",
  "Contribuir al conocimiento científico sobre la herpetofauna del Tolima y promover acciones de conservación en la región, con la creación de un folleto informativo.",
];

const resultados = [
  {
    titulo: "Inventario completo de especies",
    texto: "Identificación y catalogación de al menos 50 especies de anfibios y reptiles.",
  },
  {
    titulo: "Evaluación del estado de conservación",
    texto: "Evaluación del estado de conservación de las especies identificadas.",
  },
  {
    titulo: "Base de datos digital",
    texto: "Creación de una base de datos digital para la gestión de la información obtenida.",
  },
  {
    titulo: "Publicación científica",
    texto: "Elaboración y envío de un manuscrito para su publicación en una revista científica.",
  },
  {
    titulo: "Sensibilización ambiental",
    texto: "Programas de sensibilización y educación ambiental dirigidos a la comunidad local.",
  },
];

const fases = [
  { fase: "Fase 1", texto: "Recolección de datos", tiempo: "3 meses" },
  { fase: "Fase 2", texto: "Análisis y evaluación", tiempo: "2 meses" },
  { fase: "Fase 3", texto: "Creación de base de datos", tiempo: "1 mes" },
  { fase: "Fase 4", texto: "Redacción del manuscrito", tiempo: "2 meses" },
  { fase: "Fase 5", texto: "Sensibilización", tiempo: "1 mes" },
];

const recursos = [
  {
    titulo: "Recursos humanos",
    items: [
      "Biólogos con experiencia en herpetología.",
      "Técnicos de campo para la recolección de datos.",
      "Voluntarios o estudiantes para apoyo en investigaciones.",
    ],
  },
  {
    titulo: "Equipos y materiales",
    items: [
      "Redes de captura para anfibios y reptiles.",
      "Cámaras fotográficas y/o cámaras trampa.",
      "Kits de identificación de especies (guías de campo).",
      "Equipos para la medición ambiental.",
      "Software para el análisis de datos.",
      "Base de datos digital.",
    ],
  },
  {
    titulo: "Financiamiento",
    items: [
      "Fondos para salarios del personal.",
      "Presupuesto para equipos y materiales.",
      "Recursos para divulgación y materiales educativos.",
    ],
  },
  {
    titulo: "Infraestructura",
    items: [
      "Reserva Natural La Esmeralda para actividades de campo.",
      "Espacio para el procesamiento de muestras.",
    ],
  },
  {
    titulo: "Colaboraciones",
    items: [
      "Alianzas con universidades o instituciones de investigación.",
      "Apoyo de organizaciones ambientales.",
    ],
  },
  {
    titulo: "Materiales educativos",
    items: ["Folletos y carteles informativos sobre la conservación."],
  },
];
---

<PaginaDetalle
  title="La Esmeralda Reserva Natural | Herpetos"
  description="Río Opia: Un Refugio para la Herpetofauna. Inventario y caracterización de anfibios y reptiles en la Reserva Natural La Esmeralda."
  programa="Conservación e investigación"
  programaHref="/conservacion_investigacion/"
  heroTitulo="Río Opia: un refugio para la"
  heroAcento="herpetofauna"
  heroSubtitulo="Reserva Natural La Esmeralda, Piedras, Tolima"
  heroImagen="/images/conservacion/herpetos/rio_caiman.avif"
  heroAlt="Caimán asomando en el río Opia, dentro de la reserva"
  ficha={[
    { etiqueta: "Proyecto", valor: "Inventario y caracterización de herpetofauna" },
    { etiqueta: "Ecosistema", valor: "Bosque seco tropical · corredor del río Opia" },
    { etiqueta: "Duración estimada", valor: "9 meses en 5 fases" },
    { etiqueta: "Meta", valor: "Al menos 50 especies catalogadas" },
  ]}
  galeria={galeria}
  ctaTitulo="Investiga con"
  ctaAcento="nosotros"
  ctaTexto="Biólogos, estudiantes y voluntarios: el inventario de herpetofauna necesita manos y ojos en el campo."
>
  <section>
    <h2>Nuestro objetivo</h2>
    <p class="destacado">
      Realizar un inventario exhaustivo y la caracterización taxonómica de la
      <strong>herpetofauna</strong> (anfibios y reptiles) en la Reserva Natural
      La Esmeralda, situada en <strong>Piedras, Tolima</strong>. Nuestro equipo
      se dedica a preservar y entender la biodiversidad en este ecosistema
      vital.
    </p>
  </section>

  <section>
    <h2>Justificación</h2>
    <p>
      El departamento del Tolima presenta una rica diversidad de ecosistemas y
      hábitats que albergan una amplia variedad de herpetos. Sin embargo, estos
      grupos están amenazados por factores como la pérdida de hábitat, especies
      invasoras, contaminación, tráfico ilegal, cambio climático y enfermedades
      emergentes.
    </p>
    <p>
      La Reserva Natural La Esmeralda está ubicada en un ecosistema crítico —el
      bosque seco tropical— que aún tiene un potencial desconocido, a falta de
      labores investigativas en el sector, para la conservación e identificación
      de su biodiversidad de anfibios y reptiles.
    </p>
  </section>

  <section>
    <h2>Metas del proyecto</h2>
    <div class="prosa-cajas">
      {
        metas.map((m, i) => (
          <div class="prosa-caja">
            <span class="prosa-caja-etiqueta">Meta {i + 1}</span>
            <p>{m}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <h2>Resultados esperados</h2>
    <div class="prosa-cajas">
      {
        resultados.map((r, i) => (
          <div class="prosa-caja">
            <span class="prosa-caja-etiqueta">{String(i + 1).padStart(2, "0")}</span>
            <h3>{r.titulo}</h3>
            <p>{r.texto}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <h2>Tiempo estimado</h2>
    <div class="prosa-cajas">
      {
        fases.map((f) => (
          <div class="prosa-caja">
            <span class="prosa-caja-etiqueta">{f.fase}</span>
            <h3>{f.texto}</h3>
            <p>{f.tiempo}</p>
          </div>
        ))
      }
    </div>
    <span class="prosa-total">Total estimado: <strong>9 meses</strong></span>
  </section>

  <section>
    <h2>Recursos necesarios</h2>
    <div class="prosa-cajas">
      {
        recursos.map((r) => (
          <div class="prosa-caja">
            <h3>{r.titulo}</h3>
            <ul>
              {r.items.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</PaginaDetalle>
