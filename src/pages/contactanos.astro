                  <path
                    d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                  ></path>
                </svg>
              </div>
              <h3 class="text-2xl font-bold text-gray-900 mb-3">Instagram</h3>
              <p class="text-gray-600 mb-6">
                Siguenos en Instagram y mantente al dia con nuestras actividades
              </p>
              <a
                href="https://www.instagram.com/laesmeraldareservanatural/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-purple-600 to-pink-500 text-white font-medium rounded-lg hover:from-purple-700 hover:to-pink-600 transition-all"
              >
                <svg
                  class="w-5 h-5 mr-2"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                  ></path>
                </svg>
                Seguir en Instagram
              </a>
            </div>
          </div>

          <!-- Columna derecha - Formulario -->
          <div>
            <div class="bg-white rounded-xl shadow-lg p-8">
              <h2 class="text-3xl font-bold text-gray-900 mb-4 text-center">
                Envianos un mensaje
              </h2>
              <p class="text-gray-600 mb-8 text-center">
                Si tienes una idea, proyecto o propuesta para crecer juntos en
                esta mision de la conservacion, completa el formulario.
              </p>

              <form id="contactForm" class="space-y-6">
                <div>
                  <label
                    for="email"
                    class="block text-sm font-medium text-gray-700 mb-2"
                  >
                    Correo electronico *
                  </label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    placeholder="tu@correo.com"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-esmeralda focus:border-esmeralda transition-colors"
                  />
                </div>

                <div>
                  <label
                    for="asunto"
                    class="block text-sm font-medium text-gray-700 mb-2"
                  >
                    Asunto *
                  </label>
                  <input
                    type="text"
                    id="asunto"
                    name="asunto"
                    required
                    placeholder="Propuesta de conservacion natural"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-esmeralda focus:border-esmeralda transition-colors"
                  />
                </div>

                <div>
                  <label
                    for="mensaje"
                    class="block text-sm font-medium text-gray-700 mb-2"
                  >
                    Tu mensaje *
                  </label>
                  <textarea
                    id="mensaje"
                    name="mensaje"
                    rows="6"
                    required
                    placeholder="Hola! Soy Esmeralda, y tengo esta idea que quisiera compartir con la reserva..."
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-esmeralda focus:border-esmeralda transition-colors resize-none"
                  ></textarea>
                </div>

                <button
                  type="submit"
                  id="submitBtn"
                  class="w-full inline-flex items-center justify-center px-6 py-4 bg-esmeralda text-white font-medium rounded-lg hover:bg-esmeralda-600 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  <span id="btnText">Enviar mensaje</span>
                  <svg
                    id="btnSpinner"
                    class="hidden animate-spin ml-2 h-5 w-5 text-white"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                  >
                    <circle
                      class="opacity-25"
                      cx="12"
                      cy="12"
                      r="10"
                      stroke="currentColor"
                      stroke-width="4"></circle>
                    <path
                      class="opacity-75"
                      fill="currentColor"
                      d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                    ></path>
                  </svg>
                  <svg
                    id="btnArrow"
                    class="ml-2 w-5 h-5"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                      clip-rule="evenodd"></path>
                  </svg>
                </button>
              </form>

              <!-- Mensaje de exito -->
              <div
                id="successMessage"
                class="hidden mt-6 p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg text-center"
              >
                <svg
                  class="w-6 h-6 mx-auto mb-2"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <p class="font-medium">Mensaje enviado correctamente!</p>
                <p class="text-sm mt-1">
                  Nos pondremos en contacto contigo pronto.
                </p>
              </div>

              <!-- Mensaje de error -->
              <div
                id="errorMessage"
                class="hidden mt-6 p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg text-center"
              >
                <svg
                  class="w-6 h-6 mx-auto mb-2"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                    clip-rule="evenodd"></path>
                </svg>
                <p class="font-medium">Error al enviar el mensaje</p>
                <p class="text-sm mt-1">
                  Por favor intenta de nuevo o contactanos por WhatsApp.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Seccion de ubicacion -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-6 max-w-6xl">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-esmeralda mb-4">
            Visitanos
          </h2>
          <p class="text-gray-600 max-w-2xl mx-auto">
            Estamos ubicados en el corregimiento de Doima, municipio de Piedras,
            Tolima, Colombia. A solo 20 minutos de Ibague.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <!-- Informacion de contacto -->
          <div class="space-y-6">
            <div class="flex items-start">
              <div
                class="w-12 h-12 bg-esmeralda-100 rounded-full flex items-center justify-center mr-4 flex-shrink-0"
              >
                <svg
                  class="w-6 h-6 text-esmeralda"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 text-lg">Direccion</h3>
                <p class="text-gray-600">
                  Corregimiento de Doima, Piedras<br />Tolima, Colombia
                </p>
              </div>
            </div>

            <div class="flex items-start">
              <div
                class="w-12 h-12 bg-esmeralda-100 rounded-full flex items-center justify-center mr-4 flex-shrink-0"
              >
                <svg
                  class="w-6 h-6 text-esmeralda"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 text-lg">Telefono</h3>
                <a
                  href="tel:+573208096472"
                  class="text-gray-600 hover:text-esmeralda transition-colors"
                >
                  (+57) 320 809 6472
                </a>
              </div>
            </div>

            <div class="flex items-start">
              <div
                class="w-12 h-12 bg-esmeralda-100 rounded-full flex items-center justify-center mr-4 flex-shrink-0"
              >
                <svg
                  class="w-6 h-6 text-esmeralda"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"
                  ></path>
                  <path
                    d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 text-lg">Email</h3>
                <a
                  href="mailto:info@esmeraldareservanatural.com"
                  class="text-gray-600 hover:text-esmeralda transition-colors"
                >
                  info@esmeraldareservanatural.com
                </a>
              </div>
            </div>

            <div class="pt-4">
              <a
                href="https://api.whatsapp.com/send?phone=573208096472&text=Hola!%20Me%20gustaria%20visitar%20la%20Reserva%20La%20Esmeralda"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center px-6 py-3 bg-esmeralda text-white font-medium rounded-lg hover:bg-esmeralda-600 transition-colors"
              >
                <svg
                  class="w-5 h-5 mr-2"
                  fill="currentColor"
                  viewBox="0 0 24 24"
