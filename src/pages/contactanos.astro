---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/sections/Hero.astro";

const WHATSAPP_MENSAJE =
  "https://api.whatsapp.com/send?phone=573208096472&text=Hola!%20Quisiera%20comunicarme%20con%20la%20Reserva%20La%20Esmeralda";
const WHATSAPP_VISITA =
  "https://api.whatsapp.com/send?phone=573208096472&text=Hola!%20Me%20gustaria%20visitar%20la%20Reserva%20La%20Esmeralda";
---

<BaseLayout
  title="Contáctanos | La Esmeralda Reserva Natural"
  description="Contacta con La Esmeralda Reserva Natural. Escríbenos por WhatsApp, redes sociales o completa nuestro formulario de contacto."
  preloadImage="/images/servicios/banner_2.avif"
  ogImage="/images/servicios/banner_2.avif"
>
  <Header />

  <main>
    <Hero
      imagen="/images/servicios/banner_2.avif"
      alt="Camino de entrada a la Reserva Natural La Esmeralda"
      posicion="50% 45%"
      eyebrow="Contacto · Doima, Piedras, Tolima"
      titulo="¿Quieres comunicarte"
      acento="con nosotros?"
      lead="Escríbenos por el canal que prefieras. Respondemos a diario, en horario de reserva."
      tamano="compacto"
    />

    <section class="banda-papel">
      <div class="wrap grid12 contacto-envoltura">
        <!-- Formulario -->
        <div class="contacto-form reveal">
          <span class="eyebrow">Escríbenos</span>
          <h2 class="titulo">Cuéntanos tu <em>idea</em></h2>
          <p class="lead">
            Si tienes un proyecto o una propuesta para crecer juntos en esta
            misión de la conservación, completa el formulario y te respondemos.
          </p>

          <form id="contactForm" class="formulario" style="margin-top: 40px;">
            <div class="campo">
              <label for="email">Correo electrónico *</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="tu@correo.com"
              />
            </div>

            <div class="campo">
              <label for="asunto">Asunto *</label>
              <input
                type="text"
                id="asunto"
                name="asunto"
                required
                placeholder="Propuesta de conservación natural"
              />
            </div>

            <div class="campo">
              <label for="mensaje">Tu mensaje *</label>
              <textarea
                id="mensaje"
                name="mensaje"
                rows="6"
                required
                placeholder="¡Hola! Soy Esmeralda, y tengo esta idea que quisiera compartir con la reserva..."></textarea>
            </div>

            <button type="submit" id="submitBtn" class="btn btn-lima">
              <span id="btnText">Enviar mensaje</span>
              <svg
                id="btnSpinner"
                class="hidden animate-spin h-5 w-5"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
              >
                <circle
                  class="opacity-25"
                  cx="12"
                  cy="12"
                  r="10"
                  stroke="currentColor"
                  stroke-width="4"></circle>
                <path
                  class="opacity-75"
                  fill="currentColor"
                  d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                ></path>
              </svg>
              <svg
                id="btnArrow"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
              >
            </button>
          </form>

          <!-- Mensaje de exito -->
          <div id="successMessage" class="form-aviso ok hidden">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
            <span>
              <strong>¡Mensaje enviado correctamente!</strong>
              Nos pondremos en contacto contigo pronto.
            </span>
          </div>

          <!-- Mensaje de error -->
          <div id="errorMessage" class="form-aviso mal hidden">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v6M12 16.5v.01"></path></svg>
            <span>
              <strong>Error al enviar el mensaje</strong>
              Por favor intenta de nuevo o contáctanos por WhatsApp.
            </span>
          </div>
        </div>

        <!-- Canales y datos -->
        <aside class="contacto-lateral reveal">
          <span class="eyebrow">Canales directos</span>

          <div class="canales" style="margin-top: 24px;">
            <a href={WHATSAPP_MENSAJE} target="_blank" rel="noopener noreferrer" class="canal">
              <span class="canal-ico">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.6-4.6A8.5 8.5 0 1 1 8 19.6L3 21z"></path><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-1.8-.9-.8.8a4 4 0 0 1-2.3-2.3l.8-.8L10.5 8.5 9 9.5z"></path></svg>
              </span>
              <span class="canal-texto">
                <span class="canal-nombre">WhatsApp</span>
                <span class="canal-nota">La vía más rápida</span>
              </span>
              <svg class="canal-flecha" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>

            <a href="https://www.facebook.com/ReservalaesmeraldaenDoima" target="_blank" rel="noopener noreferrer" class="canal">
              <span class="canal-ico">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.6 1.6-1.6h1.7V4.3c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.2v2.4H7.4V14h2.8v8h3.3z"></path></svg>
              </span>
              <span class="canal-texto">
                <span class="canal-nombre">Facebook</span>
                <span class="canal-nota">Déjanos un mensaje</span>
              </span>
              <svg class="canal-flecha" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>

            <a href="https://www.instagram.com/laesmeraldareservanatural/" target="_blank" rel="noopener noreferrer" class="canal">
              <span class="canal-ico">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg>
              </span>
              <span class="canal-texto">
                <span class="canal-nombre">Instagram</span>
                <span class="canal-nota">El día a día de la reserva</span>
              </span>
              <svg class="canal-flecha" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>
          </div>

          <div class="datos">
            <div class="dato">
              <span class="dato-ico">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              </span>
              <span class="dato-texto">
                <span class="dato-etiqueta">Dirección</span>
                <span class="dato-valor">Corregimiento de Doima, Piedras<br />Tolima, Colombia</span>
                <span class="chip chip-niebla" style="margin-top: 8px;">A 20 minutos de Ibagué</span>
              </span>
            </div>

            <div class="dato">
              <span class="dato-ico">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.9 2z"></path></svg>
              </span>
              <span class="dato-texto">
                <span class="dato-etiqueta">Teléfono</span>
                <a href="tel:+573208096472" class="dato-valor">(+57) 320 809 6472</a>
              </span>
            </div>

            <div class="dato">
              <span class="dato-ico">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
              </span>
              <span class="dato-texto">
                <span class="dato-etiqueta">Email</span>
                <a href="mailto:info@esmeraldareservanatural.com" class="dato-valor">info@esmeraldareservanatural.com</a>
              </span>
            </div>

            <a href={WHATSAPP_VISITA} target="_blank" rel="noopener noreferrer" class="btn btn-esm">
              Coordinar visita por WhatsApp
            </a>
          </div>
        </aside>
      </div>
    </section>
  </main>

  <Footer mapa={true} />
</BaseLayout>

<script>
  // Configuracion del formulario de contacto
  // Para activar el envio por email, registrate en https://web3forms.com/ (gratis)
  // y reemplaza '8e66c6aa-ab61-4833-a6e9-da4ba7d3c561' con tu clave
  const WEB3FORMS_ACCESS_KEY = "8e66c6aa-ab61-4833-a6e9-da4ba7d3c561";
  const USAR_WEB3FORMS =
    WEB3FORMS_ACCESS_KEY !== "8e66c6aa-ab61-4833-a6e9-da4ba7d3c561";

  function setupContactForm() {
    const form = document.getElementById("contactForm") as HTMLFormElement;
    const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement;
    const btnText = document.getElementById("btnText");
    const btnSpinner = document.getElementById("btnSpinner");
    const btnArrow = document.getElementById("btnArrow");
    const successMessage = document.getElementById("successMessage");
    const errorMessage = document.getElementById("errorMessage");

    if (!form) return;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      // Ocultar mensajes previos
      successMessage?.classList.add("hidden");
      errorMessage?.classList.add("hidden");

      // Mostrar estado de carga
      submitBtn.disabled = true;
      btnText!.textContent = "Enviando...";
      btnSpinner?.classList.remove("hidden");
      btnArrow?.classList.add("hidden");

      const formData = new FormData(form);

      try {
        if (USAR_WEB3FORMS) {
          // Enviar usando Web3Forms (recomendado)
          const response = await fetch("https://api.web3forms.com/submit", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify({
              access_key: WEB3FORMS_ACCESS_KEY,
              email: formData.get("email"),
              subject: `Contacto desde la web: ${formData.get("asunto")}`,
              message: formData.get("mensaje"),
              from_name: "Formulario La Esmeralda",
            }),
          });

          const result = await response.json();
          if (!result.success) {
            throw new Error(result.message || "Error al enviar");
          }
        } else {
          // Modo demo: simular envio exitoso
          // En produccion, configura Web3Forms o usa el PHP existente
          await new Promise((resolve) => setTimeout(resolve, 1000));
          console.log("Mensaje de contacto (modo demo):", {
            email: formData.get("email"),
            asunto: formData.get("asunto"),
            mensaje: formData.get("mensaje"),
          });
        }

        // Exito
        form.reset();
        successMessage?.classList.remove("hidden");
      } catch (error) {
        console.error("Error al enviar:", error);
        errorMessage?.classList.remove("hidden");
      } finally {
        // Restaurar boton
        submitBtn.disabled = false;
        btnText!.textContent = "Enviar mensaje";
        btnSpinner?.classList.add("hidden");
        btnArrow?.classList.remove("hidden");
      }
    });
  }

  // Ejecutar al cargar
  setupContactForm();

  // Re-ejecutar despues de navegacion (para Astro view transitions)
  document.addEventListener("astro:page-load", setupContactForm);
</script>
