---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
---

<BaseLayout
  title="La Esmeralda Reserva Natural | Mermelada Artesanal"
  description="Mermeladas artesanales con frutas naturales. El sabor auténtico del bosque en cada frasco."
>
  <Header />

  <main>
    <!-- Hero Section -->
    <section
      class="relative bg-cover bg-center h-96"
      style="background-image: url('/images/emprendimientos/mermelada/fondo_landing_mermelada.avif')"
    >
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="text-center text-white px-4">
          <h1 class="text-4xl md:text-5xl font-bold mb-4">
            Mermelada Artesanal La Esmeralda
          </h1>
          <p class="text-xl md:text-2xl">
            El sabor auténtico de las frutas del bosque
          </p>
        </div>
      </div>
    </section>

    <!-- Introducción -->
    <section class="container mx-auto px-6 py-16">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-esmeralda mb-6">
          Nuestra Mermelada
        </h2>
        <p class="text-lg text-gray-700 leading-relaxed mb-8">
          Las Mermeladas Artesanales La Esmeralda son elaboradas con frutas
          frescas cultivadas en nuestra reserva y en fincas amigas de la región.
          Cada frasco es preparado en pequeños lotes con recetas tradicionales
          que resaltan el sabor natural de las frutas, sin conservantes ni
          aditivos artificiales.
        </p>
        <p class="text-lg text-gray-700 leading-relaxed">
          Nuestro proceso artesanal asegura una textura perfecta y un sabor
          intenso que transformará tus desayunos y postres en experiencias
          memorables, mientras apoyas la conservación del bosque seco tropical.
        </p>
      </div>
    </section>

    <!-- Productos -->
    <section class="py-16 bg-gray-100">
      <div class="container mx-auto px-6">
        <h2 class="text-3xl font-bold text-center text-esmeralda mb-12">
          Nuestros Sabores
        </h2>
        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto"
        >
          <div
            class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition-shadow"
          >
            <div class="text-center mb-4">
              <img
                src="/images/emprendimientos/mermelada/mermelada_1.avif"
                alt="Mermelada de Fresa"
                class="w-full h-48 object-cover rounded-lg"
              />
            </div>
            <div class="text-4xl mb-4 text-center">🍓</div>
            <h3 class="text-xl font-bold text-gray-800 mb-3 text-center">
              Fresa Premium
            </h3>
            <p class="text-gray-600 text-center">
              Elaborada con fresas seleccionadas, dulce y aromática. Perfecta
              para untar o rellenar pasteles.
            </p>
          </div>

          <div
            class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition-shadow"
          >
            <div class="text-4xl mb-4 text-center">🍊</div>
            <h3 class="text-xl font-bold text-gray-800 mb-3 text-center">
              Kumquat Especial
            </h3>
            <p class="text-gray-600 text-center">
              Sabor cítrico y ligeramente amargo, ideal para acompañar quesos y
              carnes.
            </p>
          </div>

          <div
            class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition-shadow"
          >
            <div class="text-4xl mb-4 text-center">🍑</div>
            <h3 class="text-xl font-bold text-gray-800 mb-3 text-center">
              Durazno y Canela
            </h3>
            <p class="text-gray-600 text-center">
              Combinación aromática y dulce, perfecta para acompañar panes y
              galletas.
            </p>
          </div>

          <div
            class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition-shadow"
          >
            <div class="text-4xl mb-4 text-center">🫐</div>
            <h3 class="text-xl font-bold text-gray-800 mb-3 text-center">
              Mora Silvestre
            </h3>
            <p class="text-gray-600 text-center">
              Mora recolectada en el bosque, sabor intenso y ligeramente ácido.
            </p>
          </div>

          <div
            class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition-shadow"
          >
            <div class="text-4xl mb-4 text-center">🍍</div>
            <h3 class="text-xl font-bold text-gray-800 mb-3 text-center">
              Piña Tropical
            </h3>
            <p class="text-gray-600 text-center">
              Refrescante y dulce, con trozos de piña fresca.
            </p>
          </div>

          <div
            class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition-shadow"
          >
            <div class="text-4xl mb-4 text-center">🥭</div>
            <h3 class="text-xl font-bold text-gray-800 mb-3 text-center">
              Mango Especial
            </h3>
            <p class="text-gray-600 text-center">
              Mango maduro de la región, textura cremosa y sabor tropical.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Proceso -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-6">
        <h2 class="text-3xl font-bold text-center text-esmeralda mb-12">
          Nuestro Proceso Artesanal
        </h2>
        <div class="max-w-4xl mx-auto space-y-8">
          <div class="flex items-start gap-4">
            <div
              class="bg-esmeralda text-white rounded-full w-12 h-12 flex items-center justify-center flex-shrink-0 text-xl font-bold"
            >
              1
            </div>
            <div>
              <h3 class="text-xl font-bold text-gray-800 mb-2">
                Selección de Frutas
              </h3>
              <p class="text-gray-600">
                Cosechamos frutas en su punto óptimo de maduración para
                garantizar el mejor sabor y aroma.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div
              class="bg-esmeralda text-white rounded-full w-12 h-12 flex items-center justify-center flex-shrink-0 text-xl font-bold"
            >
              2
            </div>
            <div>
              <h3 class="text-xl font-bold text-gray-800 mb-2">Preparación</h3>
              <p class="text-gray-600">
                Lavamos, pelamos y cortamos cuidadosamente cada fruta,
                manteniendo su frescura e integridad.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div
              class="bg-esmeralda text-white rounded-full w-12 h-12 flex items-center justify-center flex-shrink-0 text-xl font-bold"
            >
              3
            </div>
            <div>
              <h3 class="text-xl font-bold text-gray-800 mb-2">
                Cocción Artesanal
              </h3>
              <p class="text-gray-600">
                Cocinamos a fuego lento en lotes pequeños, controlando
                temperatura y tiempo para preservar nutrientes y sabor.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div
              class="bg-esmeralda text-white rounded-full w-12 h-12 flex items-center justify-center flex-shrink-0 text-xl font-bold"
            >
              4
            </div>
            <div>
              <h3 class="text-xl font-bold text-gray-800 mb-2">Envasado</h3>
              <p class="text-gray-600">
                Envasamos en caliente en frascos de vidrio esterilizados,
                garantizando conservación natural sin aditivos.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div
              class="bg-esmeralda text-white rounded-full w-12 h-12 flex items-center justify-center flex-shrink-0 text-xl font-bold"
            >
              5
            </div>
            <div>
              <h3 class="text-xl font-bold text-gray-800 mb-2">
                Control de Calidad
              </h3>
              <p class="text-gray-600">
                Cada lote es inspeccionado cuidadosamente para asegurar que
                cumpla con nuestros altos estándares de calidad.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Beneficios -->
    <section class="py-16 bg-gradient-to-r from-orange-100 to-red-100">
      <div class="container mx-auto px-6">
        <h2 class="text-3xl font-bold text-center text-esmeralda mb-12">
          ¿Por qué elegir nuestras mermeladas?
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          <div class="bg-white p-6 rounded-lg shadow-lg">
            <h3 class="text-xl font-bold text-gray-800 mb-3">
              🍇 Frutas de Temporada
            </h3>
            <p class="text-gray-600">
              Utilizamos frutas en su mejor momento, garantizando sabores
              intensos y naturales.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-lg">
            <h3 class="text-xl font-bold text-gray-800 mb-3">
              🌿 Sin Conservantes
            </h3>
            <p class="text-gray-600">
              100% natural, sin químicos ni aditivos artificiales. Solo frutas,
              azúcar y amor.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-lg">
            <h3 class="text-xl font-bold text-gray-800 mb-3">
              🏺 Receta Tradicional
            </h3>
            <p class="text-gray-600">
              Elaboradas con técnicas heredadas de generaciones, manteniendo la
              autenticidad del sabor casero.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-lg">
            <h3 class="text-xl font-bold text-gray-800 mb-3">
              💚 Apoya la Reserva
            </h3>
            <p class="text-gray-600">
              Cada compra financia proyectos de conservación del bosque seco
              tropical y educación ambiental.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-esmeralda text-white text-center">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          ¿Quieres endulzar tu día?
        </h2>
        <p class="text-xl mb-8 max-w-2xl mx-auto">
          Prueba nuestras mermeladas artesanales y lleva el sabor del bosque a
          tu mesa.
        </p>
        <a
          href="/vinculate/"
          class="inline-flex items-center text-esmeralda bg-white hover:bg-gray-100 focus:ring-4 focus:ring-lime-300 font-medium rounded-lg text-lg px-8 py-3.5 text-center transition-all"
        >
          Contáctanos
          <svg
            class="ml-2 w-5 h-5"
            fill="currentColor"
            viewBox="0 0 20 20"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              fill-rule="evenodd"
              d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
              clip-rule="evenodd"></path>
          </svg>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
