---
import PaginaDetalle from "../../layouts/PaginaDetalle.astro";

const sabores = [
  {
    titulo: "Fresa premium",
    texto: "Elaborada con fresas seleccionadas, dulce y aromática. Perfecta para untar o rellenar pasteles.",
  },
  {
    titulo: "Kumquat especial",
    texto: "Sabor cítrico y ligeramente amargo, ideal para acompañar quesos y carnes.",
  },
  {
    titulo: "Durazno y canela",
    texto: "Combinación aromática y dulce, perfecta para acompañar panes y galletas.",
  },
  {
    titulo: "Mora silvestre",
    texto: "Mora recolectada en el bosque, sabor intenso y ligeramente ácido.",
  },
  { titulo: "Piña tropical", texto: "Refrescante y dulce, con trozos de piña fresca." },
  {
    titulo: "Mango especial",
    texto: "Mango maduro de la región, textura cremosa y sabor tropical.",
  },
];

const proceso = [
  {
    titulo: "Selección de frutas",
    texto: "Cosechamos frutas en su punto óptimo de maduración para garantizar el mejor sabor y aroma.",
  },
  {
    titulo: "Preparación",
    texto: "Lavamos, pelamos y cortamos cuidadosamente cada fruta, manteniendo su frescura e integridad.",
  },
  {
    titulo: "Cocción artesanal",
    texto: "Cocinamos a fuego lento en lotes pequeños, controlando temperatura y tiempo para preservar nutrientes y sabor.",
  },
  {
    titulo: "Envasado",
    texto: "Envasamos en caliente en frascos de vidrio esterilizados, garantizando conservación natural sin aditivos.",
  },
  {
    titulo: "Control de calidad",
    texto: "Cada lote es inspeccionado cuidadosamente para asegurar que cumpla con nuestros altos estándares de calidad.",
  },
];

const beneficios = [
  {
    titulo: "Frutas de temporada",
    texto: "Utilizamos frutas en su mejor momento, garantizando sabores intensos y naturales.",
  },
  {
    titulo: "Sin conservantes",
    texto: "100 % natural, sin químicos ni aditivos artificiales. Solo frutas, azúcar y amor.",
  },
  {
    titulo: "Receta tradicional",
    texto: "Elaboradas con técnicas heredadas de generaciones, manteniendo la autenticidad del sabor casero.",
  },
  {
    titulo: "Apoya la reserva",
    texto: "Cada compra financia proyectos de conservación del bosque seco tropical y educación ambiental.",
  },
];
---

<PaginaDetalle
  title="La Esmeralda Reserva Natural | Mermelada Artesanal"
  description="Mermeladas artesanales con frutas naturales. El sabor auténtico del bosque en cada frasco."
  programa="Emprendimientos verdes"
  programaHref="/emprendimientos/"
  heroTitulo="Mermelada artesanal"
  heroAcento="La Esmeralda"
  heroSubtitulo="El sabor auténtico de las frutas del bosque."
  heroImagen="/images/emprendimientos/mermelada/fondo_landing_mermelada.avif"
  heroAlt="Mermeladas artesanales de la Reserva Natural La Esmeralda"
  ficha={[
    { etiqueta: "Programa", valor: "Emprendimientos verdes" },
    { etiqueta: "Sabores", valor: "Seis, según la cosecha" },
    { etiqueta: "Producción", valor: "Pequeños lotes, receta tradicional" },
    { etiqueta: "Sin", valor: "Conservantes ni aditivos artificiales" },
  ]}
  galeriaTitulo="En imágenes"
  galeria={[
    {
      src: "/images/emprendimientos/mermelada/mermelada_1.avif",
      alt: "Frasco de mermelada artesanal de la reserva",
    },
  ]}
  ctaTitulo="¿Quieres endulzar tu"
  ctaAcento="día?"
  ctaTexto="Prueba nuestras mermeladas artesanales y lleva el sabor del bosque a tu mesa."
>
  <section>
    <h2>Nuestra mermelada</h2>
    <p class="destacado">
      Las Mermeladas Artesanales La Esmeralda son elaboradas con frutas frescas
      cultivadas en nuestra reserva y en fincas amigas de la región. Cada frasco
      es preparado en pequeños lotes con recetas tradicionales que resaltan el
      sabor natural de las frutas, sin conservantes ni aditivos artificiales.
    </p>
    <p>
      Nuestro proceso artesanal asegura una textura perfecta y un sabor intenso
      que transformará tus desayunos y postres en experiencias memorables,
      mientras apoyas la conservación del bosque seco tropical.
    </p>
  </section>

  <section>
    <h2>Nuestros sabores</h2>
    <div class="prosa-cajas">
      {
        sabores.map((s, i) => (
          <div class="prosa-caja">
            <span class="prosa-caja-etiqueta">{String(i + 1).padStart(2, "0")}</span>
            <h3>{s.titulo}</h3>
            <p>{s.texto}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <h2>Nuestro proceso artesanal</h2>
    <ol class="prosa-pasos">
      {
        proceso.map((p, i) => (
          <li>
            <span class="paso-n">{String(i + 1).padStart(2, "0")}</span>
            <span class="paso-cuerpo">
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </span>
          </li>
        ))
      }
    </ol>
  </section>

  <section>
    <h2>¿Por qué elegir nuestras mermeladas?</h2>
    <div class="prosa-cajas">
      {
        beneficios.map((b) => (
          <div class="prosa-caja">
            <h3>{b.titulo}</h3>
            <p>{b.texto}</p>
          </div>
        ))
      }
    </div>
  </section>
</PaginaDetalle>
