---
import PaginaDetalle from "../../layouts/PaginaDetalle.astro";

const galeria = [2, 3, 4, 5, 6].map((n) => ({
  src: `/images/emprendimientos/cerveza/cerveza_${n}.avif`,
  alt: `Elaboración artesanal de la cerveza La Esmeralda (${n - 1})`,
}));

const variedades = [
  {
    titulo: "Cerveza de kumquat",
    texto: "Elaborada con kumquats cultivados en la reserva, ofrece un sabor cítrico y refrescante único.",
  },
  {
    titulo: "Cerveza con hierbas",
    texto: "Aromatizada con hierbas aromáticas del bosque, brinda notas herbales y frescas.",
  },
  {
    titulo: "Cerveza de miel",
    texto: "Endulzada naturalmente con miel de abejas nativas, sabor suave y equilibrado.",
  },
];

const beneficios = [
  {
    titulo: "100 % artesanal",
    texto: "Elaborada en pequeños lotes con técnicas tradicionales, sin aditivos artificiales ni conservantes.",
  },
  {
    titulo: "Ingredientes locales",
    texto: "Utilizamos frutas y hierbas cultivadas en la reserva o por productores locales comprometidos con la sostenibilidad.",
  },
  {
    titulo: "Impacto positivo",
    texto: "Cada compra apoya directamente los proyectos de conservación y educación ambiental de la reserva.",
  },
  {
    titulo: "Sabor único",
    texto: "Experimenta perfiles de sabor que no encontrarás en ninguna otra parte, inspirados en nuestro ecosistema.",
  },
];
---

<PaginaDetalle
  title="La Esmeralda Reserva Natural | Cerveza Artesanal"
  description="Cerveza artesanal con ingredientes naturales. Sabor único del bosque seco tropical."
  programa="Emprendimientos verdes"
  programaHref="/emprendimientos/"
  heroTitulo="Cerveza artesanal"
  heroAcento="La Esmeralda"
  heroSubtitulo="Sabor auténtico con ingredientes del bosque seco tropical."
  heroImagen="/images/emprendimientos/cerveza/fondo_cerveza_2.avif"
  heroAlt="Cerveza artesanal de la Reserva Natural La Esmeralda"
  ficha={[
    { etiqueta: "Programa", valor: "Emprendimientos verdes" },
    { etiqueta: "Variedades", valor: "Kumquat, hierbas y miel" },
    { etiqueta: "Producción", valor: "Pequeños lotes, sin conservantes" },
    { etiqueta: "Agua", valor: "De manantial de la reserva" },
  ]}
  galeriaTitulo="Proceso de elaboración"
  galeria={galeria}
  ctaTitulo="¿Quieres probar nuestra"
  ctaAcento="cerveza?"
  ctaTexto="Visita la reserva y descubre nuestros productos artesanales que apoyan la conservación."
>
  <section>
    <h2>Nuestra cerveza</h2>
    <p class="destacado">
      La Cerveza Artesanal La Esmeralda es el resultado de combinar técnicas
      tradicionales de elaboración con ingredientes únicos de nuestro entorno.
      Cada lote es preparado con dedicación, utilizando agua de manantial de la
      reserva y frutas locales que aportan sabores distintivos y auténticos.
    </p>
    <p>
      Este emprendimiento no solo produce una bebida de calidad excepcional,
      sino que también genera recursos para la conservación de la reserva y
      promueve el uso sostenible de productos del bosque.
    </p>
  </section>

  <section>
    <h2>Nuestras variedades</h2>
    <div class="prosa-cajas">
      {
        variedades.map((v, i) => (
          <div class="prosa-caja">
            <span class="prosa-caja-etiqueta">{String(i + 1).padStart(2, "0")}</span>
            <h3>{v.titulo}</h3>
            <p>{v.texto}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <h2>Nuestro maestro cervecero</h2>
    <div class="tile prosa-imagen">
      <img
        src="/images/emprendimientos/cerveza/maestro_cervecero.avif"
        alt="El maestro cervecero de La Esmeralda en plena elaboración"
        loading="lazy"
        decoding="async"
      />
    </div>
    <p>
      Con años de experiencia en la elaboración artesanal de cerveza, nuestro
      maestro cervecero combina conocimiento técnico con creatividad para
      desarrollar recetas únicas que reflejan la esencia de La Esmeralda.
    </p>
    <p>
      Cada lote es supervisado cuidadosamente para garantizar la más alta
      calidad, desde la selección de ingredientes hasta el embotellado final.
    </p>
  </section>

  <section>
    <h2>¿Por qué elegir nuestra cerveza?</h2>
    <div class="prosa-cajas">
      {
        beneficios.map((b) => (
          <div class="prosa-caja">
            <h3>{b.titulo}</h3>
            <p>{b.texto}</p>
          </div>
        ))
      }
    </div>
  </section>
</PaginaDetalle>
