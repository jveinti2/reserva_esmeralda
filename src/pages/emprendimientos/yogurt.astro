---
import PaginaDetalle from "../../layouts/PaginaDetalle.astro";

const galeria = [1, 2, 3, 4].map((n) => ({
  src: `/images/emprendimientos/yogurt/yogur_img_${n}.avif`,
  alt: `Elaboración artesanal del yogurt La Esmeralda (${n})`,
}));

const sabores = [
  { titulo: "Fresa natural", texto: "Con fresas frescas y dulces, sin azúcares añadidos, sabor suave y delicioso." },
  { titulo: "Mango tropical", texto: "Mango de la región en trozos generosos, cremoso y refrescante." },
  { titulo: "Mora del bosque", texto: "Mora fresca cultivada localmente, ligeramente ácida y nutritiva." },
  { titulo: "Miel y granola", texto: "Endulzado con miel natural y granola artesanal, perfecto para el desayuno." },
  { titulo: "Coco natural", texto: "Con trozos de coco fresco, tropical y cremoso." },
  { titulo: "Durazno fresco", texto: "Durazno en trozos, suave y aromático." },
];

const beneficios = [
  {
    titulo: "100 % natural",
    texto: "Sin conservantes, colorantes ni saborizantes artificiales. Solo ingredientes naturales de la más alta calidad.",
  },
  {
    titulo: "Rico en probióticos",
    texto: "Cultivos vivos que benefician tu salud digestiva y fortalecen tu sistema inmunológico.",
  },
  {
    titulo: "Frutas frescas",
    texto: "Utilizamos frutas de temporada cultivadas localmente, garantizando frescura y sabor auténtico.",
  },
  {
    titulo: "Apoyas la conservación",
    texto: "Cada compra contribuye directamente a la protección del bosque seco tropical y su biodiversidad.",
  },
];
---

<PaginaDetalle
  title="La Esmeralda Reserva Natural | Yogurt Artesanal"
  description="Yogurt artesanal con frutas naturales. Nutritivo y delicioso, directo del campo."
  programa="Emprendimientos verdes"
  programaHref="/emprendimientos/"
  heroTitulo="Yogurt artesanal"
  heroAcento="La Esmeralda"
  heroSubtitulo="Cremoso, natural y lleno de sabor."
  heroImagen="/images/emprendimientos/yogurt/fondo_landing_yogurt.avif"
  heroAlt="Yogurt artesanal de la Reserva Natural La Esmeralda"
  ficha={[
    { etiqueta: "Programa", valor: "Emprendimientos verdes" },
    { etiqueta: "Sabores", valor: "Seis, según la fruta de temporada" },
    { etiqueta: "Leche", valor: "Fresca, de vacas de la región" },
    { etiqueta: "Sin", valor: "Conservantes ni colorantes artificiales" },
  ]}
  galeriaTitulo="Nuestro proceso"
  galeria={galeria}
  ctaTitulo="¿Quieres probar nuestro"
  ctaAcento="yogurt?"
  ctaTexto="Visítanos en la reserva o contacta con nosotros para hacer tu pedido."
>
  <section>
    <h2>Nuestro yogurt</h2>
    <p class="destacado">
      El Yogurt Artesanal La Esmeralda es elaborado con leche fresca de vacas de
      la región y frutas naturales cultivadas en la reserva. Sin conservantes ni
      colorantes artificiales, cada vasito es una explosión de sabor y nutrición
      que apoya la sostenibilidad local.
    </p>
    <p>
      Nuestro proceso artesanal garantiza un producto cremoso, saludable y
      delicioso que refleja el cuidado y dedicación que ponemos en cada aspecto
      de nuestra reserva.
    </p>
  </section>

  <section>
    <h2>Nuestros sabores</h2>
    <div class="prosa-cajas">
      {
        sabores.map((s, i) => (
          <div class="prosa-caja">
            <span class="prosa-caja-etiqueta">{String(i + 1).padStart(2, "0")}</span>
            <h3>{s.titulo}</h3>
            <p>{s.texto}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <h2>Beneficios de nuestro yogurt</h2>
    <div class="prosa-cajas">
      {
        beneficios.map((b) => (
          <div class="prosa-caja">
            <h3>{b.titulo}</h3>
            <p>{b.texto}</p>
          </div>
        ))
      }
    </div>
  </section>
</PaginaDetalle>
