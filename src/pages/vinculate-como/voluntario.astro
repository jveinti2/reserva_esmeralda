---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Carousel from '../../components/ui/Carousel.astro';

const carouselImages = [
  '/images/siembra_1.avif',
  '/images/siembra_2.avif',
  '/images/siembra_3.avif',
  '/images/siembra_4.avif',
  '/images/siembra_5.avif',
  '/images/siembra_6.avif',
];
---

<BaseLayout
  title="La Esmeralda Reserva Natural | Voluntariado"
  description="Vive la experiencia de conservar el bosque seco tropical. Programas de voluntariado de 3 días a 15 días."
>
  <Header />

  <main>
    <!-- Hero Section -->
    <section
      class="relative bg-cover bg-center h-96"
      style="background-image: url('/images/voluntariado.avif')"
    >
      <div class="absolute inset-0 bg-black bg-opacity-50 flex items-center justify-center">
        <div class="text-center text-white px-4">
          <h1 class="text-4xl md:text-6xl font-bold mb-4">
            Sé<br />
            <span class="text-lime-500 text-5xl md:text-9xl">Voluntario</span>
          </h1>
        </div>
      </div>
    </section>

    <!-- Introducción -->
    <section class="container mx-auto px-6 py-16">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-esmeralda mb-6">
          Programa de Voluntariado
        </h2>
        <p class="text-lg text-gray-700 leading-relaxed mb-6">
          Conecta con la naturaleza de una forma profunda y significativa. Nuestro programa de voluntariado te permite vivir la conservación del bosque seco tropical mientras contribuyes activamente a su protección.
        </p>
        <p class="text-lg text-gray-700 leading-relaxed">
          Trabaja mano a mano con nuestro equipo en actividades de reforestación, monitoreo de fauna, educación ambiental y mantenimiento de senderos. Una experiencia transformadora que cambiará tu perspectiva sobre la naturaleza.
        </p>
      </div>
    </section>

    <!-- Galería de Voluntariado -->
    <section class="py-16 bg-gray-100">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center text-esmeralda mb-12">
          Experiencia de Voluntariado
        </h2>
        <div class="max-w-5xl mx-auto">
          <Carousel images={carouselImages} alt="Experiencias de voluntariado" />
        </div>
      </div>
    </section>

    <!-- Programas Disponibles -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-6">
        <h2 class="text-3xl font-bold text-center text-esmeralda mb-12">
          Programas de Voluntariado
        </h2>
        <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
          <!-- Programa Semilla -->
          <div class="bg-gradient-to-br from-green-50 to-lime-50 p-8 rounded-lg shadow-lg hover:shadow-xl transition-all">
            <div class="text-center mb-6">
              <div class="text-6xl mb-4">🌱</div>
              <h3 class="text-2xl font-bold text-gray-800 mb-2">
                Plan Semilla
              </h3>
              <p class="text-3xl font-bold text-esmeralda mb-2">3 Días / 2 Noches</p>
              <p class="text-xl text-gray-600">$80 USD</p>
            </div>
            <ul class="space-y-3 mb-6">
              <li class="flex items-start">
                <svg class="w-6 h-6 text-green-600 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Alojamiento en cabaña compartida</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-green-600 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">3 comidas diarias vegetarianas</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-green-600 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Inducción a la reserva</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-green-600 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Actividades de reforestación</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-green-600 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Certificado de voluntariado</span>
              </li>
            </ul>
            <p class="text-sm text-gray-500 italic text-center">
              Ideal para un primer contacto con la conservación
            </p>
          </div>

          <!-- Programa Siembra -->
          <div class="bg-white p-8 rounded-lg shadow-xl border-2 border-esmeralda hover:shadow-2xl transition-all">
            <div class="inline-block bg-esmeralda text-white text-sm font-bold px-3 py-1 rounded-full mb-3">
              RECOMENDADO
            </div>
            <div class="text-center mb-6">
              <div class="text-6xl mb-4">🌿</div>
              <h3 class="text-2xl font-bold text-gray-800 mb-2">
                Plan Siembra
              </h3>
              <p class="text-3xl font-bold text-esmeralda mb-2">7 Días / 6 Noches</p>
              <p class="text-xl text-gray-600">$150 USD</p>
            </div>
            <ul class="space-y-3 mb-6">
              <li class="flex items-start">
                <svg class="w-6 h-6 text-green-700 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-800 font-medium">Todo del Plan Semilla +</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-green-700 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Talleres de educación ambiental</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-green-700 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Monitoreo de fauna</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-green-700 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Mantenimiento de senderos</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-green-700 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Participación en investigación</span>
              </li>
            </ul>
            <p class="text-sm text-gray-500 italic text-center">
              Inmersión completa en la vida de la reserva
            </p>
          </div>

          <!-- Programa Cosecha -->
          <div class="bg-gradient-to-br from-green-50 to-lime-50 p-8 rounded-lg shadow-lg hover:shadow-xl transition-all">
            <div class="text-center mb-6">
              <div class="text-6xl mb-4">🌳</div>
              <h3 class="text-2xl font-bold text-gray-800 mb-2">
                Plan Cosecha
              </h3>
              <p class="text-3xl font-bold text-esmeralda mb-2">15 Días / 14 Noches</p>
              <p class="text-xl text-gray-600">$250 USD</p>
            </div>
            <ul class="space-y-3 mb-6">
              <li class="flex items-start">
                <svg class="w-6 h-6 text-green-700 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-800 font-medium">Todo del Plan Siembra +</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-green-700 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Proyecto de investigación propio</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-green-700 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Formación en metodologías científicas</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-green-700 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Carta de recomendación</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-green-700 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Participación en emprendimientos</span>
              </li>
            </ul>
            <p class="text-sm text-gray-500 italic text-center">
              Experiencia transformadora y profunda
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Lo que incluye -->
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-6">
        <h2 class="text-3xl font-bold text-center text-esmeralda mb-12">
          Todos los Programas Incluyen
        </h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
          <div class="bg-white p-6 rounded-lg shadow-md text-center">
            <div class="text-4xl mb-3">🏠</div>
            <h3 class="font-bold text-gray-800 mb-2">Alojamiento</h3>
            <p class="text-gray-600 text-sm">Cabañas ecológicas compartidas</p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md text-center">
            <div class="text-4xl mb-3">🍽️</div>
            <h3 class="font-bold text-gray-800 mb-2">Alimentación</h3>
            <p class="text-gray-600 text-sm">3 comidas vegetarianas diarias</p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md text-center">
            <div class="text-4xl mb-3">👨‍🏫</div>
            <h3 class="font-bold text-gray-800 mb-2">Capacitación</h3>
            <p class="text-gray-600 text-sm">Talleres y formación continua</p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md text-center">
            <div class="text-4xl mb-3">📜</div>
            <h3 class="font-bold text-gray-800 mb-2">Certificado</h3>
            <p class="text-gray-600 text-sm">Certificado oficial de voluntariado</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Requisitos -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-6">
        <h2 class="text-3xl font-bold text-center text-esmeralda mb-12">
          Requisitos
        </h2>
        <div class="max-w-3xl mx-auto">
          <ul class="space-y-4">
            <li class="flex items-start">
              <svg class="w-6 h-6 text-esmeralda mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <p class="font-semibold text-gray-800">Edad mínima de 18 años</p>
                <p class="text-gray-600 text-sm">Menores de 18 pueden participar con autorización de padres o tutores</p>
              </div>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-esmeralda mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <p class="font-semibold text-gray-800">Buena condición física</p>
                <p class="text-gray-600 text-sm">Las actividades requieren caminatas por senderos y trabajo al aire libre</p>
              </div>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-esmeralda mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <p class="font-semibold text-gray-800">Seguro médico vigente</p>
                <p class="text-gray-600 text-sm">Requerido para todos los participantes</p>
              </div>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-esmeralda mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <p class="font-semibold text-gray-800">Actitud positiva y trabajo en equipo</p>
                <p class="text-gray-600 text-sm">Compromiso con la conservación y respeto por la naturaleza</p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-gradient-to-r from-green-500 to-lime-500 text-white text-center">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          ¿Listo para tu aventura de conservación?
        </h2>
        <p class="text-xl mb-8 max-w-2xl mx-auto">
          Regístrate ahora y sé parte del cambio. Las plazas son limitadas.
        </p>
        <a
          href="/contactanos/"
          class="inline-flex items-center text-esmeralda bg-white hover:bg-gray-100 focus:ring-4 focus:ring-lime-300 font-medium rounded-lg text-lg px-8 py-3.5 text-center transition-all"
        >
          Registrarme como voluntario
          <svg
            class="ml-2 w-5 h-5"
            fill="currentColor"
            viewBox="0 0 20 20"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              fill-rule="evenodd"
              d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
              clip-rule="evenodd"
            ></path>
          </svg>
        </a>
        <p class="text-sm mt-4 opacity-90">
          El formulario de registro estará disponible próximamente
        </p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
