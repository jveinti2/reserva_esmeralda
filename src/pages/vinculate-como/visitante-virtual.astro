---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
---

<BaseLayout
  title="La Esmeralda Reserva Natural | Visitante Virtual"
  description="Recorre la reserva virtualmente en 360° y apoya la conservación desde donde estés."
>
  <Header />

  <main>
    <!-- Hero Section -->
    <section
      class="relative bg-cover bg-center h-96"
      style="background-image: url('/images/voluntariado_free.avif')"
    >
      <div class="absolute inset-0 bg-black bg-opacity-50 flex items-center justify-center">
        <div class="text-center text-white px-4">
          <h1 class="text-4xl md:text-6xl font-bold mb-4">
            Aventura<br />
            <span class="text-lime-500 text-5xl md:text-9xl">Virtual</span>
          </h1>
        </div>
      </div>
    </section>

    <!-- Introducción -->
    <section class="container mx-auto px-6 py-16">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-esmeralda mb-6 text-center">
          Recorrido Virtual 360°
        </h2>
        <p class="text-lg text-gray-700 leading-relaxed mb-6">
          <strong>Recorre la reserva desde la aplicación 360° y apoya</strong> el turismo ecológico virtual. Vincúlate y haz parte de los que aportan.
        </p>
        <p class="text-lg italic text-gray-600 mb-6 text-center">
          "La fauna y flora silvestre no necesita de tu presencia, necesita de tu compromiso"
        </p>
        <p class="text-lg text-gray-700 leading-relaxed">
          Recorrido 360° es la posibilidad de ayudar desde donde estés. Con tu aporte económico, sumas para la conservación de esta reserva. Aquí se da hotel fijo y de paso a las especies silvestres que han sido desplazadas de sus hogares por depredación, deterioro o daño total de su hábitat.
        </p>
      </div>
    </section>

    <!-- Tours Disponibles -->
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-6">
        <h2 class="text-3xl font-bold text-center text-esmeralda mb-12">
          Tours Disponibles
        </h2>
        <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          <!-- Tour Gratuito -->
          <div class="bg-white p-8 rounded-lg shadow-lg">
            <div class="text-center mb-6">
              <div class="text-6xl mb-4">🌿</div>
              <h3 class="text-2xl font-bold text-gray-800 mb-2">
                Recorrido Gratuito
              </h3>
              <p class="text-4xl font-bold text-esmeralda mb-4">GRATIS</p>
            </div>
            <ul class="space-y-3 mb-6">
              <li class="flex items-start">
                <svg class="w-6 h-6 text-green-500 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-600">Tour virtual 360° de áreas públicas</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-green-500 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-600">Panoramas de la reserva</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-green-500 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-600">Información básica sobre el ecosistema</span>
              </li>
            </ul>
            <a
              href="/tour/gratis/"
              class="block text-center bg-esmeralda text-white hover:bg-green-700 font-medium rounded-lg px-6 py-3 transition-all"
            >
              Iniciar Tour Gratuito
            </a>
          </div>

          <!-- Tour Premium -->
          <div class="bg-gradient-to-br from-green-50 to-lime-50 p-8 rounded-lg shadow-xl border-2 border-esmeralda">
            <div class="text-center mb-6">
              <div class="inline-block bg-esmeralda text-white text-sm font-bold px-3 py-1 rounded-full mb-3">
                RECOMENDADO
              </div>
              <div class="text-6xl mb-4">🌟</div>
              <h3 class="text-2xl font-bold text-gray-800 mb-2">
                Recorrido Premium
              </h3>
              <p class="text-gray-600 mb-2">Desde</p>
              <p class="text-4xl font-bold text-esmeralda mb-4">$15 USD</p>
            </div>
            <ul class="space-y-3 mb-6">
              <li class="flex items-start">
                <svg class="w-6 h-6 text-green-600 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700 font-medium">Todo del tour gratuito +</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-green-600 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Acceso a zonas exclusivas de conservación</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-green-600 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Contenido multimedia detallado sobre especies</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-green-600 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Apoyas directamente la conservación</span>
              </li>
            </ul>
            <div class="space-y-3">
              <p class="text-center text-sm text-gray-600 mb-3">Elige tu aporte:</p>
              <div class="grid grid-cols-3 gap-2">
                <a
                  href="/tour/pago/"
                  class="block text-center bg-esmeralda text-white hover:bg-green-700 font-medium rounded-lg px-4 py-2 transition-all"
                >
                  $15
                </a>
                <a
                  href="/tour/pago/"
                  class="block text-center bg-green-600 text-white hover:bg-green-700 font-medium rounded-lg px-4 py-2 transition-all"
                >
                  $25
                </a>
                <a
                  href="/tour/pago/"
                  class="block text-center bg-green-700 text-white hover:bg-green-800 font-medium rounded-lg px-4 py-2 transition-all"
                >
                  $50
                </a>
              </div>
              <p class="text-xs text-center text-gray-500 italic mt-2">
                Pago procesado por ePayco. Los pagos son seguros y se destinan 100% a la conservación.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Impacto de tu Aporte -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-6">
        <h2 class="text-3xl font-bold text-center text-esmeralda mb-12">
          ¿En qué se invierte tu aporte?
        </h2>
        <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
          <div class="text-center p-6 bg-green-50 rounded-lg shadow-md">
            <div class="text-5xl mb-4">🦎</div>
            <h3 class="text-xl font-bold text-gray-800 mb-3">
              Protección de Especies
            </h3>
            <p class="text-gray-600">
              Programas de conservación de herpetos, arácnidos y nutrias neotropicales
            </p>
          </div>

          <div class="text-center p-6 bg-blue-50 rounded-lg shadow-md">
            <div class="text-5xl mb-4">🏠</div>
            <h3 class="text-xl font-bold text-gray-800 mb-3">
              Mantenimiento de Instalaciones
            </h3>
            <p class="text-gray-600">
              Refugios para especies desplazadas y centros de investigación
            </p>
          </div>

          <div class="text-center p-6 bg-yellow-50 rounded-lg shadow-md">
            <div class="text-5xl mb-4">📚</div>
            <h3 class="text-xl font-bold text-gray-800 mb-3">
              Educación y Difusión
            </h3>
            <p class="text-gray-600">
              Materiales educativos y programas para la comunidad local
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-gradient-to-r from-green-500 to-lime-500 text-white text-center">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          ¿Listo para tu aventura virtual?
        </h2>
        <p class="text-xl mb-8 max-w-2xl mx-auto">
          Explora el bosque seco tropical desde la comodidad de tu hogar y apoya su conservación
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/tour/gratis/"
            class="inline-flex items-center justify-center px-8 py-4 text-lg font-medium text-esmeralda bg-white hover:bg-gray-100 rounded-lg transition-all"
          >
            Tour Gratuito
          </a>
          <a
            href="/tour/pago/"
            class="inline-flex items-center justify-center px-8 py-4 text-lg font-medium text-white border-2 border-white hover:bg-white hover:text-esmeralda rounded-lg transition-all"
          >
            Tour Premium
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
