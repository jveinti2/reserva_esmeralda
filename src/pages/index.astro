---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

import FloatingNotification from "../components/ui/FloatingNotification.astro";
import VideoDialog from "../components/ui/VideoDialog.astro";
import Hero from "../components/sections/Hero.astro";
import Cifras from "../components/sections/Cifras.astro";
import Marquesina from "../components/sections/Marquesina.astro";
import ProgramasBento from "../components/sections/ProgramasBento.astro";
import ExperienciaLista from "../components/sections/ExperienciaLista.astro";
import TestimoniosScroll from "../components/sections/TestimoniosScroll.astro";
import AliadosMarquee from "../components/sections/AliadosMarquee.astro";
import FAQSection from "../components/sections/FAQSection.astro";
import CTABanda from "../components/sections/CTABanda.astro";

const cifras = [
  {
    valor: "151-20",
    texto: "Reserva registrada · Resolución 227 de 2022",
  },
  { valor: "7", unidad: "años", texto: "Conservando el corredor biológico del río Opia" },
  { valor: "2,5", unidad: "km", texto: "De sendero interpretativo con 5 puntos de interés" },
  {
    valor: "8 %",
    texto: "Es lo que queda del bosque seco tropical en Colombia",
    destacada: true,
  },
];

const marquesina = [
  "Bosque seco tropical",
  "Ostras de agua dulce",
  "Corredor biológico del río Opia",
  "Sendero interpretativo de 2,5 km",
  "Recorrido virtual 360°",
  "Educación ambiental",
  "Emprendimientos verdes",
  "Doima · Piedras · Tolima",
];

const diferenciales = [
  {
    n: "01",
    titulo: "Ostras de agua dulce",
    texto:
      "La rareza biológica que da nombre a la reserva y la convierte en un hogar legendario.",
  },
  {
    n: "02",
    titulo: "Corredor del río Opia",
    texto: "Paso de la fauna silvestre del Tolima, custodiado durante siete años.",
  },
  {
    n: "03",
    titulo: "Investigación viva",
    texto:
      "Nutria neotropical, herpetos y arácnidos bajo estudio científico permanente.",
  },
  {
    n: "04",
    titulo: "Bosque seco tropical",
    texto:
      "Uno de los ecosistemas más amenazados del mundo: solo queda el 8 % de 9 millones de hectáreas.",
  },
];
---

<BaseLayout
  title="La Esmeralda Reserva Natural | Conservación del Bosque Seco Tropical"
  description="Reserva Natural La Esmeralda - Conservación, investigación y educación ambiental en el bosque seco tropical del Tolima, Colombia."
  preloadImage="/banner_2.avif"
>
  <FloatingNotification
    text="¡Nueva página de emprendimientos disponible! Haz clic aquí"
    href="/emprendimientos/"
    show={true}
  />

  <Header />

  <main>
    <Hero
      imagen="/banner_2.avif"
      alt="Barranquero en el bosque seco tropical de la Reserva Natural La Esmeralda"
      ancho={1920}
      alto={1080}
      posicion="50% 40%"
      eyebrow="Reserva Natural de la Sociedad Civil 151-20 · Doima, Piedras, Tolima"
      titulo="La Esmeralda"
      acento="Reserva Natural"
      subtitulo="Hogar legendario de las ostras de agua dulce"
      lead="Conservando el bosque seco tropical del Tolima para las futuras generaciones, en el corredor biológico del río Opia."
    >
      <Fragment slot="acciones">
        <a href="/reserva/" class="btn btn-lima">
          Conoce la reserva
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
        <a href="/sendero/rv-gratis/" class="btn btn-ghost">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="12" rx="9" ry="4"></ellipse><path d="M12 3v18"></path><path d="M4.5 9.5A9 9 0 0 1 19.5 9.5"></path></svg>
          Recorrido virtual 360° · Gratis
        </a>
      </Fragment>

      <VideoDialog
        slot="lateral"
        video="/videos/reserva_promo.mp4"
        poster="/poster.avif"
        titulo="Un recorrido por la reserva"
        duracion="2:40"
      />

      <Cifras slot="pie" cifras={cifras} />
    </Hero>

    <Marquesina items={marquesina} />

    <!-- Nuestra reserva: texto + composicion de imagenes -->
    <section class="banda-papel">
      <div class="wrap">
        <div class="grid12 nosotros">
          <div class="nosotros-texto reveal">
            <span class="eyebrow">Nuestra reserva</span>
            <h2 class="titulo">
              Un oasis para la fauna y la flora que transita por el <em>río Opia</em>
            </h2>
            <p class="lead">
              Hace algún tiempo, dos personas apasionadas por la naturaleza
              iniciamos el sueño de ser guardianes de una porción de terreno en
              Doima, Piedras, Tolima, que gradualmente convertimos en un oasis
              para la fauna y la flora silvestre que transita por el corredor
              biológico del río Opia.
            </p>
            <p class="nosotros-parrafo">
              Hoy, después de 7 años, somos la Reserva Natural de la Sociedad
              Civil (RNSC) 151-20 La Esmeralda, según la resolución No. 227 del 1
              de diciembre de 2022, emitida por el Ministerio del Medio Ambiente
              a través de Parques Nacionales.
            </p>
            <p class="nosotros-cita">
              ¡Seguimos creyendo que todos podemos pasar de la intención a los
              hechos!
            </p>
            <div class="nosotros-cta">
              <a href="/sendero/rv-gratis/" class="btn btn-esm">
                Entra a la reserva ahora
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
              </a>
              <span class="nosotros-nota">Recorrido virtual 360°, gratis</span>
            </div>
          </div>

          <div class="nosotros-composicion reveal">
            <div class="tile nosotros-grande">
              <img
                src="/images/conservacion/fondo_conservacion_1.avif"
                alt="Voluntarios sembrando árboles en la reserva"
                width="1200"
                height="759"
                loading="lazy"
                decoding="async"
              />
              <div class="nosotros-velo"></div>
              <div class="nosotros-pie">
                <span class="nosotros-pie-eyebrow">Reforestación</span>
                <span class="nosotros-pie-titulo">Cada árbol cuenta una historia</span>
              </div>
            </div>

            <div class="tile nosotros-pequena">
              <img
                src="/images/educacion/fondo_educacion_1.avif"
                alt="Niños observando la naturaleza en un semillero ambiental"
                width="1920"
                height="1280"
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="nosotros-insignia">
              <span class="insignia-eyebrow">Parques Nacionales</span>
              <span class="insignia-codigo">RNSC 151-20</span>
              <span class="insignia-nota">Resolución 227 · 1 dic 2022</span>
            </div>
          </div>
        </div>

        <div class="diferenciales reveal">
          {
            diferenciales.map((d) => (
              <div class="diferencial">
                <span class="diferencial-n acento">{d.n}</span>
                <h3>{d.titulo}</h3>
                <p>{d.texto}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <ProgramasBento />

    <ExperienciaLista />

    <TestimoniosScroll />

    <AliadosMarquee />

    <FAQSection />

    <CTABanda
      titulo="Sé parte del"
      acento="cambio"
      texto="La conservación del bosque seco tropical es tarea de todos. Únete a nuestra misión como voluntario, padrino o madrina, y ayuda a proteger este ecosistema único."
    />
  </main>

  <Footer mapa={true} />
</BaseLayout>
