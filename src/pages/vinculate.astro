---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import Encabezado from "../components/sections/Encabezado.astro";
import CTABanda from "../components/sections/CTABanda.astro";

const planes = [
  {
    nombre: "Plan Semilla",
    precio: "$80 USD",
    duracion: "3 días / 2 noches",
    destacado: false,
    incluye: [
      "Alojamiento compartido",
      "3 comidas diarias",
      "Inducción",
      "Reforestación",
      "Certificado",
    ],
  },
  {
    nombre: "Plan Siembra",
    precio: "$150 USD",
    duracion: "7 días / 6 noches",
    destacado: true,
    incluye: [
      "Todo del Plan Semilla +",
      "Talleres de educación ambiental",
      "Monitoreo de fauna",
      "Mantenimiento de senderos",
      "Participación en investigación",
    ],
  },
  {
    nombre: "Plan Cosecha",
    precio: "$250 USD",
    duracion: "15 días / 14 noches",
    destacado: false,
    incluye: [
      "Todo del Plan Siembra +",
      "Proyecto de investigación propio",
      "Formación científica",
      "Carta de recomendación",
      "Emprendimientos verdes",
    ],
  },
];

const beneficiosPadrinos = [
  "Certificado digital de padrino",
  "Reportes de impacto",
  "Visitas guiadas",
];

const beneficiosVoluntariado = [
  "Alojamiento y alimentación",
  "Capacitación y talleres",
  "Certificado de participación",
];
---

<BaseLayout
  title="La Esmeralda Reserva Natural | Vincúlate"
  description="Descubre cómo puedes vincularte con nuestra reserva natural: recorrido virtual, plan de padrinos o voluntariado."
  preloadImage="/images/banner_2.avif"
  ogImage="/images/banner_2.avif"
>
  <Header />

  <main>
    <Hero
      imagen="/images/banner_2.avif"
      alt="Barranquero posado en la Reserva Natural La Esmeralda"
      posicion="50% 45%"
      eyebrow="Vincúlate · Doima, Piedras, Tolima"
      titulo="¿Te gustaría"
      acento="vincularte?"
      lead="Existen diferentes formas de apoyar nuestra labor de conservación. Elige la que mejor se adapte a ti y sé parte del cambio."
      tamano="compacto"
    />

    <section class="banda-papel">
      <div class="wrap">
        <Encabezado
          eyebrow="Tres caminos"
          titulo="Formas de estar"
          acento="cerca"
          lead="Desde una visita virtual hasta quince días viviendo el bosque seco tropical."
          doble={true}
          clase="reveal"
        />

        <div class="grid12 vias" style="margin-top: 48px;">
          <!-- 01 · Aventura virtual -->
          <article class="via reveal">
            <a href="/sendero/rv-gratis/" class="via-media" aria-label="Abrir el recorrido virtual 360">
              <img
                src="/images/vinculate/recorrido.avif"
                alt="Recorrido virtual 360 por la reserva"
                width="1116"
                height="667"
                loading="lazy"
                decoding="async"
              />
              <span class="via-velo"></span>
              <span class="via-play">
                <span>
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
                </span>
              </span>
              <span class="chip chip-lima via-chip">Virtual 360</span>
            </a>
            <div class="via-cuerpo">
              <h3>Aventura virtual</h3>
              <p>
                Explora nuestra reserva desde cualquier lugar del mundo con un
                recorrido virtual 360. Tu aporte nos ayuda a seguir conservando.
              </p>
              <div class="via-pie">
                <span class="via-pie-nota">Apoya con tu donación</span>
                <div class="via-donaciones">
                  <button id="epayco-btn-15" type="button" class="btn-donar">
                    $15 USD
                  </button>
                  <button id="epayco-btn-25" type="button" class="btn-donar destacado">
                    $25 USD
                  </button>
                  <button id="epayco-btn-50" type="button" class="btn-donar">
                    $50 USD
                  </button>
                </div>
              </div>
            </div>
          </article>

          <!-- 02 · Padrinos y madrinas -->
          <article class="via reveal">
            <div class="via-media">
              <img
                src="/images/padrinos.avif"
                alt="Plan de padrinos y madrinas de la reserva"
                width="1000"
                height="800"
                loading="lazy"
                decoding="async"
              />
              <span class="via-velo"></span>
              <span class="chip chip-glass via-chip">Padrinos</span>
            </div>
            <div class="via-cuerpo">
              <h3>Padrinos y madrinas</h3>
              <p>
                Únete a nuestro programa de apadrinamiento y participa
                activamente en las actividades de conservación de la reserva.
              </p>
              <ul class="via-lista">
                {
                  beneficiosPadrinos.map((b) => (
                    <li>
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                      {b}
                    </li>
                  ))
                }
              </ul>
              <div class="via-pie">
                <a href="/contactanos/" class="btn btn-esm">Quiero ser padrino</a>
              </div>
            </div>
          </article>

          <!-- 03 · Voluntariado -->
          <article class="via reveal">
            <div class="via-media">
              <img
                src="/images/vinculate/voluntariado.avif"
                alt="Programa de voluntariado en la reserva"
                width="1025"
                height="899"
                loading="lazy"
                decoding="async"
              />
              <span class="via-velo"></span>
              <span class="chip chip-glass via-chip">Voluntariado</span>
            </div>
            <div class="via-cuerpo">
              <h3>Voluntariado</h3>
              <p>
                Vive una experiencia inmersiva de 3 a 15 días. Participa en
                actividades de conservación, reforestación y educación
                ambiental.
              </p>
              <ul class="via-lista">
                {
                  beneficiosVoluntariado.map((b) => (
                    <li>
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                      {b}
                    </li>
                  ))
                }
              </ul>
              <div class="via-pie">
                <a href="/contactanos/" class="btn btn-esm">Quiero ser voluntario</a>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Planes de voluntariado -->
    <section class="banda-oscura">
      <div class="wrap">
        <Encabezado
          eyebrow="Voluntariado"
          titulo="Elige cuánto"
          acento="tiempo"
          cola="te quedas"
          lead="Tres estancias con el mismo fondo: trabajar el bosque seco tropical con quienes lo cuidan a diario."
          doble={true}
          claro={true}
          clase="reveal"
        />

        <div class="grid12 planes" style="margin-top: 56px;">
          {
            planes.map((p, i) => (
              <article class:list={["plan", "reveal", { destacado: p.destacado }]}>
                {p.destacado && <span class="plan-etiqueta">Recomendado</span>}
                <span class="plan-n acento">{String(i + 1).padStart(2, "0")}</span>
                <h3>{p.nombre}</h3>
                <span class="plan-precio">{p.precio}</span>
                <span class="plan-duracion">{p.duracion}</span>
                <ul class="plan-lista">
                  {p.incluye.map((x) => (
                    <li>{x}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Brochure -->
    <section class="banda-papel">
      <div class="wrap">
        <div class="grid12 descarga reveal">
          <div class="descarga-texto">
            <h2>¿Interesado en más información?</h2>
            <p>
              Descarga nuestro brochure y conoce más sobre la reserva natural,
              la fruta Kumquat y su potencial en la innovación agroindustrial.
            </p>
          </div>
          <div class="descarga-cta">
            <a
              href="/docs/KUMQUAT_UNA_OPORTUNIDAD_PARA_LA_INNOVACION_AGROINDUSTRIAL.pdf"
              download
              class="btn btn-esm"
            >
              Descargar documento
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v12m0 0-5-5m5 5 5-5M5 20h14"></path></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <CTABanda
      eyebrow="Hablemos"
      titulo="Cuéntanos qué te"
      acento="mueve"
      texto="Padrinazgo, voluntariado o una idea que aún no está en esta página: escríbenos y la miramos juntos."
      primario={{ texto: "Escríbenos", href: "/contactanos/" }}
      secundario={{ texto: "Ver vivencias", href: "/servicios/" }}
    />
  </main>

  <Footer />
</BaseLayout>

<!-- ePayco Script -->
<!-- is:inline es obligatorio: sin el, Astro se come la etiqueta y el
     checkout nunca carga (rv-gratis.astro ya lo llevaba). -->
<script is:inline src="https://checkout.epayco.co/checkout.js"></script>

<script>
  const EPAYCO_KEY = "d26b8a1a7a57889cd84d7fc4ca695ed0";

  function openEpaycoCheckout(amount: string, description: string) {
    // @ts-ignore - ePayco is loaded from external script
    const handler = ePayco.checkout.configure({
      key: EPAYCO_KEY,
      test: false,
    });

    handler.open({
      external: true,
      amount: amount,
      tax: "0.00",
      tax_base: amount,
      name: description,
      description: description,
      currency: "usd",
      country: "CO",
      response: "https://www.esmeraldareservanatural.com/200/recorrido/",
      confirmation: "https://www.esmeraldareservanatural.com/200/recorrido/",
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    document.getElementById("epayco-btn-15")?.addEventListener("click", () => {
      openEpaycoCheckout("15", "Donación 15 USD - Reserva La Esmeralda");
    });

    document.getElementById("epayco-btn-25")?.addEventListener("click", () => {
      openEpaycoCheckout("25", "Donación 25 USD - Reserva La Esmeralda");
    });

    document.getElementById("epayco-btn-50")?.addEventListener("click", () => {
      openEpaycoCheckout("50", "Donación 50 USD - Reserva La Esmeralda");
    });
  });
</script>
