---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import Hero from "../../components/sections/Hero.astro";
import Encabezado from "../../components/sections/Encabezado.astro";
import CTABanda from "../../components/sections/CTABanda.astro";

// OJO: los aportes son pagos reales y estan partidos en dos.
//  - En movil (< 768 px) los botones los enlaza el script de ePayco por id.
//  - En escritorio son enlaces a PayU.
// El corte de 768 px de .pago-movil / .pago-escritorio tiene que seguir
// coincidiendo con el `window.innerWidth < 768` del script: si se separan,
// se enseñan botones que nadie ha enlazado. Ni los id, ni los importes,
// ni las URL de retorno se tocan aqui: esto es solo presentacion.
---

<BaseLayout
  title="Recorrido virtual gratuito | La Esmeralda Reserva Natural"
  description="Entra al bosque seco tropical de la Reserva Natural La Esmeralda desde donde estés, con un recorrido virtual de 360° sin costo."
  preloadImage="/recorrido.avif"
  ogImage="/recorrido.avif"
>
  <Header />

  <main>
    <Hero
      imagen="/recorrido.avif"
      alt="Camino de entrada a la reserva, punto de partida del recorrido virtual"
      ancho={800}
      alto={534}
      posicion="50% 55%"
      eyebrow="Recorrido virtual · gratis"
      titulo="Entra a la reserva"
      acento="desde donde estés"
      lead="Un pedacito del bosque seco tropical en 360°, sin costo y sin registro. Si te gusta lo que ves, ven a caminarlo."
      tamano="compacto"
    />

    <section class="banda-oscura">
      <div class="wrap">
        <Encabezado
          eyebrow="Míralo ahora"
          titulo="El sendero en"
          acento="360°"
          lead="Arrastra para girar y toca los puntos para avanzar. Funciona mejor en pantalla completa."
          doble
          claro
          clase="reveal"
        />

        <div class="tour reveal">
          <iframe
            src="/tour-360/index.html"
            title="Recorrido virtual 360° de la Reserva Natural La Esmeralda"
            loading="lazy"
            allowfullscreen></iframe>
        </div>
      </div>
    </section>

    <section class="banda-papel">
      <div class="wrap">
        <Encabezado
          eyebrow="Aportes"
          titulo="¿Quieres ver el recorrido"
          acento="completo?"
          lead="Este pedacito es gratis. Con tu aporte sostenemos la reserva y desbloqueas el recorrido completo para explorarla entera."
          doble
          clase="reveal"
        />

        <div class="aportes reveal">
          <!-- Movil: botones enlazados por el script de ePayco (por id). -->
          <div class="aportes-botones pago-movil">
            <button id="epayco-button-10usd" type="button" class="btn-donar">15 USD</button>
            <button id="epayco-button-25usd" type="button" class="btn-donar destacado">25 USD</button>
            <button id="epayco-button-50usd" type="button" class="btn-donar">50 USD</button>
          </div>

          <!-- Escritorio: enlaces de PayU, otra pasarela distinta. -->
          <div class="aportes-botones pago-escritorio">
            <a
              href="https://biz.payulatam.com/L0f16064607E3C9"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-donar">15 USD</a
            >
            <a
              href="https://biz.payulatam.com/L0f1606204847AB"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-donar destacado">25 USD</a
            >
            <a
              href="https://biz.payulatam.com/L0f16066072FB1A"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-donar">50 USD</a
            >
          </div>

          <p class="aportes-nota">
            El pago se procesa fuera del sitio, en la pasarela. La reserva no
            guarda ningún dato de tu tarjeta.
          </p>
        </div>
      </div>
    </section>

    <CTABanda
      eyebrow="Ven a caminarlo"
      titulo="Lo virtual no reemplaza"
      acento="el bosque"
      texto="El sendero Alas y Naturaleza son cinco puntos de interés en una hora de recorrido guiado, con desayuno campesino incluido."
      primario={{ texto: "Conoce el sendero", href: "/sendero/" }}
      secundario={{ texto: "Agenda tu visita", href: "/contactanos/" }}
    />
  </main>

  <Footer />
</BaseLayout>

<!-- ePayco Integration Script for Mobile -->
<script is:inline src="https://checkout.epayco.co/checkout.js"></script>
<script is:inline>
  // Only run payment scripts on mobile
  if (window.innerWidth < 768) {
    const initEpayco = () => {
      // 15 usd Button
      document
        .getElementById("epayco-button-10usd")
        ?.addEventListener("click", function () {
          var handler = ePayco.checkout.configure({
            key: "d26b8a1a7a57889cd84d7fc4ca695ed0",
            test: false,
          });

          handler.open({
            external: true,
            amount: "10",
            tax: "0.00",
            tax_base: "10",
            name: "Donacion 15 usd",
            description: "Donacion 15 usd",
            currency: "usd",
            country: "CO",
            response: window.location.origin + "/recorrido-virtual",
            confirmation: window.location.origin + "/recorrido-virtual",
          });
        });

      // 25 USD Button
      document
        .getElementById("epayco-button-25usd")
        ?.addEventListener("click", function () {
          var handler = ePayco.checkout.configure({
            key: "d26b8a1a7a57889cd84d7fc4ca695ed0",
            test: false,
          });

          handler.open({
            external: true,
            amount: "24.99",
            tax: "0.00",
            tax_base: "24.99",
            name: "Donacion 25 usd",
            description: "Donacion 25 usd",
            currency: "usd",
            country: "CO",
            response: window.location.origin + "/recorrido-virtual",
            confirmation: window.location.origin + "/recorrido-virtual",
          });
        });

      // 50 USD Button
      document
        .getElementById("epayco-button-50usd")
        ?.addEventListener("click", function () {
          var handler = ePayco.checkout.configure({
            key: "d26b8a1a7a57889cd84d7fc4ca695ed0",
            test: false,
          });

          handler.open({
            external: true,
            amount: "50",
            tax: "0.00",
            tax_base: "50",
            name: "Donacion 50 usd",
            description: "Donacion 50 usd",
            currency: "usd",
            country: "CO",
            response: window.location.origin + "/recorrido-virtual",
            confirmation: window.location.origin + "/recorrido-virtual",
          });
        });
    };

    // Initialize when DOM is ready
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initEpayco);
    } else {
      initEpayco();
    }
  }
</script>
