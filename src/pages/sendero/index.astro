---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
---

<BaseLayout
  title="Sendero Interpretativo Alas y Naturaleza | La Esmeralda Reserva Natural"
  description="Recorre el Sendero Interpretativo Alas y Naturaleza, un camino de sensibilización y reconexión con la Madre Tierra en el corazón del bosque seco tropical."
  preloadImage="/banner_2.avif"
>
  <Header />

  <main>
    <!-- Hero Section -->
    <div class="mb-10">
      <div class="bg-[url('/banner_2.avif')] bg-cover bg-center min-h-[60vh] flex items-center">
        <div class="text-center container m-auto space-y-14 py-20">
          <div class="text-center pt-10">
            <h1 style="text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.9)">
              <span
                class="font-bold text-3xl md:text-4xl lg:text-5xl mb-3 pt-3 drop-shadow-lg shadow-black text-white"
              >
                Alas y Naturaleza
              </span>
              <br />
              <span
                class="font-bold text-lime-500 text-4xl md:text-5xl lg:text-7xl"
              >
                El sendero que despierta tu conciencia
              </span>
            </h1>
          </div>
          <div>
            <p
              style="text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.9)"
              class="text-white text-xl md:text-2xl px-5"
            >
              Un camino de sensibilización y reconexión con la Madre Tierra,<br
              />estamos en el corazón del bosque seco tropical.
            </p>
          </div>
          <div class="grid place-items-center pb-10">
            <a
              href="/contactanos/"
              class="inline-flex items-center text-white bg-esmeralda py-3 px-8 rounded-2xl text-lg shadow-lg hover:shadow-xl hover:bg-esmeralda-600 transition-all"
            >
              ¡Agenda tu recorrido ahora!
              <svg
                class="w-5 h-5 ml-2"
                fill="currentColor"
                viewBox="0 0 20 20"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"
                ></path>
                <path
                  d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Introducción -->
    <div class="container m-auto my-20">
      <div class="text-center lg:mx-auto lg:max-w-4xl px-4">
        <h2
          class="font-bold text-3xl md:text-4xl leading-tight mb-6 drop-shadow-xl shadow-black text-esmeralda"
        >
          Un recorrido donde tu maestra es la naturaleza
        </h2>
        <p class="text-lg text-gray-600 mb-3">
          El Sendero Alas y Naturaleza te invita a recorrer cinco puntos de
          interés que despiertan sentidos, generan conciencia y muestran que el
          verdadero protagonista es la vida silvestre. Aquí caminas como invitado
          en un oasis seguro y propio para la biodiversidad.
        </p>
      </div>
    </div>

    <!-- Los 5 Despertares -->
    <div class="bg-esmeralda py-16">
      <!-- Wave Divider Top -->
      <div class="overflow-hidden">
        <svg
          preserveAspectRatio="none"
          viewBox="0 0 1200 120"
          xmlns="http://www.w3.org/2000/svg"
          style="fill: #ffffff; width: 400%; height: 25px; transform: scaleX(-1)"
        >
          <path
            d="M0 0v46.29c47.79 22.2 103.59 32.17 158 28 70.36-5.37 136.33-33.31 206.8-37.5 73.84-4.36 147.54 16.88 218.2 35.26 69.27 18 138.3 24.88 209.4 13.08 36.15-6 69.85-17.84 104.45-29.34C989.49 25 1113-14.29 1200 52.47V0z"
            opacity=".25"></path>
          <path
            d="M0 0v15.81c13 21.11 27.64 41.05 47.69 56.24C99.41 111.27 165 111 224.58 91.58c31.15-10.15 60.09-26.07 89.67-39.8 40.92-19 84.73-46 130.83-49.67 36.26-2.85 70.9 9.42 98.6 31.56 31.77 25.39 62.32 62 103.63 73 40.44 10.79 81.35-6.69 119.13-24.28s75.16-39 116.92-43.05c59.73-5.85 113.28 22.88 168.9 38.84 30.2 8.66 59 6.17 87.09-7.5 22.43-10.89 48-26.93 60.65-49.24V0z"
            opacity=".5"></path>
          <path
            d="M0 0v5.63C149.93 59 314.09 71.32 475.83 42.57c43-7.64 84.23-20.12 127.61-26.46 59-8.63 112.48 12.24 165.56 35.4C827.93 77.22 886 95.24 951.2 90c86.53-7 172.46-45.71 248.8-84.81V0z"
          ></path>
        </svg>
      </div>

      <div class="container m-auto px-4">
        <h2
          class="text-center font-bold text-white text-3xl md:text-4xl leading-tight mb-12 drop-shadow-xl shadow-black"
        >
          Los 5 Despertares
        </h2>

        <div class="lg:mx-auto lg:max-w-6xl space-y-12">
          <!-- Despertar 1 -->
          <div
            class="mx-3 md:mx-0 bg-white border border-gray-200 rounded-lg shadow-md overflow-hidden"
          >
            <div class="p-6">
              <div class="flex items-center gap-4 mb-4">
                <div class="text-5xl">📍</div>
                <div>
                  <h3 class="text-2xl font-bold text-esmeralda">
                    Punto de interés #1 - Despertar del papel
                  </h3>
                  <p class="text-gray-600 font-medium">Mapa del inicio</p>
                </div>
              </div>
              <p class="text-gray-700">
                Reconoces tu papel: caminas como actor de reparto en una obra donde
                la naturaleza es protagonista.
              </p>
            </div>
            <img
          width="1152"
          height="1440"
              src="/sendero/mapa.avif"
              alt="Mapa del Sendero Interpretativo Alas y Naturaleza - Reserva Natural La Esmeralda"
              class="w-full h-auto"
              loading="lazy"
            />
          </div>

          <!-- Despertar 2 -->
          <div
            class="mx-3 md:mx-0 bg-white border border-gray-200 rounded-lg shadow-md overflow-hidden"
          >
            <div class="p-6">
              <div class="flex items-center gap-4 mb-4">
                <div class="text-5xl">🌳</div>
                <div>
                  <h3 class="text-2xl font-bold text-esmeralda">
                    Punto de interés #2 - Despertar del asombro
                  </h3>
                  <p class="text-gray-600 font-medium">
                    El bosque que respira vida
                  </p>
                </div>
              </div>
              <p class="text-gray-700">
                Cada lombriz, cada árbol caído y cada guacharaca revela que lo
                pequeño sostiene lo inmenso. Lombricultivo, heliconias, árboles
                caídos y guacharacas: resiliencia y equilibrio del bosque seco
                tropical.
              </p>
            </div>
            <img
          width="1152"
          height="1440"
              src="/sendero/h_1.avif"
              alt="Hablador: El bosque que respira vida - Lombricultivo, heliconias, árboles caídos y guacharacas"
              class="w-full h-auto"
              loading="lazy"
            />
          </div>

          <!-- Despertar 3 -->
          <div
            class="mx-3 md:mx-0 bg-white border border-gray-200 rounded-lg shadow-md overflow-hidden"
          >
            <div class="p-6">
              <div class="flex items-center gap-4 mb-4">
                <div class="text-5xl">💧</div>
                <div>
                  <h3 class="text-2xl font-bold text-esmeralda">
                    Punto de interés #3 - Despertar de la gratitud
                  </h3>
                  <p class="text-gray-600 font-medium">
                    Humedales: fábricas de vida
                  </p>
                </div>
              </div>
              <p class="text-gray-700">
                Cada gota es vida compartida y refugio de especies que dependen
                del agua. Ecosistemas de agua, regulación hídrica, anfibios,
                artrópodos y el árbol de cacao.
              </p>
            </div>
            <img
          width="1152"
          height="1440"
              src="/sendero/h_2.avif"
              alt="Hablador: Humedales, fábricas de vida - Ecosistemas de agua, anfibios, artrópodos y cacao"
              class="w-full h-auto"
              loading="lazy"
            />
          </div>

          <!-- Despertar 4 -->
          <div
            class="mx-3 md:mx-0 bg-white border border-gray-200 rounded-lg shadow-md overflow-hidden"
          >
            <div class="p-6">
              <div class="flex items-center gap-4 mb-4">
                <div class="text-5xl">🐦</div>
                <div>
                  <h3 class="text-2xl font-bold text-esmeralda">
                    Punto de interés #4 - Despertar del respeto
                  </h3>
                  <p class="text-gray-600 font-medium">
                    Donde nace el agua y canta el amor
                  </p>
                </div>
              </div>
              <p class="text-gray-700">
                Nacimientos de agua, reptiles y el ave emblemática Chiroxiphia
                lanceolata. Fauna del Río Opia, aves guardianas del corredor
                biológico e investigación al alcance de todos.
              </p>
            </div>
            <img
          width="1152"
          height="1440"
              src="/sendero/h_3.avif"
              alt="Hablador: Donde nace el agua y canta el amor - Fauna del Río Opia, aves y reptiles"
              class="w-full h-auto"
              loading="lazy"
            />
          </div>

          <!-- Despertar 5 -->
          <div
            class="mx-3 md:mx-0 bg-white border border-gray-200 rounded-lg shadow-md overflow-hidden"
          >
            <div class="p-6">
              <div class="flex items-center gap-4 mb-4">
                <div class="text-5xl">🐝</div>
                <div>
                  <h3 class="text-2xl font-bold text-esmeralda">
                    Punto de interés #5 - Unión Macondiana
                  </h3>
                  <p class="text-gray-600 font-medium">
                    Tradición, polinizadores y ancestros
                  </p>
                </div>
              </div>
              <p class="text-gray-700">
                Humanidad y naturaleza comparten un mismo libreto donde todos
                tenemos un gran papel por interpretar. Raíces de historia campesina,
                kumquat, abejas nativas y el caucho ancestral del bosque.
              </p>
            </div>
            <img
          width="1152"
          height="1440"
              src="/sendero/h_4.avif"
              alt="Hablador: Unión Macondiana - Tradición, polinizadores, kumquat y el caucho ancestral"
              class="w-full h-auto"
              loading="lazy"
            />
          </div>
        </div>

        <div class="text-center mt-12">
          <a
            href="/contactanos/"
            class="inline-flex items-center text-white bg-white/20 hover:bg-white/30 py-3 px-8 rounded-2xl text-lg shadow-lg hover:shadow-xl transition-all"
          >
            Quiero vivir esta experiencia
            <svg
              class="w-5 h-5 ml-2"
              fill="currentColor"
              viewBox="0 0 20 20"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"
              ></path>
              <path
                d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Wave Divider Bottom -->
      <div class="overflow-hidden mt-16">
        <svg
          preserveAspectRatio="none"
          viewBox="0 0 1200 120"
          xmlns="http://www.w3.org/2000/svg"
          style="fill: #ffffff; width: 400%; height: 25px;"
        >
          <path
            d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z"
          ></path>
        </svg>
      </div>
    </div>

    <!-- Una promesa -->
    <div class="container m-auto my-20">
      <div class="lg:mx-auto lg:max-w-5xl px-4">
        <h2
          class="text-center font-bold text-3xl md:text-4xl leading-tight mb-8 text-esmeralda"
        >
          Una promesa
        </h2>
        <div
          class="mx-3 md:mx-0 p-6 bg-white border border-gray-200 rounded-lg shadow-md"
        >
          <p class="text-lg text-gray-700 leading-relaxed">
            Al terminar el recorrido, te reconoces más consciente, más conectado
            y con un compromiso de respeto renovado hacia la biodiversidad. Aquí
            la Reserva es un oasis seguro para la vida silvestre, y tu papel es
            apoyar, acompañar, aprender y dejarte inspirar.
          </p>
        </div>
      </div>
    </div>

    <!-- Información práctica -->
    <div class="bg-gray-50 py-16">
      <div class="container m-auto px-4">
        <div class="lg:mx-auto lg:max-w-4xl">
          <h2
            class="text-center font-bold text-3xl md:text-4xl leading-tight mb-8 text-esmeralda"
          >
            Información práctica
          </h2>

          <div class="bg-white p-8 rounded-lg shadow-md">
            <div class="grid md:grid-cols-2 gap-6">
              <div class="flex items-start gap-3">
                <div class="text-3xl">⏱️</div>
                <div>
                  <h3 class="font-bold text-lg mb-1">Duración</h3>
                  <p class="text-gray-700">Una (1) hora</p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="text-3xl">🥾</div>
                <div>
                  <h3 class="font-bold text-lg mb-1">Nivel</h3>
                  <p class="text-gray-700">Fácil, recomendado para 7+</p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="text-3xl">🕐</div>
                <div>
                  <h3 class="font-bold text-lg mb-1">Horarios</h3>
                  <p class="text-gray-700">
                    Disponibilidad de dos bloques<br />
                    Bloque 1: Inicio 7am a Finalización 9am<br />
                    Bloque 2: Inicio 8am a Finalización 10am<br />
                    Consultar disponibilidad con administrador
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="text-3xl">💰</div>
                <div>
                  <h3 class="font-bold text-lg mb-1">Valor</h3>
                  <p class="text-gray-700">$50.000 por persona</p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="text-3xl">👥</div>
                <div>
                  <h3 class="font-bold text-lg mb-1">Importante</h3>
                  <p class="text-gray-700">
                    El recorrido se realiza con un grupo máximo de 5 personas.
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="text-3xl">✅</div>
                <div>
                  <h3 class="font-bold text-lg mb-1">Incluye</h3>
                  <p class="text-gray-700">
                    Orientador local con interpretación ambiental, acceso a la
                    reserva y desayuno campesino.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div class="text-center mt-8">
            <a
              href="/contactanos/"
              class="inline-flex items-center text-white bg-esmeralda hover:bg-esmeralda-600 py-3 px-8 rounded-2xl text-lg shadow-lg hover:shadow-xl transition-all"
            >
              ¡Agenda tu recorrido ahora!
              <svg
                class="w-5 h-5 ml-2"
                fill="currentColor"
                viewBox="0 0 20 20"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"
                ></path>
                <path
                  d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Testimonios -->
    <div class="container m-auto my-20">
      <div class="lg:mx-auto lg:max-w-5xl px-4">
        <h2
          class="text-center font-bold text-3xl md:text-4xl leading-tight mb-4 text-esmeralda"
        >
          Voces que inspiran
        </h2>
        <p class="text-center text-lg text-gray-600 mb-10">
          Lo que dicen quienes ya vivieron el sendero
        </p>

        <div class="space-y-6">
          <div class="p-6 bg-white border border-gray-200 rounded-lg shadow-md">
            <div class="flex items-start gap-4">
              <div class="text-4xl">💬</div>
              <div>
                <p class="text-gray-700 italic mb-3">
                  "Sentí que caminaba dentro de una historia viva. Cada punto de
                  la reserva me mostró algo que nunca había visto con tanto
                  detalle."
                </p>
                <p class="font-semibold text-gray-900">— Olga, visitante</p>
              </div>
            </div>
          </div>

          <div class="p-6 bg-white border border-gray-200 rounded-lg shadow-md">
            <div class="flex items-start gap-4">
              <div class="text-4xl">💬</div>
              <div>
                <p class="text-gray-700 italic mb-3">
                  "Los árboles, la zona de protección y los puntos de interés
                  hacen que uno se detenga, piense y escuche al bosque. Es un
                  recorrido que toca la conciencia."
                </p>
                <p class="font-semibold text-gray-900">
                  — Walter, estudiante universitario
                </p>
              </div>
            </div>
          </div>

          <div class="p-6 bg-white border border-gray-200 rounded-lg shadow-md">
            <div class="flex items-start gap-4">
              <div class="text-4xl">💬</div>
              <div>
                <p class="text-gray-700 italic mb-3">
                  "Me llevé paz y mucho aprendizaje. Recomiendo venir con el
                  corazón abierto, porque es una experiencia que en verdad enseña
                  a cuidar."
                </p>
                <p class="font-semibold text-gray-900">— Marta, visitante</p>
              </div>
            </div>
          </div>
        </div>

        <div class="text-center mt-10">
          <a
            href="/contactanos/"
            class="inline-flex items-center text-white bg-esmeralda hover:bg-esmeralda-600 py-3 px-8 rounded-2xl text-lg shadow-lg hover:shadow-xl transition-all"
          >
            Agendar mi visita
            <svg
              class="w-5 h-5 ml-2"
              fill="currentColor"
              viewBox="0 0 20 20"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"
              ></path>
              <path
                d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Ubicación y Contacto -->
    <div class="bg-gray-50 py-16">
      <div class="container m-auto px-4">
        <div class="lg:mx-auto lg:max-w-5xl">
          <h2
            class="text-center font-bold text-3xl md:text-4xl leading-tight mb-8 text-esmeralda"
          >
            Ubicación y Contacto
          </h2>

          <div class="bg-white p-6 rounded-lg shadow-md mb-6">
            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <div class="text-2xl">📍</div>
                <div>
                  <h3 class="font-bold text-lg mb-1">Ubicación</h3>
                  <p class="text-gray-700">
                    A 45 minutos de Ibagué, en Doima – Piedras, Tolima
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="text-2xl">📧</div>
                <div>
                  <h3 class="font-bold text-lg mb-1">Correo</h3>
                  <a
                    href="mailto:info@esmeraldareservanatural.com"
                    class="text-blue-600 hover:underline"
                  >
                    info@esmeraldareservanatural.com
                  </a>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="text-2xl">📞</div>
                <div>
                  <h3 class="font-bold text-lg mb-1">Teléfono</h3>
                  <a
                    href="tel:+573208096472"
                    class="text-blue-600 hover:underline"
                  >
                    (+57) 320 809 6472
                  </a>
                </div>
              </div>
            </div>
          </div>

          <div class="mb-6">
            <iframe
              class="w-full h-96 rounded-lg shadow-md"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3977.919315965023!2d-74.98013618552636!3d4.4261321452102464!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e38cdb01f199d5b%3A0x9a7b95a195fa8778!2sReserva%20Natural%20La%20Esmeralda%20Doima!5e0!3m2!1ses-419!2sco!4v1675908202324!5m2!1ses-419!2sco"
              style="border: 0"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>

          <div class="text-center">
            <a
              href="/contactanos/"
              class="inline-flex items-center text-white bg-esmeralda hover:bg-esmeralda-600 py-3 px-8 rounded-2xl text-lg shadow-lg hover:shadow-xl transition-all"
            >
              Agendar mi visita
              <svg
                class="w-5 h-5 ml-2"
                fill="currentColor"
                viewBox="0 0 20 20"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"
                ></path>
                <path
                  d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
