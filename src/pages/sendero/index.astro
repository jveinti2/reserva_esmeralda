---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import Hero from "../../components/sections/Hero.astro";
import Encabezado from "../../components/sections/Encabezado.astro";
import Cifras from "../../components/sections/Cifras.astro";
import CTABanda from "../../components/sections/CTABanda.astro";

const despertares = [
  {
    titulo: "Despertar del papel",
    subtitulo: "Mapa del inicio",
    texto:
      "Reconoces tu papel: caminas como actor de reparto en una obra donde la naturaleza es protagonista.",
    imagen: "/sendero/mapa.avif",
    alt: "Mapa del Sendero Interpretativo Alas y Naturaleza - Reserva Natural La Esmeralda",
  },
  {
    titulo: "Despertar del asombro",
    subtitulo: "El bosque que respira vida",
    texto:
      "Cada lombriz, cada árbol caído y cada guacharaca revela que lo pequeño sostiene lo inmenso. Lombricultivo, heliconias, árboles caídos y guacharacas: resiliencia y equilibrio del bosque seco tropical.",
    imagen: "/sendero/h_1.avif",
    alt: "Hablador: El bosque que respira vida - Lombricultivo, heliconias, árboles caídos y guacharacas",
  },
  {
    titulo: "Despertar de la gratitud",
    subtitulo: "Humedales: fábricas de vida",
    texto:
      "Cada gota es vida compartida y refugio de especies que dependen del agua. Ecosistemas de agua, regulación hídrica, anfibios, artrópodos y el árbol de cacao.",
    imagen: "/sendero/h_2.avif",
    alt: "Hablador: Humedales, fábricas de vida - Ecosistemas de agua, anfibios, artrópodos y cacao",
  },
  {
    titulo: "Despertar del respeto",
    subtitulo: "Donde nace el agua y canta el amor",
    texto:
      "Nacimientos de agua, reptiles y el ave emblemática Chiroxiphia lanceolata. Fauna del Río Opia, aves guardianas del corredor biológico e investigación al alcance de todos.",
    imagen: "/sendero/h_3.avif",
    alt: "Hablador: Donde nace el agua y canta el amor - Fauna del Río Opia, aves y reptiles",
  },
  {
    titulo: "Unión Macondiana",
    subtitulo: "Tradición, polinizadores y ancestros",
    texto:
      "Humanidad y naturaleza comparten un mismo libreto donde todos tenemos un gran papel por interpretar. Raíces de historia campesina, kumquat, abejas nativas y el caucho ancestral del bosque.",
    imagen: "/sendero/h_4.avif",
    alt: "Hablador: Unión Macondiana - Tradición, polinizadores, kumquat y el caucho ancestral",
  },
];

// Los iconos son SVG en linea: el diseño no lleva emojis y no queremos
// depender de la fuente de emoji del sistema.
const practica = [
  {
    etiqueta: "Duración",
    valor: "Una (1) hora",
    icono: "reloj",
  },
  {
    etiqueta: "Nivel",
    valor: "Fácil, recomendado para 7+",
    icono: "bota",
  },
  {
    etiqueta: "Horarios",
    valor:
      "Dos bloques: de 7 a 9 a. m. y de 8 a 10 a. m. Consulta disponibilidad con el administrador.",
    icono: "calendario",
  },
  {
    etiqueta: "Valor",
    valor: "$50.000 por persona",
    icono: "moneda",
  },
  {
    etiqueta: "Grupo",
    valor: "Máximo 5 personas por recorrido",
    icono: "personas",
  },
  {
    etiqueta: "Incluye",
    valor:
      "Orientador local con interpretación ambiental, acceso a la reserva y desayuno campesino.",
    icono: "tilde",
  },
];

const voces = [
  {
    cita: "Sentí que caminaba dentro de una historia viva. Cada punto de la reserva me mostró algo que nunca había visto con tanto detalle.",
    nombre: "Olga",
    rol: "Visitante",
  },
  {
    cita: "Los árboles, la zona de protección y los puntos de interés hacen que uno se detenga, piense y escuche al bosque. Es un recorrido que toca la conciencia.",
    nombre: "Walter",
    rol: "Estudiante universitario",
  },
  {
    cita: "Me llevé paz y mucho aprendizaje. Recomiendo venir con el corazón abierto, porque es una experiencia que en verdad enseña a cuidar.",
    nombre: "Marta",
    rol: "Visitante",
  },
];
---

<BaseLayout
  title="Sendero Interpretativo Alas y Naturaleza | La Esmeralda Reserva Natural"
  description="Recorre el Sendero Interpretativo Alas y Naturaleza, un camino de sensibilización y reconexión con la Madre Tierra en el corazón del bosque seco tropical."
  preloadImage="/images/aventura-banner.avif"
  ogImage="/images/aventura-banner.avif"
>
  <Header />

  <main>
    <Hero
      imagen="/images/aventura-banner.avif"
      alt="Entrada al sendero interpretativo de la Reserva Natural La Esmeralda"
      ancho={1200}
      alto={615}
      posicion="50% 55%"
      eyebrow="Alas y Naturaleza"
      titulo="El sendero que despierta"
      acento="tu conciencia"
      lead="Un camino de sensibilización y reconexión con la Madre Tierra, en el corazón del bosque seco tropical."
      tamano="compacto"
    >
      <Fragment slot="acciones">
        <a href="/contactanos/" class="btn btn-lima">
          Agenda tu recorrido
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
        <a href="/sendero/rv-gratis/" class="btn btn-ghost">Verlo en 360°</a>
      </Fragment>

      <Fragment slot="pie">
        <Cifras
          cifras={[
            { valor: "2,5", unidad: " km", texto: "de recorrido" },
            { valor: "5", texto: "puntos de interés" },
            { valor: "1", unidad: " h", texto: "de duración" },
            { valor: "5", texto: "personas por grupo", destacada: true },
          ]}
        />
      </Fragment>
    </Hero>

    <section class="banda-papel">
      <div class="wrap">
        <Encabezado
          eyebrow="Qué vas a caminar"
          titulo="Un recorrido donde tu maestra es la"
          acento="naturaleza"
          lead="El Sendero Alas y Naturaleza te invita a recorrer cinco puntos de interés que despiertan sentidos, generan conciencia y muestran que el verdadero protagonista es la vida silvestre. Aquí caminas como invitado en un oasis seguro y propio para la biodiversidad."
          doble
          clase="reveal"
        />
      </div>
    </section>

    <section class="banda-oscura">
      <div class="wrap">
        <Encabezado
          eyebrow="Punto a punto"
          titulo="Los cinco"
          acento="despertares"
          lead="Cada parada tiene su hablador en el camino. Toca la imagen para leerlo completo."
          doble
          claro
          clase="reveal"
        />

        <ol class="despertares">
          {
            despertares.map((d, i) => (
              <li class="despertar reveal">
                <button
                  type="button"
                  class="tile despertar-img"
                  data-abre-foto={i}
                  aria-label={`Ampliar: ${d.alt}`}
                >
                  <img src={d.imagen} alt={d.alt} width="1152" height="1440" loading="lazy" decoding="async" />
                  <span class="despertar-lupa">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.6-3.6M11 8v6M8 11h6" /></svg>
                  </span>
                </button>
                <div class="despertar-cuerpo">
                  <span class="despertar-n acento">{String(i + 1).padStart(2, "0")}</span>
                  <h3>{d.titulo}</h3>
                  <span class="chip chip-lima">{d.subtitulo}</span>
                  <p>{d.texto}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="despertares-cta reveal">
          <a href="/contactanos/" class="btn btn-lima">
            Quiero vivir esta experiencia
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
        </div>
      </div>
    </section>

    <section class="banda-papel">
      <div class="wrap">
        <blockquote class="promesa reveal">
          <span class="eyebrow">Una promesa</span>
          <p>
            Al terminar el recorrido, te reconoces más consciente, más conectado
            y con un compromiso de respeto renovado hacia la biodiversidad. Aquí
            la Reserva es un oasis seguro para la vida silvestre, y tu papel es
            apoyar, acompañar, aprender y dejarte inspirar.
          </p>
        </blockquote>
      </div>
    </section>

    <section class="banda-niebla">
      <div class="wrap">
        <Encabezado
          eyebrow="Antes de venir"
          titulo="Información"
          acento="práctica"
          lead="Todo lo que necesitas saber para agendar. Si tienes dudas, escríbenos y lo resolvemos."
          doble
          clase="reveal"
        />

        <div class="visita-datos reveal">
          {
            practica.map((p) => (
              <div class="dato-visita">
                <span class="dato-visita-ico">
                  {p.icono === "reloj" && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                  )}
                  {p.icono === "bota" && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3v9l-1.6 4.2A2 2 0 0 0 6.3 19H19a2 2 0 0 0 2-2v-1a4 4 0 0 0-2.6-3.7L14 10.5V3z" /><path d="M6 12h4" /></svg>
                  )}
                  {p.icono === "calendario" && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M8 3v4M16 3v4M3 11h18" /></svg>
                  )}
                  {p.icono === "moneda" && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M15 9H10.5a2 2 0 0 0 0 4h3a2 2 0 0 1 0 4H9M12 7v10" /></svg>
                  )}
                  {p.icono === "personas" && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2" /><path d="M3 19a6 6 0 0 1 12 0" /><path d="M16.5 5.5a3.2 3.2 0 0 1 0 6M18 19a6 6 0 0 0-2-4.5" /></svg>
                  )}
                  {p.icono === "tilde" && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="m8.5 12.5 2.5 2.5 4.5-5" /></svg>
                  )}
                </span>
                <span class="dato-visita-texto">
                  <span class="dato-visita-etiqueta">{p.etiqueta}</span>
                  <span class="dato-visita-valor">{p.valor}</span>
                </span>
              </div>
            ))
          }
        </div>

        <div class="despertares-cta reveal">
          <a href="/contactanos/" class="btn btn-esm">
            Agenda tu recorrido
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
        </div>
      </div>
    </section>

    <section class="banda-papel">
      <div class="wrap">
        <Encabezado
          eyebrow="Voces que inspiran"
          titulo="Lo que dicen quienes ya"
          acento="lo caminaron"
          doble
          clase="reveal"
        />
        <div class="voces reveal">
          {
            voces.map((v) => (
              <figure class="voz">
                <span class="voz-comilla acento" aria-hidden="true">&#8220;</span>
                <blockquote>{v.cita}</blockquote>
                <figcaption>
                  <span class="voz-nombre">{v.nombre}</span>
                  <span class="voz-rol">{v.rol}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <CTABanda
      eyebrow="Planea tu visita"
      titulo="El bosque te espera"
      acento="a las siete"
      texto="Escríbenos con la fecha y el número de personas y te confirmamos el bloque disponible."
      primario={{ texto: "Agendar mi visita", href: "/contactanos/" }}
      secundario={{ texto: "Ver el recorrido 360°", href: "/sendero/rv-gratis/" }}
    />
  </main>

  <dialog id="lightbox" class="lightbox" aria-label="Hablador ampliado">
    <button type="button" class="lightbox-cerrar" data-cierra-foto aria-label="Cerrar">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
    <button type="button" class="lightbox-nav anterior" data-foto-anterior aria-label="Anterior">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 19l-7-7 7-7"></path></svg>
    </button>
    <button type="button" class="lightbox-nav siguiente" data-foto-siguiente aria-label="Siguiente">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"></path></svg>
    </button>
    <img id="lightbox-img" src="" alt="" />
  </dialog>

  <Footer mapa={true} />
</BaseLayout>

<script>
  // Los habladores llevan texto: se pueden abrir a pantalla completa para
  // leerlos. Mismo patron que la galeria.
  function initHabladores() {
    const dlg = document.getElementById("lightbox") as HTMLDialogElement | null;
    const img = document.getElementById("lightbox-img") as HTMLImageElement | null;
    const piezas = Array.from(document.querySelectorAll<HTMLElement>("[data-abre-foto]"));
    if (!dlg || !img || piezas.length === 0) return;
    if (dlg.dataset.listo === "1") return;
    dlg.dataset.listo = "1";

    let actual = 0;

    function mostrar(i: number) {
      actual = (i + piezas.length) % piezas.length;
      const foto = piezas[actual].querySelector("img");
      if (!foto || !img) return;
      img.src = foto.src;
      img.alt = foto.alt;
    }

    piezas.forEach((p, i) => {
      p.addEventListener("click", () => {
        mostrar(i);
        dlg.showModal();
      });
    });

    dlg.querySelector("[data-cierra-foto]")?.addEventListener("click", () => dlg.close());
    dlg.querySelector("[data-foto-anterior]")?.addEventListener("click", () => mostrar(actual - 1));
    dlg.querySelector("[data-foto-siguiente]")?.addEventListener("click", () => mostrar(actual + 1));

    dlg.addEventListener("click", (e) => {
      if (e.target === dlg) dlg.close();
    });

    dlg.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") mostrar(actual - 1);
      if (e.key === "ArrowRight") mostrar(actual + 1);
    });
  }

  initHabladores();
  document.addEventListener("astro:page-load", initHabladores);
</script>
