---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
---

<BaseLayout
  title="La Esmeralda Reserva Natural | Sendero Interpretativo"
  description="Recorre el Sendero Alas y Naturaleza, un camino de sensibilización y reconexión con la Madre Tierra."
>
  <Header />

  <main>
    <!-- Hero Section -->
    <div class="mb-10">
      <div class="bg-[url('/banner_2.avif')] bg-cover bg-center">
        <div class="text-center container m-auto space-y-14">
          <div class="text-center pt-10">
            <h1 class="text-shadow-custom">
              <span
                class="font-bold text-3xl md:text-4xl lg:text-5xl mb-3 pt-3 drop-shadow-lg shadow-black text-white"
              >
                ✨ Alas y Naturaleza
              </span>
              <br />
              <span
                class="font-bold text-lime-500 text-4xl md:text-5xl lg:text-7xl"
              >
                El sendero que despierta tu conciencia
              </span>
            </h1>
          </div>
          <div>
            <p class="text-white text-xl md:text-2xl px-5 text-shadow-custom">
              Un camino de sensibilización y reconexión con la Madre Tierra,<br
              />estamos en el corazón del bosque seco tropical.
            </p>
          </div>
          <div class="grid place-items-center pb-10">
            <a
              href="/contactanos/"
              class="inline-flex items-center text-white bg-esmeralda py-3 px-8 rounded-2xl text-lg shadow-lg hover:shadow-xl hover:bg-esmeralda-600 transition-all"
            >
              Agenda tu recorrido ahora!
              <svg
                class="w-5 h-5 ml-2"
                fill="currentColor"
                viewBox="0 0 20 20"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"
                ></path>
                <path
                  d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Introducción -->
    <div class="container m-auto my-20">
      <div class="text-center lg:mx-auto lg:max-w-4xl px-4">
        <h2
          class="font-bold text-3xl md:text-4xl leading-tight mb-6 drop-shadow-xl shadow-black text-esmeralda"
        >
          🌱 Un recorrido donde tu maestra es la naturaleza
        </h2>
        <p class="text-lg text-gray-600 mb-3">
          El Sendero Alas y Naturaleza te invita a recorrer cinco puntos de
          interés que despiertan sentidos, generan conciencia y muestran que el
          verdadero protagonista es la vida silvestre. Aquí caminas como
          invitado en un oasis seguro y propio para la biodiversidad.
        </p>
      </div>
    </div>

    <!-- Los 5 Despertares -->
    <div class="bg-esmeralda py-16">
      <!-- Wave Divider Top -->
      <div class="overflow-hidden">
        <svg
          preserveAspectRatio="none"
          viewBox="0 0 1200 120"
          xmlns="http://www.w3.org/2000/svg"
          style="fill: #ffffff; width: 400%; height: 25px; transform: scaleX(-1)"
        >
          <path
            d="M0 0v46.29c47.79 22.2 103.59 32.17 158 28 70.36-5.37 136.33-33.31 206.8-37.5 73.84-4.36 147.54 16.88 218.2 35.26 69.27 18 138.3 24.88 209.4 13.08 36.15-6 69.85-17.84 104.45-29.34C989.49 25 1113-14.29 1200 52.47V0z"
            opacity=".25"></path>
          <path
            d="M0 0v15.81c13 21.11 27.64 41.05 47.69 56.24C99.41 111.27 165 111 224.58 91.58c31.15-10.15 60.09-26.07 89.67-39.8 40.92-19 84.73-46 130.83-49.67 36.26-2.85 70.9 9.42 98.6 31.56 31.77 25.39 62.32 62 103.63 73 40.44 10.79 81.35-6.69 119.13-24.28s75.16-39 116.92-43.05c59.73-5.85 113.28 22.88 168.9 38.84 30.2 8.66 59 6.17 87.09-7.5 22.43-10.89 48-26.93 60.65-49.24V0z"
            opacity=".5"></path>
          <path
            d="M0 0v5.63C149.93 59 314.09 71.32 475.83 42.57c43-7.64 84.23-20.12 127.61-26.46 59-8.63 112.48 12.24 165.56 35.4C827.93 77.22 886 95.24 951.2 90c86.53-7 172.46-45.71 248.8-84.81V0z"
          ></path>
        </svg>
      </div>

      <div class="container m-auto px-4">
        <h2
          class="text-center font-bold text-white text-3xl md:text-4xl leading-tight mb-12 drop-shadow-xl shadow-black"
        >
          Los 5 Despertares
        </h2>

        <div class="lg:mx-auto lg:max-w-6xl space-y-8">
          <!-- Despertar 1 -->
          <div
            class="mx-3 md:mx-0 p-6 bg-white border border-gray-200 rounded-lg shadow-md"
          >
            <div class="flex items-center gap-4 mb-4">
              <div class="text-5xl">📍</div>
              <div>
                <h3 class="text-2xl font-bold text-esmeralda">
                  Punto de interés #1 - Despertar del papel
                </h3>
                <p class="text-gray-500 font-semibold">Los árboles de guadua</p>
              </div>
            </div>
            <p class="text-gray-700 text-justify">
              Conoce el árbol símbolo de Colombia y su importancia ecológica. La
              guadua no solo es un material de construcción sostenible, sino
              también refugio y alimento para numerosas especies. Este punto te
              conecta con la sabiduría de nuestros ancestros y el valor de
              proteger estos bosques.
            </p>
          </div>

          <!-- Despertar 2 -->
          <div
            class="mx-3 md:mx-0 p-6 bg-white border border-gray-200 rounded-lg shadow-md"
          >
            <div class="flex items-center gap-4 mb-4">
              <div class="text-5xl">🦋</div>
              <div>
                <h3 class="text-2xl font-bold text-esmeralda">
                  Punto de interés #2 - Despertar de la metamorfosis
                </h3>
                <p class="text-gray-500 font-semibold">
                  El jardín de mariposas
                </p>
              </div>
            </div>
            <p class="text-gray-700 text-justify">
              Observa el ciclo de vida de las mariposas y reflexiona sobre los
              procesos de transformación. Este espacio te enseña que la belleza
              viene después del cambio, y que cada etapa de la vida tiene su
              propósito y valor.
            </p>
          </div>

          <!-- Despertar 3 -->
          <div
            class="mx-3 md:mx-0 p-6 bg-white border border-gray-200 rounded-lg shadow-md"
          >
            <div class="flex items-center gap-4 mb-4">
              <div class="text-5xl">💧</div>
              <div>
                <h3 class="text-2xl font-bold text-esmeralda">
                  Punto de interés #3 - Despertar del agua
                </h3>
                <p class="text-gray-500 font-semibold">
                  El río Opia y sus ostras
                </p>
              </div>
            </div>
            <p class="text-gray-700 text-justify">
              Descubre el hogar legendario de las ostras de agua dulce. El río
              Opia es fuente de vida y refugio de especies únicas. Aquí aprendes
              que el agua limpia es un tesoro que debemos proteger para las
              futuras generaciones.
            </p>
          </div>

          <!-- Despertar 4 -->
          <div
            class="mx-3 md:mx-0 p-6 bg-white border border-gray-200 rounded-lg shadow-md"
          >
            <div class="flex items-center gap-4 mb-4">
              <div class="text-5xl">🌺</div>
              <div>
                <h3 class="text-2xl font-bold text-esmeralda">
                  Punto de interés #4 - Despertar de los colores
                </h3>
                <p class="text-gray-500 font-semibold">
                  Las heliconias protectoras
                </p>
              </div>
            </div>
            <p class="text-gray-700 text-justify">
              Contempla la belleza de las heliconias, flores que atraen
              colibríes y representan alegría y exclusividad. Este punto te
              invita a apreciar los colores de la naturaleza y entender su rol
              en la polinización y equilibrio del ecosistema.
            </p>
          </div>

          <!-- Despertar 5 -->
          <div
            class="mx-3 md:mx-0 p-6 bg-white border border-gray-200 rounded-lg shadow-md"
          >
            <div class="flex items-center gap-4 mb-4">
              <div class="text-5xl">🌿</div>
              <div>
                <h3 class="text-2xl font-bold text-esmeralda">
                  Punto de interés #5 - Despertar del bosque seco
                </h3>
                <p class="text-gray-500 font-semibold">Ecosistema en peligro</p>
              </div>
            </div>
            <p class="text-gray-700 text-justify">
              Conoce uno de los ecosistemas más amenazados de Colombia. El
              bosque seco tropical alberga biodiversidad única y es esencial
              para el equilibrio climático. Este punto final te inspira a actuar
              en favor de la conservación.
            </p>
          </div>
        </div>
      </div>

      <!-- Wave Divider Bottom -->
      <div class="overflow-hidden mt-16">
        <svg
          preserveAspectRatio="none"
          viewBox="0 0 1200 120"
          xmlns="http://www.w3.org/2000/svg"
          style="fill: #ffffff; width: 400%; height: 25px;"
        >
          <path
            d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z"
          ></path>
        </svg>
      </div>
    </div>

    <!-- CTA Final -->
    <div class="container m-auto my-20 text-center px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-esmeralda mb-6">
        ¿Listo para despertar tu conciencia?
      </h2>
      <p class="text-lg text-gray-600 mb-8 max-w-2xl mx-auto">
        Reserva tu recorrido por el Sendero Alas y Naturaleza y vive una
        experiencia transformadora en contacto con la biodiversidad del bosque
        seco tropical.
      </p>
      <a
        href="/vinculate/"
        class="inline-flex items-center text-white bg-esmeralda hover:bg-esmeralda-600 focus:ring-4 focus:ring-lime-300 font-medium rounded-lg text-lg px-8 py-3.5 text-center transition-all"
      >
        Vincúlate aquí
        <svg
          class="ml-2 w-5 h-5"
          fill="currentColor"
          viewBox="0 0 20 20"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            fill-rule="evenodd"
            d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
            clip-rule="evenodd"></path>
        </svg>
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>
