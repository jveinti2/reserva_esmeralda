---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import Encabezado from "../components/sections/Encabezado.astro";
import TeamMember from "../components/ui/TeamMember.astro";
import CTABanda from "../components/sections/CTABanda.astro";

const pilares = [
  {
    titulo: "Objetivo",
    parrafos: [
      "En nuestra Reserva Natural, nos dedicamos a la conservación de la diversidad biológica y a promover un uso sostenible de los recursos naturales. Este refugio alberga una rica variedad de recursos naturales que son esenciales para la fauna silvestre, proporcionando alimento y un suministro constante de agua.",
      "Gracias a estos esfuerzos, tanto las especies nativas como aquellas que han encontrado un hogar aquí tras el deterioro de su hábitat pueden vivir en un entorno protegido, lejos de la amenaza de la caza. Trabajamos por un futuro donde la naturaleza y la humanidad coexistan en armonía.",
    ],
  },
  {
    titulo: "Misión",
    parrafos: [
      "Ser un referente vivo de conservación y educación ambiental que demuestra que un pequeño territorio puede generar un gran impacto. Proyectamos a la Reserva Natural La Esmeralda como un modelo inspirador de protección de la biodiversidad, restauración ecológica y aprendizaje comunitario.",
      "A través de la educación ambiental, la participación ciudadana y alianzas estratégicas, buscamos cerrar la brecha entre las personas y la naturaleza, fortaleciendo una cultura ambiental que trascienda fronteras y contribuya a un futuro más armónico y sostenible.",
    ],
  },
  {
    titulo: "Visión",
    parrafos: [
      "Para el año 2030, la Reserva proyecta estar consolidada como la alternativa ambiental líder en la región, con un modelo de gestión privada que articula instituciones ambientales y comunidades locales. Seremos un referente vivo de conservación, educación ambiental y restauración ecológica, demostrando que un pequeño territorio puede generar grandes transformaciones.",
      "Aspiramos a que cada persona se sienta conectada, inspirada y comprometida con la protección y regeneración de la biodiversidad, construyendo un territorio en el que la naturaleza y la comunidad coexistan en equilibrio y armonía.",
    ],
  },
];

const equipo = [
  { name: "Rafael Mauricio Bahamón", role: "Nuestro director", quote: "Respeto y amor por la naturaleza", image: "/images/reserva/Rafael.avif" },
  { name: "Esmeralda Becerra Vega", role: "Gerente de la reserva", quote: "Dejar una huella verde en cada corazón que se vincula", image: "/images/reserva/Esmeralda.avif" },
  { name: "Natalia Bahamón Becerra", role: "Fuente de inspiración de la reserva", quote: "Espíritu natural libre por el mundo", image: "/images/reserva/Natalia.avif" },
  { name: "Luis Tafur", role: "Cuidador de la reserva", quote: "La experiencia y sabiduría al servicio de la madre tierra", image: "/images/reserva/Luis.avif" },
  { name: "Verónica Forero", role: "Coordinadora de mantenimiento", quote: "Querer es poder", image: "/images/reserva/Monica.avif" },
  { name: "Doris Timoté", role: "Nuestra jardinera", quote: "La naturaleza no hace nada incompleto ni nada en vano", image: "/images/reserva/doris.avif" },
];

const cooperadores = [
  { frase: "¡Tenemos estanque!", nombre: "Alfredo Vargas", texto: "Gracias ingeniero por su valioso aporte, con su ayuda hoy ya tenemos peces felices." },
  { frase: "Mula parada no gana flete", nombre: "Mauricio Oviedo", texto: "Gracias a su aporte hoy la reserva tiene kiosco." },
  { frase: "¡Vamos a pintar!", nombre: "Sandra Avendaño", texto: "Toda una artista, gracias a su aporte e inspiración hizo realidad el camino de las mariposas." },
  { frase: "¡Lo hacemos hoy mismo!", nombre: "Edwin Pérez", texto: "Gracias por su aporte en la construcción de espacios naturales." },
  { frase: "La fuerza, el trabajo y el cumplimiento", nombre: "Mayerly Castillo", texto: "Gracias por la entrega en hacer más bella la reserva." },
  { frase: "La sabiduría ancestral campesina", nombre: "Mario Rojas y Nohemí Nieto", texto: "Gracias por todas las siembras, hoy la cosecha también lleva sus nombres." },
];

const normas = [
  "No están permitidas las mascotas, equipos de sonido, drones, envases desechables, armas, cuchillos, navajas, encendedores, fósforos, cigarrillos y bebidas alcohólicas.",
  "Para la convivencia en la reserva debes prometer comportamientos de cuidado, preservación, protección y no contaminación del medio ambiente, sin excepción alguna, incluyendo la contaminación auditiva, no consumo de bebidas alcohólicas, cigarrillos y ninguna sustancia alucinógena, dentro de la reserva.",
  "No marques, no escribas o causes daño a las cortezas de los árboles.",
  "No botes basura fuera de los recipientes.",
  "No debes tomar los frutos de los árboles de la reserva sin la debida autorización.",
  "Mantente siempre dentro de los senderos demarcados y no camines por áreas que no estén permitidas.",
  "No arranques, pellizques o tomes flores de las plantas.",
  "No grites, no hagas ruidos fuertes mientras estés en la zona de corredor biológico y área protegida.",
  "Nunca sustraer muestras biológicas de una reserva natural.",
  "No debes alimentar a los animales.",
  "Las tomas fotográficas y filmaciones deben ser autorizadas. Incumplir esta norma da como consecuencia la expulsión inmediata de la reserva y en algunos casos le puede ocasionar sanciones legales.",
  "No llevar personas no autorizadas: el ingreso de visitantes dentro de la reserva está prohibido, porque la carga humana dentro de la reserva atenta contra los principios de protección y conservación del área protegida.",
];

const marco = [
  {
    titulo: "Convenio de Diversidad Biológica",
    html: 'Es un acuerdo internacional al cual Colombia forma parte. Los países miembros se comprometen a conservar la diversidad biológica a través de áreas protegidas y apoyan iniciativas que contribuyan a estos objetivos. Se busca formas de hacer más efectiva la conservación ecológica y social, coordinando un sistema de áreas protegidas. En Colombia, este convenio fue aprobado por la <strong>Ley 165 de 1994</strong>.',
  },
  {
    titulo: "Constitución Política de 1991",
    html: 'Tiene un conjunto de deberes ambientales para el Estado, destacando el <strong>artículo 79</strong>, que establece la obligación de proteger la diversidad y integridad del ambiente y conservar áreas de importancia ecológica. También se establecen deberes compartidos entre el Estado y los particulares, como la protección de riquezas culturales y naturales.',
  },
  {
    titulo: "Ley 99 de 1993",
    html: 'Conocida como la ley ambiental, define una Reserva Natural de la Sociedad Civil y designa un registro ante el Ministerio de Ambiente. El <strong>Decreto 1996 de 1999</strong> regula las RNSC, definiendo sus usos, actividades, zonificación y registro ante la Unidad Administrativa de Parques Nacionales Naturales.',
  },
  {
    titulo: "Normativa complementaria",
    html: 'La <strong>Ley 216 de 2003</strong> delega el registro de las RNSC a la Unidad de Parques Nacionales dentro del Ministerio de Ambiente, Vivienda y Desarrollo Territorial. La <strong>Resolución 0207 de 2007</strong> crea un registro de organizaciones que trabajan en las Reservas Naturales de la Sociedad Civil. El <strong>Decreto 2372 de 2010</strong> reglamenta el Sistema Nacional de Áreas Protegidas y incluye a las RNSC.',
  },
];
---

<BaseLayout
  title="La Esmeralda Reserva Natural | Reserva"
  description="Conoce nuestra reserva natural, nuestro equipo, misión, visión y objetivos de conservación."
  preloadImage="/images/reserva.avif"
  ogImage="/images/reserva.avif"
>
  <Header />

  <main>
    <Hero
      imagen="/images/reserva.avif"
      alt="Colibrí sobre una flor en la Reserva Natural La Esmeralda"
      posicion="50% 45%"
      eyebrow="RNSC 151-20 · Doima, Piedras, Tolima"
      titulo="Nuestra reserva"
      acento="La Esmeralda"
      lead="Un modelo de gestión privada que articula instituciones ambientales y comunidades locales."
      tamano="compacto"
    />

    <!-- Objetivo, mision y vision -->
    <section class="banda-oscura">
      <div class="wrap pilares-envoltura">
        <Encabezado
          eyebrow="Quiénes somos"
          titulo="Un pequeño territorio que genera grandes"
          acento="transformaciones"
          claro={true}
          clase="reveal"
        />
        <div class="pilares reveal">
          {
            pilares.map((p, i) => (
              <div class="pilar">
                <span class="pilar-n acento">{String(i + 1).padStart(2, "0")}</span>
                <h3>{p.titulo}</h3>
                {p.parrafos.map((t) => (
                  <p>{t}</p>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Equipo -->
    <section class="banda-papel">
      <div class="wrap equipo-envoltura">
        <Encabezado eyebrow="Las personas" titulo="Nuestro" acento="equipo" clase="reveal" />
        <div class="equipo reveal">
          {equipo.map((m) => <TeamMember {...m} />)}
        </div>
      </div>
    </section>

    <!-- Cooperadores -->
    <section class="banda-niebla">
      <div class="wrap coop-envoltura">
        <Encabezado
          eyebrow="Gracias"
          titulo="Cooperadores"
          acento="activos"
          lead="Personas que pusieron manos, ideas y recursos para que la reserva sea lo que es hoy."
          clase="reveal"
        />
        <div class="coop reveal">
          {
            cooperadores.map((c) => (
              <figure class="coop-tarjeta">
                <blockquote>«{c.frase}»</blockquote>
                <figcaption>
                  <span class="coop-nombre">{c.nombre}</span>
                  <span class="coop-texto">{c.texto}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Normativa interna -->
    <section class="banda-papel">
      <div class="wrap grid12 normas-envoltura">
        <div class="normas-columna reveal">
          <span class="eyebrow">Antes de venir</span>
          <h2 class="titulo">Normativa <em>interna</em></h2>
          <p class="lead">Para la convivencia en la reserva.</p>
          <p class="normas-lema acento">«No te lleves nada, no dejes nada»</p>
        </div>
        <ol class="normas reveal">
          {
            normas.map((n, i) => (
              <li>
                <span class="norma-n">{String(i + 1).padStart(2, "0")}</span>
                <span>{n}</span>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="wrap">
        <p class="normas-aviso reveal">
          Incumplir esta normatividad es ir en contra de la preservación del
          medio ambiente. No cumplir estas normas dará como consecuencia la
          expulsión inmediata o incluso sanciones legales en algunos casos.
        </p>
      </div>
    </section>

    <!-- Marco juridico -->
    <section class="banda-niebla">
      <div class="wrap marco-envoltura">
        <Encabezado eyebrow="Respaldo legal" titulo="Marco" acento="jurídico" clase="reveal" />
        <div class="marco reveal">
          {
            marco.map((m, i) => (
              <div class="marco-item">
                <span class="marco-n acento">{String(i + 1).padStart(2, "0")}</span>
                <h3>{m.titulo}</h3>
                <p set:html={m.html} />
              </div>
            ))
          }
        </div>
        <div class="certificacion reveal">
          <span class="chip chip-lima">RNSC 151-20</span>
          <p>
            Nuestra Reserva <strong>La Esmeralda</strong> fue identificada como
            <strong>RNSC 151-20</strong> con resolución número
            <strong>227 del 1 de diciembre de 2022</strong>, emitida por el
            Ministerio de Medio Ambiente y Desarrollo Sostenible a través de
            Parques Nacionales Naturales de Colombia.
          </p>
        </div>
      </div>
    </section>

    <CTABanda
      eyebrow="Una joya verde"
      titulo="Ven a conocer la"
      acento="reserva"
      texto="Sendero interpretativo, vivencias de varios días o un recorrido virtual desde tu casa: hay muchas maneras de entrar."
      primario={{ texto: "Planea tu visita", href: "/contactanos/" }}
      secundario={{ texto: "Recorrido virtual 360°", href: "/sendero/rv-gratis/" }}
    />
  </main>

  <Footer />
</BaseLayout>
