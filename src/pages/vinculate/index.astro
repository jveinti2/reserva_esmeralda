---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
---

<BaseLayout
  title="La Esmeralda Reserva Natural | Vincúlate"
  description="Conecta con la naturaleza. Sé voluntario, donante o visitante virtual y apoya la conservación del bosque seco tropical."
>
  <Header />

  <main>
    <!-- Hero Section -->
    <section
      class="relative bg-cover bg-center h-96"
      style="background-image: url('/images/banner_2.avif')"
    >
      <div class="absolute inset-0 bg-black bg-opacity-50 flex items-center justify-center">
        <div class="text-center text-white px-4">
          <h1 class="text-4xl md:text-6xl font-bold mb-4">
            ¿Te gustaría<br />
            <span class="text-lime-500 text-5xl md:text-9xl">vincularte?</span>
          </h1>
        </div>
      </div>
    </section>

    <!-- Introducción -->
    <section class="container mx-auto px-6 py-16">
      <div class="max-w-4xl mx-auto text-center">
        <p class="text-lg md:text-xl text-gray-700 leading-relaxed">
          Tú decides cómo te quieres vincular, este sitio natural está listo para que inicies tu aventura de conexión con la madre tierra.
        </p>
      </div>
    </section>

    <!-- Opciones de Vinculación -->
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-6">
        <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
          <!-- Visitante Virtual -->
          <div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-2xl transition-all">
            <div class="relative h-64 overflow-hidden">
              <img
                src="/images/voluntariado_free.avif"
                alt="Visitante Virtual"
                class="w-full h-full object-cover hover:scale-110 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-6">
                <h3 class="text-2xl font-bold text-white mb-2">
                  Visitante Virtual
                </h3>
              </div>
            </div>
            <div class="p-6">
              <p class="text-gray-600 mb-4">
                Recorre la reserva desde la aplicación 360° y apoya el turismo ecológico virtual. Ayuda desde donde estés con tu aporte económico.
              </p>
              <p class="text-sm italic text-gray-500 mb-4">
                "La fauna y flora silvestre no necesita de tu presencia, necesita de tu compromiso"
              </p>
              <a
                href="/vinculate-como/visitante-virtual/"
                class="inline-flex items-center text-esmeralda font-semibold hover:underline"
              >
                Conocer más
                <svg class="ml-2 w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path
                    fill-rule="evenodd"
                    d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                    clip-rule="evenodd"
                  ></path>
                </svg>
              </a>
            </div>
          </div>

          <!-- Donante -->
          <div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-2xl transition-all">
            <div class="relative h-64 overflow-hidden">
              <img
                src="/images/padrinos.avif"
                alt="Donante / Padrino"
                class="w-full h-full object-cover hover:scale-110 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-6">
                <h3 class="text-2xl font-bold text-white mb-2">
                  Donante / Padrino
                </h3>
              </div>
            </div>
            <div class="p-6">
              <p class="text-gray-600 mb-4">
                Conviértete en padrino de la reserva. Tu aporte recurrente ayuda a mantener programas de conservación, investigación y educación ambiental.
              </p>
              <a
                href="/vinculate-como/donante/"
                class="inline-flex items-center text-esmeralda font-semibold hover:underline"
              >
                Conocer más
                <svg class="ml-2 w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path
                    fill-rule="evenodd"
                    d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                    clip-rule="evenodd"
                  ></path>
                </svg>
              </a>
            </div>
          </div>

          <!-- Voluntario -->
          <div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-2xl transition-all">
            <div class="relative h-64 overflow-hidden">
              <img
                src="/images/voluntariado.avif"
                alt="Voluntariado"
                class="w-full h-full object-cover hover:scale-110 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-6">
                <h3 class="text-2xl font-bold text-white mb-2">
                  Voluntariado
                </h3>
              </div>
            </div>
            <div class="p-6">
              <p class="text-gray-600 mb-4">
                Vive la experiencia de trabajar directamente en la conservación. Programas de 3 días, 1 semana o 15 días para conectar con la naturaleza.
              </p>
              <a
                href="/vinculate-como/voluntario/"
                class="inline-flex items-center text-esmeralda font-semibold hover:underline"
              >
                Conocer más
                <svg class="ml-2 w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path
                    fill-rule="evenodd"
                    d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                    clip-rule="evenodd"
                  ></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Beneficios de Vincularte -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-6">
        <h2 class="text-3xl md:text-4xl font-bold text-center text-esmeralda mb-12">
          ¿Por qué vincularte?
        </h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-6xl mx-auto">
          <div class="text-center p-6 bg-green-50 rounded-lg shadow-md">
            <div class="text-5xl mb-4">🌳</div>
            <h3 class="text-xl font-bold text-gray-800 mb-3">
              Conservación Directa
            </h3>
            <p class="text-gray-600">
              Tu aporte se destina directamente a proteger 52 hectáreas de bosque seco tropical
            </p>
          </div>

          <div class="text-center p-6 bg-blue-50 rounded-lg shadow-md">
            <div class="text-5xl mb-4">🔬</div>
            <h3 class="text-xl font-bold text-gray-800 mb-3">
              Investigación Científica
            </h3>
            <p class="text-gray-600">
              Apoyas proyectos de investigación sobre especies endémicas y en peligro
            </p>
          </div>

          <div class="text-center p-6 bg-yellow-50 rounded-lg shadow-md">
            <div class="text-5xl mb-4">👨‍🏫</div>
            <h3 class="text-xl font-bold text-gray-800 mb-3">
              Educación Ambiental
            </h3>
            <p class="text-gray-600">
              Financias programas educativos para niños y jóvenes de la región
            </p>
          </div>

          <div class="text-center p-6 bg-purple-50 rounded-lg shadow-md">
            <div class="text-5xl mb-4">💚</div>
            <h3 class="text-xl font-bold text-gray-800 mb-3">
              Impacto Real
            </h3>
            <p class="text-gray-600">
              Eres parte de una comunidad comprometida con la conservación
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-gradient-to-r from-green-500 to-lime-500 text-white text-center">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          Inicia tu aventura de conexión con la naturaleza
        </h2>
        <p class="text-xl mb-8 max-w-2xl mx-auto">
          Cada forma de vincularte hace la diferencia. Elige la que más resuene contigo y comienza hoy.
        </p>
        <a
          href="/contactanos/"
          class="inline-flex items-center text-esmeralda bg-white hover:bg-gray-100 focus:ring-4 focus:ring-lime-300 font-medium rounded-lg text-lg px-8 py-3.5 text-center transition-all"
        >
          Contáctanos
          <svg
            class="ml-2 w-5 h-5"
            fill="currentColor"
            viewBox="0 0 20 20"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              fill-rule="evenodd"
              d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
              clip-rule="evenodd"
            ></path>
          </svg>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
