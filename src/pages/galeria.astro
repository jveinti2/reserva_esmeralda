---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import Encabezado from "../components/sections/Encabezado.astro";
import CTABanda from "../components/sections/CTABanda.astro";

const imagenes = Array.from({ length: 9 }, (_, g) =>
  Array.from({ length: 3 }, (_, n) => ({
    src: `/images/galeria/g${g + 1}_${n + 1}.avif`,
    alt: `Fotografía ${g * 3 + n + 1} de la Reserva Natural La Esmeralda`,
  })),
).flat();

const colecciones = [
  { titulo: "Flora", texto: "Descubre la diversidad de plantas del bosque seco tropical." },
  { titulo: "Fauna", texto: "Conoce las especies que habitan nuestra reserva." },
  { titulo: "Paisajes", texto: "Paisajes únicos del ecosistema de La Esmeralda." },
  { titulo: "Comunidad", texto: "Personas que hacen posible la conservación." },
];
---

<BaseLayout
  title="La Esmeralda Reserva Natural | Galería"
  description="Explora la belleza natural de La Esmeralda a través de nuestra galería fotográfica."
  preloadImage="/images/galeria/banner_galeria.avif"
  ogImage="/images/galeria/banner_galeria.avif"
>
  <Header />

  <main>
    <Hero
      imagen="/images/galeria/banner_galeria.avif"
      alt="Grupo de visitantes en la Reserva Natural La Esmeralda"
      posicion="50% 40%"
      eyebrow="Galería fotográfica"
      titulo="Un vistazo a"
      acento="nuestra reserva"
      lead="Cada imagen cuenta una historia de conservación, biodiversidad y conexión con la naturaleza."
      tamano="compacto"
    />

    <section class="banda-papel">
      <div class="wrap grid12 galeria-intro">
        <div class="galeria-intro-texto reveal">
          <span class="eyebrow">La belleza del bosque seco</span>
          <h2 class="titulo">Los rincones más hermosos de <em>La Esmeralda</em></h2>
        </div>
        <div class="galeria-intro-lead reveal">
          <p class="lead">
            Explora los rincones más hermosos de La Esmeralda, desde sus
            senderos llenos de vida hasta los rostros de quienes trabajan día a
            día por la protección de este ecosistema único.
          </p>
          <p class="lead">
            Te invitamos a sumergirte en esta experiencia visual y descubrir por
            qué este lugar es tan especial para la conservación del bosque seco
            tropical.
          </p>
        </div>
      </div>
    </section>

    <section class="banda-papel galeria-banda">
      <div class="wrap">
        <div class="mosaico reveal">
          {
            imagenes.map((img, i) => (
              <button
                type="button"
                class="tile mosaico-pieza"
                data-abre-foto={i}
                aria-label={`Ampliar: ${img.alt}`}
              >
                <img src={img.src} alt={img.alt} loading="lazy" decoding="async" />
                <span class="mosaico-lupa">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.6-3.6M11 8v6M8 11h6" /></svg>
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </section>

    <section class="banda-niebla">
      <div class="wrap colecciones-envoltura">
        <Encabezado eyebrow="Explora" titulo="Nuestras" acento="colecciones" clase="reveal" />
        <div class="colecciones reveal">
          {
            colecciones.map((c, i) => (
              <div class="coleccion">
                <span class="coleccion-n acento">{String(i + 1).padStart(2, "0")}</span>
                <h3>{c.titulo}</h3>
                <p>{c.texto}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <CTABanda
      eyebrow="Galería"
      titulo="¿Quieres vivir esto en"
      acento="persona?"
      texto="Visita La Esmeralda y sé testigo de la belleza natural que protegemos con dedicación cada día."
      primario={{ texto: "Planea tu visita", href: "/contactanos/" }}
      secundario={{ texto: "Vincúlate", href: "/vinculate/" }}
    />
  </main>

  <dialog id="lightbox" class="lightbox" aria-label="Fotografía ampliada">
    <button type="button" class="lightbox-cerrar" data-cierra-foto aria-label="Cerrar">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
    <button type="button" class="lightbox-nav anterior" data-foto-anterior aria-label="Anterior">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 19l-7-7 7-7"></path></svg>
    </button>
    <button type="button" class="lightbox-nav siguiente" data-foto-siguiente aria-label="Siguiente">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"></path></svg>
    </button>
    <img id="lightbox-img" src="" alt="" />
  </dialog>

  <Footer />
</BaseLayout>

<script>
  function initGaleria() {
    const dlg = document.getElementById("lightbox") as HTMLDialogElement | null;
    const img = document.getElementById("lightbox-img") as HTMLImageElement | null;
    const piezas = Array.from(document.querySelectorAll<HTMLElement>("[data-abre-foto]"));
    if (!dlg || !img || piezas.length === 0) return;
    if (dlg.dataset.listo === "1") return;
    dlg.dataset.listo = "1";

    let actual = 0;

    function mostrar(i: number) {
      actual = (i + piezas.length) % piezas.length;
      const foto = piezas[actual].querySelector("img");
      if (!foto || !img) return;
      img.src = foto.src;
      img.alt = foto.alt;
    }

    piezas.forEach((p, i) => {
      p.addEventListener("click", () => {
        mostrar(i);
        dlg.showModal();
      });
    });

    dlg.querySelector("[data-cierra-foto]")?.addEventListener("click", () => dlg.close());
    dlg.querySelector("[data-foto-anterior]")?.addEventListener("click", () => mostrar(actual - 1));
    dlg.querySelector("[data-foto-siguiente]")?.addEventListener("click", () => mostrar(actual + 1));

    dlg.addEventListener("click", (e) => {
      if (e.target === dlg) dlg.close();
    });

    dlg.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") mostrar(actual - 1);
      if (e.key === "ArrowRight") mostrar(actual + 1);
    });
  }

  initGaleria();
  document.addEventListener("astro:page-load", initGaleria);
</script>
