---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import Carousel from "../components/ui/Carousel.astro";
import CTABanda from "../components/sections/CTABanda.astro";

const vivencias = [
  {
    eyebrow: "Vivencia 01",
    titulo: "Inmersión en nuestro",
    acento: "ecosistema",
    cita: "El lente de tu corazón es más potente que el lente de tu cámara, déjate sorprender.",
    autor: null,
    parrafos: [
      "Desde la foto de un celular hasta la cámara más costosa, la naturaleza siempre muestra su mejor perfil.",
    ],
    enlace: { texto: "Vincúlate aquí", href: "/vinculate/" },
    alt: "Visitantes fotografiando la naturaleza de la reserva",
    imagenes: Array.from({ length: 9 }, (_, i) => `/images/servicios/exp_${i + 1}.avif`),
  },
  {
    eyebrow: "Vivencia 02",
    titulo: "Rutinas",
    acento: "ancestrales",
    cita: null,
    autor: null,
    parrafos: [
      "Experimenta las tradiciones que han sostenido a las comunidades rurales durante generaciones. Participa en actividades auténticas como la ordeña de vacas, elaboración artesanal de queso y yogurt, y la producción de panela tradicional.",
      "Estas vivencias te conectan con la sabiduría ancestral y el valor del trabajo en armonía con la naturaleza.",
    ],
    enlace: { texto: "Vive la experiencia", href: "/vinculate/" },
    alt: "Actividades tradicionales del campo en la reserva",
    imagenes: Array.from({ length: 9 }, (_, i) => `/images/servicios/rut_${i + 1}.avif`),
  },
  {
    eyebrow: "Vivencia 03",
    titulo: "Conectando con la",
    acento: "madre tierra",
    cita: "Mira profundamente en la naturaleza y entonces comprenderás todo mejor.",
    autor: "Albert Einstein",
    parrafos: [
      "Descubre la conexión profunda entre los seres vivos y su entorno. Observa de cerca la fauna silvestre en su hábitat natural.",
    ],
    enlace: { texto: "Conecta con la naturaleza", href: "/vinculate/" },
    alt: "Fauna silvestre observada en la reserva",
    imagenes: Array.from({ length: 9 }, (_, i) => `/images/servicios/an_${i + 1}.avif`),
  },
  {
    eyebrow: "Vivencia 04",
    titulo: "Nunca dejamos de",
    acento: "aprender",
    cita: "La educación es el arma más poderosa que puedes usar para cambiar el mundo.",
    autor: "Nelson Mandela",
    parrafos: [
      "Participa en talleres de educación ambiental, aprende sobre biodiversidad y descubre cómo cada acción cuenta para la conservación de nuestro planeta.",
    ],
    enlace: { texto: "Aprende con nosotros", href: "/vinculate/" },
    alt: "Talleres de educación ambiental en la reserva",
    imagenes: Array.from({ length: 9 }, (_, i) => `/images/servicios/ap_${i + 1}.avif`),
  },
];
---

<BaseLayout
  title="La Esmeralda Reserva Natural | Vivencias"
  description="Descubre las experiencias y vivencias que ofrecemos en nuestra reserva natural."
  preloadImage="/images/servicios/banner_3.avif"
  ogImage="/images/servicios/banner_3.avif"
>
  <Header />

  <main>
    <Hero
      imagen="/images/servicios/banner_3.avif"
      alt="Visitantes recorriendo la Reserva Natural La Esmeralda"
      posicion="50% 45%"
      eyebrow="Vivencias · Doima, Piedras, Tolima"
      titulo="Un día"
      acento="en la reserva"
      lead="Cuatro maneras de vivir el bosque seco tropical, con el tiempo y el ritmo que quieras darles."
      tamano="compacto"
    />

    <section class="banda-papel">
      <div class="wrap">
        <blockquote class="serrat reveal">
          <p>
            Hoy puede ser un gran día, plantéatelo así. Aprovecharlo o que pase
            de largo depende, en parte, de ti. Dale el día libre a la
            experiencia, para comenzar, y recíbelo como si fuera fiesta de
            guardar. No consientas que se esfume, asómate y consume la vida a
            granel. Hoy puede ser un gran día: duro con él.
          </p>
          <footer>Joan Manuel Serrat</footer>
        </blockquote>
      </div>
    </section>

    {
      vivencias.map((v, i) => (
        <section class:list={["vivencia", i % 2 === 0 ? "banda-niebla" : "banda-papel"]}>
          <div class="wrap grid12 vivencia-fila">
            <div class:list={["vivencia-media", "reveal", { invertida: i % 2 === 1 }]}>
              <Carousel
                images={v.imagenes}
                alt={v.alt}
                wrapperClass="relative w-full overflow-hidden rounded-[28px]"
                heightClass="relative w-full h-72 lg:h-[440px]"
              />
            </div>
            <div class:list={["vivencia-texto", "reveal", { invertida: i % 2 === 1 }]}>
              <span class="eyebrow">{v.eyebrow}</span>
              <h2 class="titulo">
                {v.titulo} <em>{v.acento}</em>
              </h2>
              {v.cita && (
                <blockquote class="vivencia-cita">
                  {v.cita}
                  {v.autor && <footer>{v.autor}</footer>}
                </blockquote>
              )}
              {v.parrafos.map((p) => (
                <p class="lead">{p}</p>
              ))}
              <a href={v.enlace.href} class="btn btn-esm vivencia-cta">
                {v.enlace.texto}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </a>
            </div>
          </div>
        </section>
      ))
    }

    <CTABanda
      eyebrow="Vivencias"
      titulo="Planea tu día en la"
      acento="reserva"
      texto="Colegios, familias, investigadores y voluntarios: escríbenos y armamos la visita a la medida de tu grupo."
      primario={{ texto: "Contáctanos", href: "/contactanos/" }}
      secundario={{ texto: "Vincúlate", href: "/vinculate/" }}
    />
  </main>

  <Footer />
</BaseLayout>
