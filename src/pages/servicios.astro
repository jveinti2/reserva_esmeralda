---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Carousel from '../components/ui/Carousel.astro';

const experienciaImages = [
  '/images/servicios/exp_1.avif',
  '/images/servicios/exp_2.avif',
  '/images/servicios/exp_3.avif',
  '/images/servicios/exp_4.avif',
  '/images/servicios/exp_5.avif',
  '/images/servicios/exp_6.avif',
  '/images/servicios/exp_7.avif',
  '/images/servicios/exp_8.avif',
  '/images/servicios/exp_9.avif',
];

const rutinasImages = [
  '/images/servicios/rut_1.avif',
  '/images/servicios/rut_2.avif',
  '/images/servicios/rut_3.avif',
  '/images/servicios/rut_4.avif',
  '/images/servicios/rut_5.avif',
  '/images/servicios/rut_6.avif',
  '/images/servicios/rut_7.avif',
  '/images/servicios/rut_8.avif',
  '/images/servicios/rut_9.avif',
];
---

<BaseLayout
  title="La Esmeralda Reserva Natural | Vivencias"
  description="Descubre las experiencias y vivencias que ofrecemos en nuestra reserva natural."
>
  <Header />

  <main>
    <!-- Hero Section -->
    <div class="bg-[url('/images/servicios/banner_3.avif')] bg-cover bg-center bg-no-repeat">
      <div class="container m-auto">
        <h1 class="px-4 font-bold text-4xl md:text-6xl leading-tight mb-3 pt-10 text-white drop-shadow-xl shadow-black text-shadow-custom">
          Un día<br />
          <span class="text-lime-500 text-5xl md:text-9xl">En la reserva</span>
        </h1>
      </div>
    </div>

    <div class="lg:mx-auto lg:max-w-5xl container m-auto space-y-10 mb-10 pt-5 md:pt-16">
      <!-- Quote -->
      <div class="container m-auto text-center">
        <p class="mb-8 px-6 text-lg font-normal text-gray-900 lg:text-xl sm:px-16 xl:px-48">
          "Hoy puede ser un gran día, plantéatelo así. Aprovecharlo o que pase
          de largo depende, en parte, de ti. Dale el día libre a la experiencia,
          para comenzar, y recíbelo como si fuera fiesta de guardar. No
          consientas que se esfume, asómate y consume la vida a granel. Hoy
          puede ser un gran día: duro con él" (Joan Manuel Serrat)
        </p>
      </div>

      <!-- Sección Inmersión -->
      <section class="bg-white">
        <div class="gap-8 items-center py-8 px-4 mx-auto max-w-screen-xl xl:gap-16 md:grid md:grid-cols-2 sm:py-16 lg:px-6">
          <Carousel images={experienciaImages} alt="Experiencia en la reserva" />

          <div class="mt-4 md:mt-0">
            <h2 class="text-center mb-4 text-4xl tracking-tight font-extrabold text-gray-900">
              Inmersión en nuestro ecosistema
            </h2>
            <section class="bg-white">
              <div class="max-w-screen-xl px-4 py-8 mx-auto text-center lg:py-16 lg:px-6">
                <figure class="max-w-screen-md mx-auto">
                  <svg
                    class="h-12 mx-auto mb-3 text-gray-400"
                    viewBox="0 0 24 27"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M14.017 18L14.017 10.609C14.017 4.905 17.748 1.039 23 0L23.995 2.151C21.563 3.068 20 5.789 20 8H24V18H14.017ZM0 18V10.609C0 4.905 3.748 1.038 9 0L9.996 2.151C7.563 3.068 6 5.789 6 8H9.983L9.983 18L0 18Z"
                      fill="currentColor"
                    ></path>
                  </svg>
                  <blockquote>
                    <p class="text-2xl font-medium text-gray-900">
                      El lente de tu corazón es más potente que el lente de tu
                      cámara, déjate sorprender.
                    </p>
                  </blockquote>
                  <figcaption class="flex items-center justify-center mt-6 space-x-3">
                    <div class="flex items-center divide-x-2 divide-gray-500">
                      <div class="pr-3 font-medium text-gray-900">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="16"
                          height="16"
                          fill="currentColor"
                          class="bi bi-camera"
                          viewBox="0 0 16 16"
                        >
                          <path
                            d="M15 12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h1.172a3 3 0 0 0 2.12-.879l.83-.828A1 1 0 0 1 6.827 3h2.344a1 1 0 0 1 .707.293l.828.828A3 3 0 0 0 12.828 5H14a1 1 0 0 1 1 1v6zM2 4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-1.172a2 2 0 0 1-1.414-.586l-.828-.828A2 2 0 0 0 9.172 2H6.828a2 2 0 0 0-1.414.586l-.828.828A2 2 0 0 1 3.172 4H2z"
                          ></path>
                          <path
                            d="M8 11a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5zm0 1a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM3 6.5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0z"
                          ></path>
                        </svg>
                      </div>
                      <div class="pl-3 text-base font-light text-gray-700">
                        Desde la foto de un celular hasta la cámara más costosa,
                        la naturaleza siempre muestra su mejor perfil.
                      </div>
                    </div>
                  </figcaption>
                </figure>
              </div>
            </section>
            <div class="text-center">
              <a
                href="/vinculate/"
                class="inline-flex items-center text-white bg-lime-500 hover:bg-lime-600 focus:ring-4 focus:ring-lime-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center"
              >
                Vincúlate aquí
                <svg
                  class="ml-2 -mr-1 w-5 h-5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                    clip-rule="evenodd"
                  ></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Sección Rutinas Ancestrales -->
      <section class="bg-white">
        <div class="gap-8 items-center py-8 px-4 mx-auto max-w-screen-xl xl:gap-16 md:grid md:grid-cols-2 sm:py-16 lg:px-6">
          <div class="mt-4 md:mt-0 md:order-1">
            <h2 class="text-center mb-4 text-4xl tracking-tight font-extrabold text-gray-900">
              Rutinas ancestrales
            </h2>
            <p class="mb-6 font-light text-gray-700 md:text-lg text-justify">
              Experimenta las tradiciones que han sostenido a las comunidades rurales
              durante generaciones. Participa en actividades auténticas como la ordeña
              de vacas, elaboración artesanal de queso y yogurt, y la producción de
              panela tradicional. Estas vivencias te conectan con la sabiduría ancestral
              y el valor del trabajo en armonía con la naturaleza.
            </p>
            <div class="text-center">
              <a
                href="/vinculate/"
                class="inline-flex items-center text-white bg-lime-500 hover:bg-lime-600 focus:ring-4 focus:ring-lime-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center"
              >
                Vive la experiencia
                <svg
                  class="ml-2 -mr-1 w-5 h-5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                    clip-rule="evenodd"
                  ></path>
                </svg>
              </a>
            </div>
          </div>
          <Carousel images={rutinasImages} alt="Rutinas ancestrales" />
        </div>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>
