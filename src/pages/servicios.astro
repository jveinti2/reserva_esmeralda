---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Carousel from '../components/ui/Carousel.astro';

const experienciaImages = [
  '/images/servicios/exp_1.avif',
  '/images/servicios/exp_2.avif',
  '/images/servicios/exp_3.avif',
  '/images/servicios/exp_4.avif',
  '/images/servicios/exp_5.avif',
  '/images/servicios/exp_6.avif',
  '/images/servicios/exp_7.avif',
  '/images/servicios/exp_8.avif',
  '/images/servicios/exp_9.avif',
];

const rutinasImages = [
  '/images/servicios/rut_1.avif',
  '/images/servicios/rut_2.avif',
  '/images/servicios/rut_3.avif',
  '/images/servicios/rut_4.avif',
  '/images/servicios/rut_5.avif',
  '/images/servicios/rut_6.avif',
  '/images/servicios/rut_7.avif',
  '/images/servicios/rut_8.avif',
  '/images/servicios/rut_9.avif',
];

const animalesImages = [
  '/images/servicios/an_1.avif',
  '/images/servicios/an_2.avif',
  '/images/servicios/an_3.avif',
  '/images/servicios/an_4.avif',
  '/images/servicios/an_5.avif',
  '/images/servicios/an_6.avif',
  '/images/servicios/an_7.avif',
  '/images/servicios/an_8.avif',
  '/images/servicios/an_9.avif',
];

const aprenderImages = [
  '/images/servicios/ap_1.avif',
  '/images/servicios/ap_2.avif',
  '/images/servicios/ap_3.avif',
  '/images/servicios/ap_4.avif',
  '/images/servicios/ap_5.avif',
  '/images/servicios/ap_6.avif',
  '/images/servicios/ap_7.avif',
  '/images/servicios/ap_8.avif',
  '/images/servicios/ap_9.avif',
];
---

<BaseLayout
  title="La Esmeralda Reserva Natural | Vivencias"
  description="Descubre las experiencias y vivencias que ofrecemos en nuestra reserva natural."
  preloadImage="/images/servicios/banner_3.avif"
>
  <Header />

  <main>
    <!-- Hero Section -->
    <div class="bg-[url('/images/servicios/banner_3.avif')] bg-cover bg-center bg-no-repeat">
      <div class="container m-auto">
        <h1 class="px-4 font-bold text-4xl md:text-6xl leading-tight mb-3 pt-24 lg:pt-32 text-white drop-shadow-xl shadow-black text-shadow-custom">
          Un día<br />
          <span class="text-lime-500 text-5xl md:text-9xl">En la reserva</span>
        </h1>
      </div>
    </div>

    <div class="lg:mx-auto lg:max-w-6xl container m-auto space-y-16 mb-16 pt-8 md:pt-16 px-4">
      <!-- Quote -->
      <div class="text-center max-w-4xl mx-auto">
        <p class="text-lg font-normal text-gray-700 lg:text-xl italic">
          "Hoy puede ser un gran día, planteátelo así. Aprovecharlo o que pase
          de largo depende, en parte, de ti. Dale el día libre a la experiencia,
          para comenzar, y recíbelo como si fuera fiesta de guardar. No
          consientas que se esfume, asómate y consume la vida a granel. Hoy
          puede ser un gran día: duro con él"
          <span class="block mt-2 text-gray-500 not-italic">- Joan Manuel Serrat</span>
        </p>
      </div>

      <!-- Seccion 1: Inmersion en nuestro ecosistema (Carrusel IZQUIERDA) -->
      <section class="bg-white">
        <div class="gap-8 items-center py-8 mx-auto max-w-screen-xl xl:gap-16 md:grid md:grid-cols-2">
          <div class="mb-8 md:mb-0">
            <Carousel images={experienciaImages} alt="Experiencia en la reserva" />
          </div>

          <div class="text-center md:text-left">
            <h2 class="mb-6 text-3xl md:text-4xl tracking-tight font-extrabold text-gray-900">
              Inmersión en nuestro ecosistema
            </h2>
            <div class="bg-gray-50 rounded-xl p-6 mb-6">
              <svg
                class="h-10 mx-auto md:mx-0 mb-3 text-lime-500"
                viewBox="0 0 24 27"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M14.017 18L14.017 10.609C14.017 4.905 17.748 1.039 23 0L23.995 2.151C21.563 3.068 20 5.789 20 8H24V18H14.017ZM0 18V10.609C0 4.905 3.748 1.038 9 0L9.996 2.151C7.563 3.068 6 5.789 6 8H9.983L9.983 18L0 18Z"
                  fill="currentColor"
                ></path>
              </svg>
              <blockquote>
                <p class="text-xl font-medium text-gray-900 mb-4">
                  El lente de tu corazón es más potente que el lente de tu
                  cámara, déjate sorprender.
                </p>
              </blockquote>
              <p class="text-gray-600 text-sm">
                Desde la foto de un celular hasta la cámara más costosa,
                la naturaleza siempre muestra su mejor perfil.
              </p>
            </div>
            <a
              href="/vinculate/"
              class="inline-flex items-center text-white bg-lime-500 hover:bg-lime-600 focus:ring-4 focus:ring-lime-300 font-medium rounded-lg text-sm px-5 py-2.5"
            >
              Vincúlate aquí
              <svg class="ml-2 w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
              </svg>
            </a>
          </div>
        </div>
      </section>

      <!-- Seccion 2: Rutinas ancestrales (Carrusel DERECHA) -->
      <section class="bg-white">
        <div class="gap-8 items-center py-8 mx-auto max-w-screen-xl xl:gap-16 md:grid md:grid-cols-2">
          <div class="text-center md:text-left order-2 md:order-1">
            <h2 class="mb-6 text-3xl md:text-4xl tracking-tight font-extrabold text-gray-900">
              Rutinas ancestrales
            </h2>
            <div class="bg-gray-50 rounded-xl p-6 mb-6">
              <svg
                class="h-10 mx-auto md:mx-0 mb-3 text-lime-500"
                viewBox="0 0 24 27"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M14.017 18L14.017 10.609C14.017 4.905 17.748 1.039 23 0L23.995 2.151C21.563 3.068 20 5.789 20 8H24V18H14.017ZM0 18V10.609C0 4.905 3.748 1.038 9 0L9.996 2.151C7.563 3.068 6 5.789 6 8H9.983L9.983 18L0 18Z"
                  fill="currentColor"
                ></path>
              </svg>
              <p class="text-gray-700 md:text-lg text-justify mb-4">
                Experimenta las tradiciones que han sostenido a las comunidades rurales
                durante generaciones. Participa en actividades auténticas como la ordeña
                de vacas, elaboración artesanal de queso y yogurt, y la producción de
                panela tradicional.
              </p>
              <p class="text-gray-600 text-sm">
                Estas vivencias te conectan con la sabiduría ancestral
                y el valor del trabajo en armonía con la naturaleza.
              </p>
            </div>
            <a
              href="/vinculate/"
              class="inline-flex items-center text-white bg-lime-500 hover:bg-lime-600 focus:ring-4 focus:ring-lime-300 font-medium rounded-lg text-sm px-5 py-2.5"
            >
              Vive la experiencia
              <svg class="ml-2 w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
              </svg>
            </a>
          </div>
          <div class="mb-8 md:mb-0 order-1 md:order-2">
            <Carousel images={rutinasImages} alt="Rutinas ancestrales" />
          </div>
        </div>
      </section>

      <!-- Seccion 3: Conectando con la madre tierra (Carrusel IZQUIERDA) -->
      <section class="bg-white">
        <div class="gap-8 items-center py-8 mx-auto max-w-screen-xl xl:gap-16 md:grid md:grid-cols-2">
          <div class="mb-8 md:mb-0">
            <Carousel images={animalesImages} alt="Conectando con la madre tierra" />
          </div>

          <div class="text-center md:text-left">
            <h2 class="mb-6 text-3xl md:text-4xl tracking-tight font-extrabold text-gray-900">
              Conectando con la madre tierra
            </h2>
            <div class="bg-gray-50 rounded-xl p-6 mb-6">
              <svg
                class="h-10 mx-auto md:mx-0 mb-3 text-lime-500"
                viewBox="0 0 24 27"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M14.017 18L14.017 10.609C14.017 4.905 17.748 1.039 23 0L23.995 2.151C21.563 3.068 20 5.789 20 8H24V18H14.017ZM0 18V10.609C0 4.905 3.748 1.038 9 0L9.996 2.151C7.563 3.068 6 5.789 6 8H9.983L9.983 18L0 18Z"
                  fill="currentColor"
                ></path>
              </svg>
              <blockquote>
                <p class="text-xl font-medium text-gray-900 mb-4">
                  "Mira profundamente en la naturaleza y entonces
                  comprenderás todo mejor."
                </p>
                <p class="text-gray-500 text-sm">- Albert Einstein</p>
              </blockquote>
              <p class="text-gray-600 text-sm mt-4">
                Descubre la conexión profunda entre los seres vivos y su entorno.
                Observa de cerca la fauna silvestre en su hábitat natural.
              </p>
            </div>
            <a
              href="/vinculate/"
              class="inline-flex items-center text-white bg-lime-500 hover:bg-lime-600 focus:ring-4 focus:ring-lime-300 font-medium rounded-lg text-sm px-5 py-2.5"
            >
              Conecta con la naturaleza
              <svg class="ml-2 w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
              </svg>
            </a>
          </div>
        </div>
      </section>

      <!-- Seccion 4: Nunca dejamos de aprender (Carrusel DERECHA) -->
      <section class="bg-white">
        <div class="gap-8 items-center py-8 mx-auto max-w-screen-xl xl:gap-16 md:grid md:grid-cols-2">
          <div class="text-center md:text-left order-2 md:order-1">
            <h2 class="mb-6 text-3xl md:text-4xl tracking-tight font-extrabold text-gray-900">
              Nunca dejamos de aprender
            </h2>
            <div class="bg-gray-50 rounded-xl p-6 mb-6">
              <svg
                class="h-10 mx-auto md:mx-0 mb-3 text-lime-500"
                viewBox="0 0 24 27"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M14.017 18L14.017 10.609C14.017 4.905 17.748 1.039 23 0L23.995 2.151C21.563 3.068 20 5.789 20 8H24V18H14.017ZM0 18V10.609C0 4.905 3.748 1.038 9 0L9.996 2.151C7.563 3.068 6 5.789 6 8H9.983L9.983 18L0 18Z"
                  fill="currentColor"
                ></path>
              </svg>
              <blockquote>
                <p class="text-xl font-medium text-gray-900 mb-4">
                  "La educación es el arma más poderosa que puedes usar
                  para cambiar el mundo."
                </p>
                <p class="text-gray-500 text-sm">- Nelson Mandela</p>
              </blockquote>
              <p class="text-gray-600 text-sm mt-4">
                Participa en talleres de educación ambiental, aprende sobre
                biodiversidad y descubre cómo cada acción cuenta para
                la conservación de nuestro planeta.
              </p>
            </div>
            <a
              href="/vinculate/"
              class="inline-flex items-center text-white bg-lime-500 hover:bg-lime-600 focus:ring-4 focus:ring-lime-300 font-medium rounded-lg text-sm px-5 py-2.5"
            >
              Aprende con nosotros
              <svg class="ml-2 w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
              </svg>
            </a>
          </div>
          <div class="mb-8 md:mb-0 order-1 md:order-2">
            <Carousel images={aprenderImages} alt="Nunca dejamos de aprender" />
          </div>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>
