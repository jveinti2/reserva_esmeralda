---
// Marco superior: transparente sobre el hero, apenas tenido al hacer scroll.
// El estado lo pone JS (clase .is-scrolled) para que funcione igual en todos
// los navegadores, no solo en los que soportan scroll-driven animations.

interface Props {
  /** Ruta actual, para marcar el enlace activo. Por defecto la de la pagina. */
  actual?: string;
}

const { actual = Astro.url.pathname } = Astro.props;

const programas = [
  {
    titulo: "Conservación e investigación",
    href: "/conservacion_investigacion/",
    hijos: [
      { texto: "Herpetos", href: "/conservacion_investigacion/herpetos/" },
      { texto: "Arácnidos", href: "/conservacion_investigacion/aracnidos/" },
      { texto: "Nutria y ostras", href: "/conservacion_investigacion/nutria/" },
    ],
  },
  {
    titulo: "Educación ambiental",
    href: "/educacion_ambiental/",
    hijos: [
      { texto: "Semillero Bio Arte", href: "/educacion_ambiental/semillero_arte_ambiental/" },
      { texto: "Semillero Avistadores", href: "/educacion_ambiental/semillero_aves/" },
      { texto: "Semillero Sembradores", href: "/educacion_ambiental/semillero_sembradores/" },
    ],
  },
  {
    titulo: "Emprendimientos verdes",
    href: "/emprendimientos/",
    hijos: [
      { texto: "Cerveza", href: "/emprendimientos/cerveza/" },
      { texto: "Yogurt", href: "/emprendimientos/yogurt/" },
      { texto: "Mermelada", href: "/emprendimientos/mermelada/" },
    ],
  },
];

const enlaces = [
  { texto: "Inicio", href: "/" },
  { texto: "La reserva", href: "/reserva/" },
  { texto: "Vivencias", href: "/servicios/" },
  { texto: "Galería", href: "/galeria/" },
  { texto: "Contáctanos", href: "/contactanos/" },
];

const esActual = (href: string) => actual === href;
const enProgramas = programas.some(
  (p) => actual.startsWith(p.href) || p.hijos.some((h) => actual === h.href),
);
---

<header class="site-header" id="site-header">
  <div class="wrap header-barra">
    <a href="/" class="header-marca" aria-label="La Esmeralda Reserva Natural">
      <img
        class="header-logo header-logo-claro"
        src="/logo-sin-bg-blanco.avif"
        alt=""
        width="600"
        height="228"
        fetchpriority="high"
        decoding="async"
      />
      <img
        class="header-logo header-logo-oscuro"
        src="/logo-sin-bg.avif"
        alt="La Esmeralda Reserva Natural"
        width="600"
        height="228"
        fetchpriority="high"
        decoding="async"
      />
    </a>

    <nav class="nav-escritorio" aria-label="Principal">
      <a href="/" class:list={["navlink", { activo: esActual("/") }]}>Inicio</a>
      <a href="/reserva/" class:list={["navlink", { activo: esActual("/reserva/") }]}>La reserva</a>

      <div class="mega" id="mega">
        <button
          type="button"
          id="mega-btn"
          class:list={["navlink", { activo: enProgramas }]}
          aria-expanded="false"
          aria-controls="mega-panel"
        >
          Programas
          <svg
            id="mega-flecha"
            width="10"
            height="6"
            viewBox="0 0 10 6"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="m1 1 4 4 4-4"></path></svg
          >
        </button>

        <div class="mega-panel" id="mega-panel" hidden>
          <div class="mega-grid">
            {
              programas.map((p) => (
                <div class="mega-col">
                  <a href={p.href} class="mega-titulo">
                    {p.titulo}
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                  </a>
                  <ul>
                    {p.hijos.map((h) => (
                      <li>
                        <a href={h.href} class="mega-hijo">
                          {h.texto}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <a href="/servicios/" class:list={["navlink", { activo: esActual("/servicios/") }]}>Vivencias</a>
      <a href="/galeria/" class:list={["navlink", { activo: esActual("/galeria/") }]}>Galería</a>
      <a href="/contactanos/" class:list={["navlink", { activo: esActual("/contactanos/") }]}>Contáctanos</a>
    </nav>

    <a href="/vinculate/" class="btn btn-lima cta-vinculate">
      Vincúlate
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
      >
    </a>

    <button
      type="button"
      id="menu-btn"
      class="hamburguesa"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="menu-movil"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h10"></path></svg
      >
    </button>
  </div>
</header>

<!-- Panel movil a pantalla completa -->
<div class="menu-movil" id="menu-movil" hidden>
  <div class="menu-cabecera wrap">
    <a href="/" aria-label="La Esmeralda Reserva Natural">
      <img src="/logo-sin-bg-blanco.avif" alt="" width="600" height="228" loading="lazy" decoding="async" />
    </a>
    <button type="button" id="menu-cerrar" class="menu-cerrar-btn" aria-label="Cerrar menú">
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg
      >
    </button>
  </div>

  <nav class="menu-cuerpo wrap" aria-label="Menú móvil">
    {enlaces.map((e) => <a href={e.href} class="menu-enlace">{e.texto}</a>)}

    {
      programas.map((p) => (
        <div class="menu-grupo">
          <a href={p.href} class="menu-grupo-titulo">
            {p.titulo}
          </a>
          <div class="menu-grupo-hijos">
            {p.hijos.map((h) => (
              <a href={h.href} class="menu-hijo">
                {h.texto}
              </a>
            ))}
          </div>
        </div>
      ))
    }

    <a href="/vinculate/" class="btn btn-lima menu-cta">
      Vincúlate
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
      >
    </a>

    <div class="menu-pie">
      <a href="tel:+573208096472" class="menu-contacto">(+57) 320 809 6472</a>
      <a href="mailto:info@esmeraldareservanatural.com" class="menu-contacto"
        >info@esmeraldareservanatural.com</a
      >
      <div class="menu-redes">
        <a href="https://www.facebook.com/ReservalaesmeraldaenDoima" target="_blank" rel="noopener noreferrer" class="social" aria-label="Facebook">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.6 1.6-1.6h1.7V4.3c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.2v2.4H7.4V14h2.8v8h3.3z"></path></svg>
        </a>
        <a href="https://www.instagram.com/laesmeraldareservanatural/" target="_blank" rel="noopener noreferrer" class="social" aria-label="Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg>
        </a>
        <a href="https://www.youtube.com/@reservanaturallaesmeralda7224" target="_blank" rel="noopener noreferrer" class="social" aria-label="YouTube">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23 7.2a2.9 2.9 0 0 0-2-2C19.2 4.7 12 4.7 12 4.7s-7.2 0-9 .5a2.9 2.9 0 0 0-2 2C.5 9 .5 12 .5 12s0 3 .5 4.8a2.9 2.9 0 0 0 2 2c1.8.5 9 .5 9 .5s7.2 0 9-.5a2.9 2.9 0 0 0 2-2c.5-1.8.5-4.8.5-4.8s0-3-.5-4.8zM9.7 15.1V8.9l6 3.1-6 3.1z"></path></svg>
        </a>
      </div>
    </div>
  </nav>
</div>


<script>
  function initHeader() {
    const header = document.getElementById("site-header");
    const mega = document.getElementById("mega");
    const megaBtn = document.getElementById("mega-btn");
    const megaPanel = document.getElementById("mega-panel");
    const menuBtn = document.getElementById("menu-btn");
    const menuCerrar = document.getElementById("menu-cerrar");
    const menuMovil = document.getElementById("menu-movil");

    // --- Tenido y autoocultado al hacer scroll -----------------
    if (header) {
      let ticking = false;
      let ultimaY = window.scrollY;

      const pintar = () => {
        const y = window.scrollY;
        header.classList.toggle("is-scrolled", y > 40);

        // Con un menu abierto la barra se queda: esconderla dejaria
        // el panel colgando sin su boton de cierre.
        const menuAbierto =
          (menuMovil && !menuMovil.hasAttribute("hidden")) ||
          (mega && mega.classList.contains("abierto"));

        const delta = y - ultimaY;
        if (menuAbierto || y < 140) {
          header.classList.remove("is-oculto");
        } else if (delta > 4) {
          header.classList.add("is-oculto");
        } else if (delta < -4) {
          header.classList.remove("is-oculto");
        }
        ultimaY = y;
      };

      const alScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          pintar();
        });
      };
      window.addEventListener("scroll", alScroll, { passive: true });
      pintar();
    }

    // --- Megamenu de programas --------------------------------
    let cerrarLento: ReturnType<typeof setTimeout> | null = null;

    function abrirMega(abierto: boolean) {
      if (!mega || !megaBtn || !megaPanel) return;
      mega.classList.toggle("abierto", abierto);
      megaBtn.setAttribute("aria-expanded", String(abierto));
      if (abierto) megaPanel.removeAttribute("hidden");
      else megaPanel.setAttribute("hidden", "");
    }

    if (mega && megaBtn && megaPanel) {
      megaBtn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const abierto = megaBtn.getAttribute("aria-expanded") === "true";
        // Con raton el hover ya lo abrio: el click no debe cerrarlo de vuelta.
        if (abierto && mega.matches(":hover")) return;
        abrirMega(!abierto);
      });

      // Al salir del panel con el teclado, se cierra
      mega.addEventListener("focusout", () => {
        setTimeout(() => {
          if (!mega.contains(document.activeElement)) abrirMega(false);
        }, 0);
      });

      mega.addEventListener("mouseenter", () => {
        if (cerrarLento) clearTimeout(cerrarLento);
        if (window.matchMedia("(hover: hover)").matches) abrirMega(true);
      });

      mega.addEventListener("mouseleave", () => {
        if (cerrarLento) clearTimeout(cerrarLento);
        cerrarLento = setTimeout(() => abrirMega(false), 150);
      });

      document.addEventListener("click", (e) => {
        if (!mega.contains(e.target as Node)) abrirMega(false);
      });
    }

    // --- Panel movil ------------------------------------------
    function abrirMenu(abierto: boolean) {
      if (!menuMovil || !menuBtn) return;
      if (abierto) {
        menuMovil.removeAttribute("hidden");
        header?.classList.remove("is-oculto");
      } else menuMovil.setAttribute("hidden", "");
      menuBtn.setAttribute("aria-expanded", String(abierto));
      document.documentElement.style.overflow = abierto ? "hidden" : "";
      if (abierto) menuCerrar?.focus();
    }

    menuBtn?.addEventListener("click", () => abrirMenu(true));
    menuCerrar?.addEventListener("click", () => abrirMenu(false));

    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      abrirMega(false);
      if (menuMovil && !menuMovil.hasAttribute("hidden")) abrirMenu(false);
    });
  }

  initHeader();
  document.addEventListener("astro:page-load", initHeader);
</script>
