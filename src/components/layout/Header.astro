---
// Header component with navigation
---

<header>
  <nav class="bg-white border-b border-gray-200 px-4 lg:px-6 py-2">
    <div class="flex justify-between items-center mx-auto max-w-screen-xl">
      <!-- Logo a la izquierda -->
      <a href="/" class="flex items-center">
        <img
          loading="lazy"
          src="/logo-sin-bg.avif"
          class="h-10 sm:h-14"
          alt="La Esmeralda Reserva Natural Logo"
        />
      </a>

      <!-- Hamburger button para mobile -->
      <button
        id="mobile-menu-button"
        type="button"
        class="inline-flex items-center p-2 text-sm text-gray-500 rounded-lg lg:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200"
      >
        <span class="sr-only">Abrir menú</span>
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
          <path
            fill-rule="evenodd"
            d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"
            clip-rule="evenodd"></path>
        </svg>
      </button>

      <!-- Menu - alineado a la derecha -->
      <div class="hidden lg:flex lg:items-center lg:ml-auto" id="mobile-menu">
        <ul
          class="flex flex-col mt-4 font-medium lg:flex-row lg:gap-1 lg:mt-0 lg:items-center"
        >
          <!-- Inicio -->
          <li>
            <a href="/" class="nav-button"
              ><span class="nav-button-inner">Inicio</span></a
            >
          </li>

          <!-- La reserva -->
          <li>
            <a href="/reserva/" class="nav-button"
              ><span class="nav-button-inner">La reserva</span></a
            >
          </li>

          <!-- Vivencias -->
          <li>
            <a href="/servicios/" class="nav-button"
              ><span class="nav-button-inner">Vivencias</span></a
            >
          </li>

          <!-- Programas Dropdown -->
          <li class="relative" id="programas-dropdown">
            <button id="programas-btn" class="nav-button">
              <span class="nav-button-inner flex items-center gap-1">
                Programas
                <svg
                  class="w-2.5 h-2.5 transition-transform duration-200"
                  id="programas-arrow"
                  fill="none"
                  viewBox="0 0 10 6"
                >
                  <path
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="m1 1 4 4 4-4"></path>
                </svg>
              </span>
            </button>

            <!-- Dropdown menu principal -->
            <div
              id="programas-menu"
              class="hidden absolute left-0 top-full mt-1 z-50"
            >
              <div
                class="bg-white rounded-lg shadow-lg border border-gray-200 w-64 py-2"
              >
                <!-- Conservacion e Investigacion -->
                <div class="submenu-item relative">
                  <button
                    class="submenu-btn w-full flex items-center justify-between px-4 py-3 hover:bg-lime-50 text-gray-700 text-left"
                    data-submenu="sub-conservacion"
                  >
                    <span>Conservación e Investigación</span>
                    <svg
                      class="w-3 h-3 text-gray-400 transition-transform duration-200"
                      fill="none"
                      viewBox="0 0 6 10"
                    >
                      <path
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="m1 9 4-4-4-4"></path>
                    </svg>
                  </button>
                  <div
                    id="sub-conservacion"
                    class="submenu hidden absolute left-full top-0 ml-1"
                  >
                    <div
                      class="bg-white rounded-lg shadow-lg border border-gray-200 w-48 py-2"
                    >
                      <a
                        href="/conservacion_investigacion/herpetos/"
                        class="block px-4 py-2 hover:bg-lime-50 text-gray-700"
                        >Herpetos</a
                      >
                      <a
                        href="/conservacion_investigacion/aracnidos/"
                        class="block px-4 py-2 hover:bg-lime-50 text-gray-700"
                        >Arácnidos</a
                      >
                      <a
                        href="/conservacion_investigacion/nutria/"
                        class="block px-4 py-2 hover:bg-lime-50 text-gray-700"
                        >Nutria y ostras</a
                      >
                    </div>
                  </div>
                </div>

                <!-- Educacion Ambiental -->
                <div class="submenu-item relative">
                  <button
                    class="submenu-btn w-full flex items-center justify-between px-4 py-3 hover:bg-lime-50 text-gray-700 text-left"
                    data-submenu="sub-educacion"
                  >
                    <span>Educación Ambiental</span>
                    <svg
                      class="w-3 h-3 text-gray-400 transition-transform duration-200"
                      fill="none"
                      viewBox="0 0 6 10"
                    >
                      <path
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="m1 9 4-4-4-4"></path>
                    </svg>
                  </button>
                  <div
                    id="sub-educacion"
                    class="submenu hidden absolute left-full top-0 ml-1"
                  >
                    <div
                      class="bg-white rounded-lg shadow-lg border border-gray-200 w-52 py-2"
                    >
                      <a
                        href="/educacion_ambiental/semillero_arte_ambiental/"
                        class="block px-4 py-2 hover:bg-lime-50 text-gray-700"
                        >Semillero Bio Arte</a
                      >
                      <a
                        href="/educacion_ambiental/semillero_aves/"
                        class="block px-4 py-2 hover:bg-lime-50 text-gray-700"
                        >Semillero Avistadores</a
                      >
                      <a
                        href="/educacion_ambiental/semillero_sembradores/"
                        class="block px-4 py-2 hover:bg-lime-50 text-gray-700"
                        >Semillero Sembradores</a
                      >
                    </div>
                  </div>
                </div>

                <!-- Emprendimientos Verdes -->
                <div class="submenu-item relative">
                  <button
                    class="submenu-btn w-full flex items-center justify-between px-4 py-3 hover:bg-lime-50 text-gray-700 text-left"
                    data-submenu="sub-emprendimientos"
                  >
                    <span>Emprendimientos verdes</span>
                    <svg
                      class="w-3 h-3 text-gray-400 transition-transform duration-200"
                      fill="none"
                      viewBox="0 0 6 10"
                    >
                      <path
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="m1 9 4-4-4-4"></path>
                    </svg>
                  </button>
                  <div
                    id="sub-emprendimientos"
                    class="submenu hidden absolute left-full top-0 ml-1"
                  >
                    <div
                      class="bg-white rounded-lg shadow-lg border border-gray-200 w-40 py-2"
                    >
                      <a
                        href="/emprendimientos/cerveza/"
                        class="block px-4 py-2 hover:bg-lime-50 text-gray-700"
                        >Cerveza</a
                      >
                      <a
                        href="/emprendimientos/yogurt/"
                        class="block px-4 py-2 hover:bg-lime-50 text-gray-700"
                        >Yogurt</a
                      >
                      <a
                        href="/emprendimientos/mermelada/"
                        class="block px-4 py-2 hover:bg-lime-50 text-gray-700"
                        >Mermelada</a
                      >
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </li>

          <!-- Galeria -->
          <li>
            <a href="/galeria/" class="nav-button"
              ><span class="nav-button-inner">Galería</span></a
            >
          </li>

          <!-- Vinculate -->
          <li>
            <a href="/vinculate/" class="nav-button"
              ><span class="nav-button-inner">Vincúlate</span></a
            >
          </li>

          <!-- Contactanos -->
          <li>
            <a href="/contactanos/" class="nav-button"
              ><span class="nav-button-inner">Contáctanos</span></a
            >
          </li>
        </ul>
      </div>
    </div>
  </nav>
</header>

<style>
  .nav-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 2px;
    margin-bottom: 0.5rem;
    overflow: hidden;
    font-size: 0.875rem;
    font-weight: 500;
    color: #111827;
    border-radius: 9999px;
    background: linear-gradient(to bottom right, white, #bef264);
    cursor: pointer;
    border: none;
  }

  .nav-button:hover {
    background: linear-gradient(to bottom right, #f8fafc, #bef264);
  }

  .nav-button-inner {
    position: relative;
    padding: 0.375rem 1.25rem;
    transition: all 75ms ease-in;
    background-color: white;
    color: #111827;
    border-radius: 9999px;
  }

  .nav-button:hover .nav-button-inner {
    background-color: transparent;
  }

  .submenu-btn {
    border: none;
    background: none;
    cursor: pointer;
    font-size: 0.875rem;
  }
</style>

<script>
  function initHeader() {
    // Mobile menu toggle
    const mobileMenuButton = document.getElementById("mobile-menu-button");
    const mobileMenu = document.getElementById("mobile-menu");

    if (mobileMenuButton && mobileMenu) {
      mobileMenuButton.addEventListener("click", () => {
        mobileMenu.classList.toggle("hidden");
      });
    }

    // Programas dropdown
    const programasBtn = document.getElementById("programas-btn");
    const programasMenu = document.getElementById("programas-menu");
    const programasDropdown = document.getElementById("programas-dropdown");
    const programasArrow = document.getElementById("programas-arrow");

    let closeTimeout: ReturnType<typeof setTimeout> | null = null;

    function clearCloseTimeout() {
      if (closeTimeout) {
        clearTimeout(closeTimeout);
        closeTimeout = null;
      }
    }

    function closeAllMenus() {
      programasMenu?.classList.add("hidden");
      programasArrow?.style.setProperty("transform", "rotate(0deg)");
      document.querySelectorAll(".submenu").forEach((sub) => {
        sub.classList.add("hidden");
      });
    }

    function scheduleClose() {
      clearCloseTimeout();
      closeTimeout = setTimeout(() => {
        closeAllMenus();
      }, 150);
    }

    if (programasBtn && programasMenu && programasDropdown) {
      // Click en boton Programas
      programasBtn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        clearCloseTimeout();
        const isHidden = programasMenu.classList.contains("hidden");
        if (isHidden) {
          programasMenu.classList.remove("hidden");
          programasArrow?.style.setProperty("transform", "rotate(180deg)");
        } else {
          closeAllMenus();
        }
      });

      // Mantener abierto mientras el mouse este en el dropdown
      programasDropdown.addEventListener("mouseenter", clearCloseTimeout);
      programasDropdown.addEventListener("mouseleave", scheduleClose);
    }

    // Submenus - click para abrir
    const submenuBtns = document.querySelectorAll(".submenu-btn");

    submenuBtns.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        clearCloseTimeout();

        const submenuId = btn.getAttribute("data-submenu");
        const submenu = document.getElementById(submenuId || "");

        if (submenu) {
          const isHidden = submenu.classList.contains("hidden");

          // Cerrar otros submenus
          document.querySelectorAll(".submenu").forEach((sub) => {
            sub.classList.add("hidden");
          });

          // Toggle el submenu actual
          if (isHidden) {
            submenu.classList.remove("hidden");
          }
        }
      });
    });

    // Los submenus tambien cancelan el cierre
    document.querySelectorAll(".submenu").forEach((submenu) => {
      submenu.addEventListener("mouseenter", clearCloseTimeout);
      submenu.addEventListener("mouseleave", scheduleClose);
    });

    // Cerrar al hacer click fuera
    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (programasDropdown && !programasDropdown.contains(target)) {
        closeAllMenus();
      }
    });
  }

  // Inicializar
  initHeader();

  // Re-inicializar despues de navegacion
  document.addEventListener("astro:page-load", initHeader);
</script>
