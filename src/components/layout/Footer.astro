        <p class="text-lime-300 text-lg font-bold mb-2">🌿 UNA JOYA VERDE</p>
        <p class="text-white text-sm leading-relaxed">
          Conservando el bosque seco tropical del Tolima para las futuras generaciones
        </p>
      </div>

      <!-- Columna 2: Enlaces rapidos -->
      <div class="text-center md:text-left">
        <h3 class="text-white text-xl font-bold mb-6">📌 Enlaces Rápidos</h3>
        <ul class="space-y-3">
          <li>
            <a href="/reserva/" class="text-gray-300 hover:text-lime-300 transition-colors">
              La Reserva
            </a>
          </li>
          <li>
            <a href="/servicios/" class="text-gray-300 hover:text-lime-300 transition-colors">
              Vivencias
            </a>
          </li>
          <li>
            <a href="/emprendimientos/" class="text-gray-300 hover:text-lime-300 transition-colors">
