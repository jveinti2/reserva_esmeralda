---
// Pie oscuro: ubicacion, enlaces y wordmark.
// Con mapa={true} muestra el mapa interactivo de Google Maps (solo en las
// paginas donde tiene sentido: inicio y contacto). En el resto, tarjeta
// estatica con enlace a "Cómo llegar" — cero peticiones a terceros.

interface Props {
  mapa?: boolean;
}

const { mapa = false } = Astro.props;

const MAPA_EMBED =
  "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3977.919315965023!2d-74.98013618552636!3d4.4261321452102464!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e38cdb01f199d5b%3A0x9a7b95a195fa8778!2sReserva%20Natural%20La%20Esmeralda%20Doima!5e0!3m2!1ses-419!2sco!4v1675908202324!5m2!1ses-419!2sco";
const MAPA_LINK = "https://maps.app.goo.gl/qkkmUgqfMuTNUjYd8";

const anio = new Date().getFullYear();
---

<footer class="pie">
  <div class="wrap grid12 bloque-visita">
    <div class="reveal visita">
      <span class="eyebrow eyebrow-lima">Visítanos</span>
      <h3 class="visita-titulo">Corregimiento de Doima, Piedras, Tolima</h3>
      <span class="chip chip-lima autoalinear">A 20 minutos de Ibagué</span>

      <div class="contactos">
        <a href="tel:+573208096472" class="contacto">
          <span class="contacto-ico">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.9 2z"></path></svg>
          </span>
          <span class="contacto-texto">
            <span class="contacto-etiqueta">Teléfono</span>
            <span class="contacto-valor">(+57) 320 809 6472</span>
          </span>
        </a>

        <a href="mailto:info@esmeraldareservanatural.com" class="contacto">
          <span class="contacto-ico">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
          </span>
          <span class="contacto-texto">
            <span class="contacto-etiqueta">Email</span>
            <span class="contacto-valor">info@esmeraldareservanatural.com</span>
          </span>
        </a>
      </div>
    </div>

    <div class="reveal tarjeta-mapa">
      {
        mapa ? (
          <iframe
            src={MAPA_EMBED}
            title="Mapa de la Reserva Natural La Esmeralda en Doima, Piedras"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          />
        ) : (
          <>
            <div class="mapa-rejilla" />
            <div class="mapa-centro">
              <span class="mapa-pin">
                <span class="mapa-punto" />
              </span>
              <span class="mapa-nombre">Reserva Natural La Esmeralda</span>
              <span class="mapa-nota">Doima, Piedras, Tolima</span>
            </div>
          </>
        )
      }
      <a
        href={MAPA_LINK}
        target="_blank"
        rel="noopener noreferrer"
        class="chip chip-glass mapa-cta">Cómo llegar</a
      >
    </div>
  </div>

  <div class="bloque-enlaces">
    <div class="wrap grid12">
      <div class="col-marca">
        <img
          src="/logo-sin-bg-blanco.avif"
          alt="La Esmeralda Reserva Natural"
          width="600"
          height="228"
          loading="lazy"
          decoding="async"
        />
        <span class="joya">Una joya verde</span>
        <p class="col-texto">
          Conservando el bosque seco tropical del Tolima para las futuras
          generaciones.
        </p>
      </div>

      <div class="col-enlaces">
        <span class="col-titulo">Enlaces</span>
        <a href="/reserva/" class="foot-link">La reserva</a>
        <a href="/servicios/" class="foot-link">Vivencias</a>
        <a href="/galeria/" class="foot-link">Galería</a>
        <a href="/aves/" class="foot-link">Aves</a>
        <a href="/vinculate/" class="foot-link">Vincúlate</a>
        <a href="/contactanos/" class="foot-link">Contáctanos</a>
      </div>

      <div class="col-enlaces">
        <span class="col-titulo">Programas</span>
        <a href="/conservacion_investigacion/" class="foot-link">Conservación</a>
        <a href="/educacion_ambiental/" class="foot-link">Educación ambiental</a>
        <a href="/emprendimientos/" class="foot-link">Emprendimientos</a>
        <a href="/sendero/" class="foot-link">Sendero</a>
      </div>

      <div class="col-redes">
        <span class="col-titulo">Síguenos</span>
        <div class="redes">
          <a href="https://www.facebook.com/ReservalaesmeraldaenDoima" target="_blank" rel="noopener noreferrer" class="social" aria-label="Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.6 1.6-1.6h1.7V4.3c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.2v2.4H7.4V14h2.8v8h3.3z"></path></svg>
          </a>
          <a href="https://www.instagram.com/laesmeraldareservanatural/" target="_blank" rel="noopener noreferrer" class="social" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg>
          </a>
          <a href="https://www.youtube.com/@reservanaturallaesmeralda7224" target="_blank" rel="noopener noreferrer" class="social" aria-label="YouTube">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23 7.2a2.9 2.9 0 0 0-2-2C19.2 4.7 12 4.7 12 4.7s-7.2 0-9 .5a2.9 2.9 0 0 0-2 2C.5 9 .5 12 .5 12s0 3 .5 4.8a2.9 2.9 0 0 0 2 2c1.8.5 9 .5 9 .5s7.2 0 9-.5a2.9 2.9 0 0 0 2-2c.5-1.8.5-4.8.5-4.8s0-3-.5-4.8zM9.7 15.1V8.9l6 3.1-6 3.1z"></path></svg>
          </a>
          <a href="https://wa.me/573208096472" target="_blank" rel="noopener noreferrer" class="social" aria-label="WhatsApp">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.6-4.6A8.5 8.5 0 1 1 8 19.6L3 21z"></path><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-1.8-.9-.8.8a4 4 0 0 1-2.3-2.3l.8-.8L10.5 8.5 9 9.5z"></path></svg>
          </a>
        </div>
        <p class="col-texto">Doima, Piedras, Tolima, Colombia</p>
      </div>
    </div>
  </div>

  <div class="wrap">
    <div aria-hidden="true" class="wordmark">
      <span>La Esmeralda</span>
    </div>
    <div class="legal">
      <span>© {anio} La Esmeralda Reserva Natural. Todos los derechos reservados.</span>
      <span>RNSC 151-20 La Esmeralda · Resolución No. 227 de 2022</span>
    </div>
  </div>
</footer>

