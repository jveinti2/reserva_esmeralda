            </a>
          </li>
          <li>
            <a href="/contactanos/" class="text-gray-300 hover:text-lime-300 transition-colors">
              Contáctanos
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 3: Contacto y redes -->
      <div class="text-center md:text-left">
        <h3 class="text-white text-xl font-bold mb-6">📞 Contacto</h3>
        <div class="space-y-4 mb-8">
