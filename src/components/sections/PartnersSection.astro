---
const partners = [
  { name: 'Amina Melandro', logo: '/logos/logo_amina_melandro.avif', url: '#' },
  { name: 'Universidad de Ibagué', logo: '/logos/unibague.avif', url: '#' },
  { name: 'Aprocade', logo: '/logos/aprocade.avif', url: '#' },
  { name: 'IED Doima', logo: '/logos/iedudoima.avif', url: '#' },
  { name: 'Parques Nacionales', logo: '/logos/parques-naturales.avif', url: '#' },
  { name: 'Cortolima', logo: '/logos/cortolima.avif', url: '#' },
  { name: 'GAP', logo: '/logos/gap.avif', url: '#' },
  { name: 'Policía Nacional', logo: '/logos/policia.avif', url: '#' },
  { name: 'FAOV', logo: '/logos/faov.avif', url: '#' },
  { name: 'OFP', logo: '/logos/ofp.avif', url: '#' },
  { name: 'Comunera', logo: '/logos/comunera.avif', url: '#' },
  { name: 'Colombo', logo: '/logos/colombo.jpg', url: '#' },
  { name: 'SENA', logo: '/logos/sena.png', url: '#' },
  { name: 'Universidad del Tolima', logo: '/logos/utolima.png', url: '#' },
  { name: 'Alcaldía de Piedras', logo: '/logos/logo_alcaldia_piedras.avif', url: '#' },
  { name: 'Avícola Triple A', logo: '/logos/avicola_triple_A.avif', url: '#' },
];
---

<section class="py-20 bg-gray-50">
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-esmeralda mb-4">
        🤝 Nuestros aliados
      </h2>
      <p class="text-xl text-gray-600">
        Gracias por estar vinculados a esta aventura
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8 max-w-7xl mx-auto items-center">
      {partners.map((partner) => (
        <a
          href={partner.url}
          class="flex items-center justify-center p-4 bg-white rounded-lg shadow-md hover:shadow-xl transition-all duration-300 hover:scale-110"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img
            src={partner.logo}
            alt={partner.name}
            loading="lazy"
            class="w-full h-auto max-h-20 object-contain"
          />
        </a>
      ))}
    </div>
  </div>
</section>
