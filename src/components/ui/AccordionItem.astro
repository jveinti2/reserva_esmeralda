---
interface Props {
  id: string;
  question: string;
  answer: string;
  /** Se conservan por compatibilidad: el borde ahora sale de :last-child. */
  isFirst?: boolean;
  isLast?: boolean;
}

const { id, question, answer } = Astro.props;
---

<details class="faq-item" name="faq" id={`accordion-${id}`}>
  <summary>
    <span>{question}</span>
    <span class="faq-icono" aria-hidden="true">
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg
      >
    </span>
  </summary>
  <div class="faq-respuesta" set:html={answer} />
</details>
