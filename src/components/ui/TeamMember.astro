---
interface Props {
  name: string;
  role: string;
  quote: string;
  image: string;
}

const { name, role, quote, image } = Astro.props;
---

<figure class="equipo-tarjeta">
  <div class="tile equipo-foto">
    <img src={image} alt={name} loading="lazy" decoding="async" />
  </div>
  <figcaption class="equipo-texto">
    <h3>{name}</h3>
    <span class="equipo-rol">{role}</span>
    <p class="equipo-cita">{quote}</p>
  </figcaption>
</figure>
