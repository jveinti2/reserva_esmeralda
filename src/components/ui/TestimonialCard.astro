---
interface Props {
  name: string;
  title: string;
  image: string;
  quote: string;
  extraQuote?: string;
}

const { name, title, image, quote, extraQuote } = Astro.props;
---

<div class="bg-white rounded-lg shadow-lg p-6 flex flex-col">
  <div class="flex items-center mb-4">
    <img
      src={image}
      alt={name}
      loading="lazy"
      class="w-16 h-16 rounded-full object-cover mr-4"
    />
    <div>
      <h4 class="text-lg font-bold text-gray-800">{name}</h4>
      <p class="text-sm text-gray-500">{title}</p>
    </div>
  </div>
  <blockquote class="text-gray-600 italic flex-grow">
    "{quote}"
  </blockquote>
  {extraQuote && (
    <p class="text-gray-600 italic mt-4 border-t border-gray-200 pt-4">
      {extraQuote}
    </p>
  )}
</div>
