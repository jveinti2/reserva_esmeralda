---
interface Props {
  emoji: string;
  title: string;
  description: string;
}

const { emoji, title, description } = Astro.props;
---

<div class="mx-auto max-w-sm p-6 bg-white border border-gray-200 rounded-lg shadow-md hover:shadow-xl transition-shadow">
  <div class="text-center mb-4">
    <div class="text-6xl mb-4">
      {emoji}
    </div>
    <h5 class="text-2xl font-semibold tracking-tight text-gray-900">
      {title}
    </h5>
  </div>
  <div>
    <p class="font-normal text-gray-700 leading-relaxed" set:html={description} />
  </div>
</div>
