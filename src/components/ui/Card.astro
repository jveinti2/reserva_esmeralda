---
interface Props {
  icon?: string;
  title: string;
  centered?: boolean;
  dark?: boolean;
}

const { icon, title, centered = false, dark = false } = Astro.props;
---

<div
  class:list={[
    "mx-auto max-w-sm p-4 border rounded-lg shadow-md",
    dark ? "bg-gray-800 border-gray-700" : "bg-white border-gray-200"
  ]}
>
  {icon && (
    <div class:list={["mb-3", centered && "text-center"]}>
      <img src={icon} class="w-28 m-auto" alt={`${title} icon`} loading="lazy" />
    </div>
  )}
  <h5
    class:list={[
      "mb-2 text-2xl font-semibold tracking-tight",
      centered && "text-center",
      dark ? "text-white" : "text-gray-900"
    ]}
  >
    {title}
  </h5>
  <div class:list={[dark ? "text-gray-400" : "text-gray-700"]}>
    <slot />
  </div>
</div>
