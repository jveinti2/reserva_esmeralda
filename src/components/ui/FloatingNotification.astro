---
interface Props {
  text: string;
  href: string;
  show?: boolean;
}

const { text, href, show = true } = Astro.props;
---

{
  show && (
    <div id="floating-notification" class="aviso">
      <a href={href} class="aviso-enlace">
        <span class="aviso-punto" />
        <span class="aviso-texto">{text}</span>
      </a>
      <button type="button" id="aviso-cerrar" class="aviso-cerrar" aria-label="Cerrar aviso">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>
  )
}

<style>
  .aviso {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 55;
    display: flex;
    align-items: center;
    gap: 4px;
    max-width: min(360px, calc(100vw - 32px));
    padding: 6px 6px 6px 4px;
    border-radius: 999px;
    background: rgba(8, 26, 13, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 20px 40px -20px rgba(8, 26, 13, 0.7);
    animation: aviso-entra 0.6s var(--ease-esm) 1.2s both;
  }

  .aviso.oculto {
    display: none;
  }

  @keyframes aviso-entra {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .aviso-enlace {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 36px;
    padding: 0 8px 0 12px;
    border-radius: 999px;
    color: #ffffff;
    min-width: 0;
  }

  .aviso-enlace:hover {
    color: var(--color-lima);
  }

  .aviso-punto {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-lima);
    flex-shrink: 0;
  }

  .aviso-texto {
    font-size: 13px;
    font-weight: 600;
    line-height: 18px;
  }

  .aviso-cerrar {
    width: 30px;
    height: 30px;
    border-radius: 999px;
    border: 0;
    background: transparent;
    color: rgba(255, 255, 255, 0.6);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
  }

  .aviso-cerrar:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
  }

  @media (prefers-reduced-motion: reduce) {
    .aviso {
      animation: none;
    }
  }
</style>

<script>
  function initAviso() {
    const aviso = document.getElementById("floating-notification");
    if (!aviso) return;

    let cerrado = false;
    try {
      cerrado = localStorage.getItem("emprendimientos-notification-dismissed") === "true";
    } catch (e) {}

    if (cerrado) {
      aviso.classList.add("oculto");
      return;
    }

    document.getElementById("aviso-cerrar")?.addEventListener("click", () => {
      try {
        localStorage.setItem("emprendimientos-notification-dismissed", "true");
      } catch (e) {}
      aviso.classList.add("oculto");
    });
  }

  initAviso();
  document.addEventListener("astro:page-load", initAviso);
</script>
